---
/**
 * Overlays for the mask themes (see MaskTray.astro + styles/masks.css).
 * Both shells are display:none until html[data-mask] matches, and the
 * script only wakes up when a mask is actually worn.
 */
import { useTranslations } from "../i18n/utils";
import { defaultLang, type Lang } from "../i18n/ui";

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);

const popups = [1, 2, 3, 4, 5, 6, 7, 8].map((n) => t(`slop.pop.${n}` as Parameters<typeof t>[0]));
const ticker = t("slop.ticker").trim().split(/\s+(?=[\p{Extended_Pictographic}])/u);

// A fixed, deterministic shower of emoji (keeps SSR output stable; capped at 18 nodes)
const RAIN = ["✨", "🚀", "💡", "🔥", "📈", "🎯", "🧠", "🤖", "💎", "🙏", "✨", "🚀", "💡", "✨", "🎉", "📊", "✨", "🚀"];
const rain = RAIN.map((e, i) => ({
    e,
    x: `${(i * 37 + 11) % 100}%`,
    s: `${18 + ((i * 7) % 16)}px`,
    d: `${7 + ((i * 5) % 7)}s`,
    delay: `${-((i * 1.7) % 9)}s`,
    r: `${((i % 2 ? 1 : -1) * (120 + ((i * 53) % 300)))}deg`,
}));
---

<style is:inline set:html={`:root{--slop-badge:"${t("slop.badge").replace(/"/g, "")}"}`}></style>

<!-- PAST: a VCR's on-screen display -->
<div class="vhs" data-vhs aria-hidden="true">
    <div class="vhs-scan"></div>
    <div class="vhs-chroma"></div>
    <div class="vhs-noise"></div>
    <div class="vhs-tint"></div>
    <div class="vhs-edge"></div>
    <div class="vhs-band"></div>
    <div class="vhs-osd vhs-play">▶ {t("vhs.play")}</div>
    <div class="vhs-osd vhs-rec"><b>●</b> {t("vhs.rec")} <span data-vhs-counter>SP 0:00:00</span></div>
    <div class="vhs-osd vhs-stamp">{t("vhs.date")}<small>PM 4:32</small></div>
</div>

<!-- PRESENT: content pouring out everywhere -->
<div class="slop" data-slop>
    <div class="slop-ticker" aria-hidden="true">
        <div class="slop-ticker-track">
            {[0, 1].map(() => ticker.map((w) => <span>{w}</span>))}
        </div>
    </div>
    <div class="slop-rain" aria-hidden="true">
        {rain.map((r) => <span style={`--x:${r.x};--s:${r.s};--d:${r.d};--delay:${r.delay};--r:${r.r}`}>{r.e}</span>)}
    </div>
    <div class="slop-pops" data-slop-pops></div>
    <!-- Glass cracks: every "Reject" adds a new set, cleared when the mask comes off -->
    <svg class="slop-cracks" data-slop-cracks aria-hidden="true" preserveAspectRatio="none"></svg>
    <div class="slop-cookie" data-slop-cookie hidden>
        <span data-slop-cookie-text data-default={t("slop.cookie")}>{t("slop.cookie")}</span>
        <span class="slop-cookie-actions">
            <button type="button" class="slop-cookie-reject" data-slop-cookie-reject>{t("slop.cookie.reject")}</button>
            <button type="button" data-slop-cookie-accept>{t("slop.cookie.accept")}</button>
        </span>
    </div>
</div>

<script
    type="application/json"
    id="slop-i18n"
    set:html={JSON.stringify({
        popups,
        close: t("slop.close"),
        again: [t("slop.cookie.again.1"), t("slop.cookie.again.2"), t("slop.cookie.again.3")],
    })}
/>

<script>
    function initMaskThemes() {
        const html = document.documentElement;
        const vhs = document.querySelector<HTMLElement>("[data-vhs]");
        const slop = document.querySelector<HTMLElement>("[data-slop]");
        if (!vhs || !slop) return;
        const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
        const i18n = JSON.parse(document.getElementById("slop-i18n")?.textContent ?? "{}") as { popups: string[]; close: string; again: string[] };

        // ---------- PAST: tape counter ----------
        const counter = vhs.querySelector<HTMLElement>("[data-vhs-counter]");
        let vhsTimer: ReturnType<typeof setInterval> | null = null;
        let tapeSeconds = 0;
        function tickTape() {
            tapeSeconds++;
            const h = Math.floor(tapeSeconds / 3600);
            const m = Math.floor((tapeSeconds % 3600) / 60);
            const s = tapeSeconds % 60;
            if (counter) counter.textContent = `SP ${h}:${String(m).padStart(2, "0")}:${String(s).padStart(2, "0")}`;
        }
        function startVhs() {
            if (vhsTimer || reduceMotion) return;
            vhsTimer = setInterval(tickTape, 1000);
        }
        function stopVhs() {
            if (vhsTimer) clearInterval(vhsTimer);
            vhsTimer = null;
        }

        // ---------- PRESENT: pop-ups and a cookie banner ----------
        const pops = slop.querySelector<HTMLElement>("[data-slop-pops]")!;
        const cookie = slop.querySelector<HTMLElement>("[data-slop-cookie]")!;
        const MAX_POPS = matchMedia("(max-width: 600px)").matches ? 2 : 3;
        const POP_EVERY_MS = 6000;
        const POP_LIFE_MS = 7000;
        let popTimer: ReturnType<typeof setInterval> | null = null;
        let popIndex = Math.floor(Math.random() * i18n.popups.length);

        function spawnPop() {
            if (pops.childElementCount >= MAX_POPS) return;
            const el = document.createElement("div");
            el.className = "slop-pop";
            el.setAttribute("role", "status");
            // keep pop-ups off the very edges, the slide dots and the ticker
            el.style.setProperty("--x", `${8 + Math.random() * 58}%`);
            el.style.setProperty("--y", `${10 + Math.random() * 62}%`);
            const text = document.createElement("span");
            text.textContent = i18n.popups[popIndex++ % i18n.popups.length];
            const close = document.createElement("button");
            close.type = "button";
            close.setAttribute("aria-label", i18n.close);
            close.textContent = "✕";
            close.addEventListener("click", () => dismissPop(el));
            // The card itself swallows a click wherever it lands (it loves to park
            // over the fruit bowl's drop column), so clicking anywhere on it dismisses it.
            el.addEventListener("click", () => dismissPop(el));
            el.append(text, close);
            pops.appendChild(el);
            const life = setTimeout(() => dismissPop(el), POP_LIFE_MS);
            (el as any)._life = life;
        }
        function dismissPop(el: HTMLElement) {
            clearTimeout((el as any)._life);
            if (reduceMotion) { el.remove(); return; }
            el.classList.add("is-leaving");
            setTimeout(() => el.remove(), 320);
        }
        function startSlop() {
            let dismissed = false;
            try { dismissed = sessionStorage.getItem("wb-slop-cookie") === "1"; } catch {}
            cookie.hidden = dismissed;
            if (reduceMotion || popTimer) return;
            setTimeout(spawnPop, 900);
            popTimer = setInterval(spawnPop, POP_EVERY_MS);
        }
        function stopSlop() {
            if (popTimer) clearInterval(popTimer);
            popTimer = null;
            pops.replaceChildren();
            if (againTimer) clearTimeout(againTimer);
            againTimer = null;
            rejects = 0;
            cookieText.textContent = cookieText.dataset.default ?? "";
            cracks.replaceChildren();
        }
        cookie.querySelector("[data-slop-cookie-accept]")?.addEventListener("click", () => {
            cookie.hidden = true;
            try { sessionStorage.setItem("wb-slop-cookie", "1"); } catch {}
        });

        // ---------- PRESENT: "Reject" cracks the glass ----------
        const cracks = slop.querySelector<SVGSVGElement>("[data-slop-cracks]")!;
        const cookieText = cookie.querySelector<HTMLElement>("[data-slop-cookie-text]")!;
        let rejects = 0;
        let againTimer: ReturnType<typeof setTimeout> | null = null;
        const SVG = "http://www.w3.org/2000/svg";
        const rnd = (a: number, b: number) => a + Math.random() * (b - a);

        /** Procedural glass crack: radial branches with jittered segments and sub-branches, drawn outward over time. */
        function crackGlass(cx: number, cy: number) {
            const W = innerWidth, H = innerHeight;
            cracks.setAttribute("viewBox", `0 0 ${W} ${H}`);
            const g = document.createElementNS(SVG, "g");
            g.classList.add("slop-crack");
            type Seg = { d: string; depth: number; delay: number; len: number };
            const segs: Seg[] = [];
            const SPEED = 2.2; // px per ms of crack growth

            function grow(x: number, y: number, angle: number, len: number, depth: number, delay: number) {
                let d = `M${x.toFixed(1)} ${y.toFixed(1)}`;
                let px = x, py = y, a = angle, left = len, total = 0;
                const base = rnd(24, 56);
                while (left > 0 && px > -60 && px < W + 60 && py > -60 && py < H + 60) {
                    const s = Math.min(base * rnd(0.6, 1.4), left);
                    a += rnd(-0.28, 0.28);
                    px += Math.cos(a) * s;
                    py += Math.sin(a) * s;
                    left -= s;
                    total += s;
                    d += ` L${px.toFixed(1)} ${py.toFixed(1)}`;
                    if (depth < 3 && Math.random() < 0.2) {
                        const side = Math.random() < 0.5 ? -1 : 1;
                        grow(px, py, a + side * rnd(0.5, 1.3), left * rnd(0.3, 0.6), depth + 1, delay + total / SPEED);
                    }
                }
                segs.push({ d, depth, delay, len: total });
            }

            const spokes = Math.round(rnd(7, 11));
            const reach = Math.hypot(W, H) * rnd(0.45, 0.8);
            for (let i = 0; i < spokes; i++) {
                grow(cx, cy, (i / spokes) * Math.PI * 2 + rnd(-0.3, 0.3), reach * rnd(0.45, 1), 0, 0);
            }
            // impact rings: rough polygons around the point
            for (const r of [rnd(10, 16), rnd(26, 40)]) {
                const n = Math.round(rnd(7, 10));
                let d = "";
                for (let i = 0; i <= n; i++) {
                    const t = (i / n) * Math.PI * 2;
                    const rr = r * rnd(0.75, 1.25);
                    d += `${i ? "L" : "M"}${(cx + Math.cos(t) * rr).toFixed(1)} ${(cy + Math.sin(t) * rr).toFixed(1)}`;
                }
                segs.push({ d: d + "Z", depth: 1, delay: 0, len: r * 6 });
            }

            for (const s of segs) {
                for (const cls of ["slop-crack-shadow", "slop-crack-glint", "slop-crack-line"]) {
                    const p = document.createElementNS(SVG, "path");
                    p.setAttribute("d", s.d);
                    p.setAttribute("pathLength", "1");
                    p.setAttribute("class", `${cls} depth-${s.depth}`);
                    g.appendChild(p);
                    if (reduceMotion || !p.animate) {
                        p.style.strokeDashoffset = "0";
                    } else {
                        p.animate([{ strokeDashoffset: 1 }, { strokeDashoffset: 0 }], {
                            duration: Math.max(120, s.len / SPEED),
                            delay: s.delay,
                            easing: "ease-out",
                            fill: "forwards",
                        });
                    }
                }
            }
            // impact flash
            const flash = document.createElementNS(SVG, "circle");
            flash.setAttribute("cx", String(cx));
            flash.setAttribute("cy", String(cy));
            flash.setAttribute("r", "6");
            flash.setAttribute("class", "slop-crack-flash");
            g.appendChild(flash);
            if (!reduceMotion && flash.animate) {
                flash.animate([{ r: 6, opacity: 0.95 }, { r: 90, opacity: 0 }] as Keyframe[], { duration: 520, easing: "ease-out", fill: "forwards" })
                    .onfinish = () => flash.remove();
            } else flash.remove();
            cracks.appendChild(g);

            // a few shards tumble from the impact
            if (!reduceMotion) {
                const shards = document.createElementNS(SVG, "g");
                shards.setAttribute("class", "slop-shards");
                for (let i = 0; i < 7; i++) {
                    const sz = rnd(6, 16);
                    const poly = document.createElementNS(SVG, "polygon");
                    poly.setAttribute("points", `0,0 ${sz},${rnd(-sz / 2, sz / 2)} ${rnd(0, sz / 2)},${sz}`);
                    poly.setAttribute("transform", `translate(${cx} ${cy})`);
                    shards.appendChild(poly);
                    const dx = rnd(-160, 160), dy = rnd(180, 420);
                    poly.animate(
                        [
                            { transform: `translate(${cx}px, ${cy}px) rotate(0deg)`, opacity: 1 },
                            { transform: `translate(${cx + dx}px, ${cy + dy}px) rotate(${rnd(-300, 300)}deg)`, opacity: 0 },
                        ],
                        { duration: rnd(600, 1000), easing: "cubic-bezier(.3,.6,.7,1)", fill: "forwards" },
                    );
                }
                cracks.appendChild(shards);
                setTimeout(() => shards.remove(), 1100);
                html.classList.add("mask-jolt");
                setTimeout(() => html.classList.remove("mask-jolt"), 600);
            }
        }

        cookie.querySelector<HTMLButtonElement>("[data-slop-cookie-reject]")?.addEventListener("click", (e) => {
            const btn = e.currentTarget as HTMLElement;
            const r = btn.getBoundingClientRect();
            const x = e.clientX || r.left + r.width / 2;
            const y = e.clientY || r.top + r.height / 2;
            rejects++;
            crackGlass(x, y);
            cookie.hidden = true;
            if (againTimer) clearTimeout(againTimer);
            againTimer = setTimeout(() => {
                if (html.dataset.mask !== "present") return;
                cookieText.textContent = i18n.again[Math.min(rejects, i18n.again.length) - 1];
                cookie.hidden = false;
            }, reduceMotion ? 600 : 2200);
        });

        // ---------- wiring ----------
        function apply(mask: string | null) {
            if (mask === "past") startVhs(); else stopVhs();
            if (mask === "present") startSlop(); else stopSlop();
        }
        document.addEventListener("mask-change", ((e: CustomEvent) => apply(e.detail?.mask ?? null)) as EventListener);
        document.addEventListener("visibilitychange", () => {
            const hidden = document.hidden;
            html.classList.toggle("mask-paused", hidden);
            const mask = html.dataset.mask ?? null;
            if (hidden) { stopVhs(); if (popTimer) { clearInterval(popTimer); popTimer = null; } }
            else apply(mask);
        });
        apply(html.dataset.mask ?? null);
    }

    initMaskThemes();
</script>
