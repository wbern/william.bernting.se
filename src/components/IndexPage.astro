---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Projects from "../components/Projects.astro";
import NumbersGame from "../components/NumbersGame.astro";
import Timeline from "../components/Timeline.astro";
import Skills from "../components/Skills.astro";
import Quote from "../components/Quote.astro";
import SlideDots from "../components/SlideDots.astro";
import PdfButton from "../components/PdfButton.astro";
import MaskThemes from "../components/MaskThemes.astro";
import { useTranslations } from "../i18n/utils";
import type { Lang } from "../i18n/ui";
import { CONTACT } from "../i18n/contact";

const lang = (Astro.currentLocale ?? "sv") as Lang;
const t = useTranslations(lang);
---

<Layout title={t("meta.title")} description={t("meta.description")}>
    <div id="slider" class="keen-slider">
        <div class="keen-slider__slide" data-keen-slider-scrollable style="overflow-y: scroll">
            <Hero />
            <p class="future-line" data-future-line><span class="future-text">{t("future.hero")}</span></p>
        </div>
        <div class="keen-slider__slide" data-keen-slider-scrollable style="overflow-y: scroll">
            <Projects />
            <p class="future-line" data-future-line><span class="future-text">{t("future.projects")}</span></p>
        </div>
        <div class="keen-slider__slide" data-keen-slider-scrollable style="overflow-y: scroll">
            <NumbersGame />
            <p class="future-line" data-future-line><span class="future-text">{t("future.numbers")}</span></p>
        </div>
        <div class="keen-slider__slide" data-keen-slider-scrollable style="overflow-y: scroll">
            <Timeline />
            <p class="future-line" data-future-line><span class="future-text">{t("future.timeline")}</span></p>
        </div>
        <div class="keen-slider__slide" data-keen-slider-scrollable style="overflow-y: scroll">
            <Skills />
            <p class="future-line" data-future-line><span class="future-text">{t("future.skills")}</span></p>
        </div>
        <div class="keen-slider__slide section-quote" data-keen-slider-scrollable style="overflow-y: scroll">
            <Quote />
            <p class="future-line" data-future-line>
                <span class="future-text">{t("future.contact")}</span>
                <a class="future-email" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
            </p>
        </div>
    </div>

    <SlideDots count={6} />
    <MaskThemes />
    {/* Hidden until the CV view is ready for public consumption. */}
    {/* <PdfButton /> */}
</Layout>

<script>
    import KeenSlider from "keen-slider";

    // Mousewheel plugin for keen-slider — one slide per swipe.
    // Mac trackpads produce inertia tails with decaying deltas after a flick.
    // Strategy: lock after triggering, stay locked while deltas decay (inertia),
    // but unlock immediately if a fresh high-delta gesture breaks the pattern.
    // Global flag: freeze all slide navigation when project detail is open
    let sliderFrozen = false;
    let sliderInstance: any = null;
    document.addEventListener("detail-view-toggle", ((e: CustomEvent) => {
        sliderFrozen = e.detail.active;
        // Disable keen-slider's built-in touch drag
        if (sliderInstance) {
            sliderInstance.update({ ...sliderInstance.options, drag: !sliderFrozen });
        }
    }) as EventListener);

    function WheelControls(slider: any) {
        let locked = false;
        let unlockTimer: ReturnType<typeof setTimeout> | null = null;
        let recentDelta = 0; // smoothed recent absolute delta
        const QUIET_MS = 200;
        const SPIKE_RATIO = 1.5; // new delta must be 1.5× recent to count as fresh gesture
        const SLIDE_COOLDOWN_MS = 600; // hard cooldown between slide transitions
        let lastSlideTime = 0;
        const BOUNDARY_GRACE_MS = 300; // grace period after hitting scroll boundary
        let lastScrollableTime = 0; // last time content was actually scrollable

        function currentSlideEl(): HTMLElement | null {
            const idx = slider.track.details.rel;
            return slider.slides[idx] ?? null;
        }

        function elementCanScroll(el: HTMLElement, deltaY: number): boolean {
            const tolerance = 1;
            if (deltaY > 0) {
                return el.scrollTop + el.clientHeight < el.scrollHeight - tolerance;
            }
            return el.scrollTop > tolerance;
        }

        /** Walk from event target up to slide, checking for any scrollable ancestor. */
        function anyAncestorCanScroll(target: HTMLElement, slide: HTMLElement, deltaY: number): boolean {
            let node: HTMLElement | null = target;
            while (node && node !== slider.container) {
                const ov = getComputedStyle(node).overflowY;
                if ((ov === "auto" || ov === "scroll") && elementCanScroll(node, deltaY)) {
                    return true;
                }
                node = node.parentElement as HTMLElement | null;
            }
            return false;
        }

        slider.on("created", () => {
            slider.container.addEventListener(
                "wheel",
                (e: WheelEvent) => {
                    if (sliderFrozen) return;

                    const slide = currentSlideEl();
                    const canScroll = slide && anyAncestorCanScroll(e.target as HTMLElement, slide, e.deltaY);
                    if (canScroll) {
                        recentDelta = 0;
                        locked = false;
                        lastScrollableTime = performance.now();
                        return;
                    }

                    e.preventDefault();

                    // Grace period: if content was just scrollable, absorb
                    // events briefly so hitting a scroll boundary doesn't
                    // immediately trigger a slide change.
                    if (performance.now() - lastScrollableTime < BOUNDARY_GRACE_MS) {
                        return;
                    }

                    const absDelta = Math.abs(e.deltaY);

                    // Quiet-period fallback: unlock if no events for QUIET_MS
                    if (unlockTimer) clearTimeout(unlockTimer);
                    unlockTimer = setTimeout(() => {
                        locked = false;
                        recentDelta = 0;
                    }, QUIET_MS);

                    if (locked) {
                        // Check for a fresh gesture: delta spikes above decaying trend
                        if (absDelta > recentDelta * SPIKE_RATIO && absDelta > 3) {
                            locked = false; // let it through below
                        } else {
                            // Still inertia — track the decay and swallow
                            recentDelta = recentDelta * 0.8 + absDelta * 0.2;
                            return;
                        }
                    }

                    // Hard cooldown: prevent rapid successive slide changes
                    const now = performance.now();
                    if (now - lastSlideTime < SLIDE_COOLDOWN_MS) {
                        locked = true;
                        recentDelta = absDelta;
                        return;
                    }

                    // Trigger slide change and lock
                    locked = true;
                    recentDelta = absDelta;
                    lastSlideTime = now;

                    if (e.deltaY > 0) {
                        if (isAtLastSlide(slider)) signalEnd();
                        else slider.next();
                    } else {
                        slider.prev();
                    }
                },
                { passive: false }
            );
        });
    }

    function isAtLastSlide(slider: any): boolean {
        return slider.track.details.rel >= slider.slides.length - 1;
    }

    /** Tell the last slide that the user tried to go past it. */
    function signalEnd() {
        document.dispatchEvent(new CustomEvent("slider-end-reached"));
    }

    // Only the visible slide is focusable / exposed to assistive tech, so
    // Tab never lands on (and scrolls to) content in an off-screen slide.
    let inertIndex = -1;
    function updateInert(index: number) {
        if (index === inertIndex) return;
        inertIndex = index;
        document.querySelectorAll<HTMLElement>("#slider > .keen-slider__slide").forEach((slide, i) => {
            slide.inert = i !== index;
        });
    }

    // Reveal animations for current slide
    function revealSlide(index: number) {
        const slides = document.querySelectorAll(".keen-slider__slide");
        slides.forEach((slide, i) => {
            const reveals = slide.querySelectorAll(".reveal");
            if (i === index) {
                reveals.forEach((el) => el.classList.add("visible"));
            } else {
                reveals.forEach((el) => el.classList.remove("visible"));
            }
        });
    }

    // Update dot navigation
    function updateDots(index: number) {
        const dots = document.querySelectorAll(".slide-dot");
        dots.forEach((dot, i) => {
            dot.classList.toggle("active", i === index);
        });
    }

    // Initialize slider
    const sliderEl = document.getElementById("slider");
    if (sliderEl) {
        const slider = sliderInstance = new KeenSlider(
            sliderEl,
            {
                vertical: true,
                slides: { perView: 1 },
                defaultAnimation: { duration: 500 },
                detailsChanged: (s) => {
                    const slideIndex = s.track.details.rel;
                    updateDots(slideIndex);
                    updateInert(slideIndex);
                    document.dispatchEvent(new CustomEvent("slide-changed", { detail: { index: slideIndex } }));
                },
                animationEnded: (s) => {
                    revealSlide(s.track.details.rel);
                },
                created: () => {
                    // Reveal first slide immediately
                    revealSlide(0);
                    updateInert(0);
                },
            },
            [WheelControls]
        );

        // keen-slider measures its container once at creation and then only on
        // window resize. WebKit (iOS Safari) can run this module before the
        // stylesheet has applied, so the container is measured at its unstyled
        // content height and every slide ends up thousands of px tall. Re-measure
        // whenever the container's real size changes. update() stops a running
        // slide animation (e.g. the deep-link move below), so resume it.
        new ResizeObserver(() => {
            const h = sliderEl.getBoundingClientRect().height;
            if (h <= 0 || Math.abs(h - slider.size) <= 1) return;
            const target = slider.animator.targetIdx;
            slider.update();
            if (target !== null) slider.moveToIdx(target);
        }).observe(sliderEl);

        // Slides only ever scroll vertically. overflow-x: hidden still lets
        // focus()/scrollIntoView shove a slide sideways and clip its left edge;
        // undo any such shift immediately.
        sliderEl.addEventListener("scroll", (e) => {
            const el = e.target;
            if (el instanceof HTMLElement && el.scrollLeft !== 0) el.scrollLeft = 0;
        }, { capture: true, passive: true });

        // Deep link: if URL has a hash, navigate to projects slide
        if (location.hash) {
            requestAnimationFrame(() => {
                slider.moveToIdx(1);
            });
        }

        // Dot click navigation
        document.querySelectorAll(".slide-dot").forEach((dot) => {
            dot.addEventListener("click", () => {
                const slideIndex = Number(
                    (dot as HTMLElement).dataset.slide
                );
                slider.moveToIdx(slideIndex);
            });
        });

        // Programmatic navigation from slide content (e.g. "Back to top")
        document.addEventListener("slider-goto", ((e: CustomEvent) => {
            if (sliderFrozen) return;
            const idx = Number(e.detail?.index);
            if (Number.isInteger(idx)) slider.moveToIdx(idx);
        }) as EventListener);

        // Keyboard navigation (with cooldown to prevent rapid-fire from key repeat)
        let lastKeySlideTime = 0;
        const KEY_COOLDOWN_MS = 600;
        document.addEventListener("keydown", (e) => {
            if (sliderFrozen) return;
            if (e.key === "ArrowDown" || e.key === "PageDown") {
                e.preventDefault();
                const now = performance.now();
                if (now - lastKeySlideTime < KEY_COOLDOWN_MS) return;
                lastKeySlideTime = now;
                if (isAtLastSlide(slider)) signalEnd();
                else slider.next();
            } else if (e.key === "ArrowUp" || e.key === "PageUp") {
                e.preventDefault();
                const now = performance.now();
                if (now - lastKeySlideTime < KEY_COOLDOWN_MS) return;
                lastKeySlideTime = now;
                slider.prev();
            }
        });
    }

    // Redirect print to the CV page (which has proper print styles)
    const cvPath = document.querySelector<HTMLAnchorElement>(".pdf-btn")?.href;
    if (cvPath) {
        const cvPrintUrl = cvPath + "?print=1";

        // Intercept Ctrl+P / Cmd+P
        document.addEventListener("keydown", (e) => {
            if ((e.ctrlKey || e.metaKey) && e.key === "p") {
                e.preventDefault();
                window.location.href = cvPrintUrl;
            }
        });

        // Fallback for File > Print menu
        window.addEventListener("beforeprint", () => {
            window.location.href = cvPrintUrl;
        });
    }
</script>
