        color: var(--text-dim);
    }
    .tl-card .tl-actions { margin-top: 16px; }

    .tl-link {
        font-size: 14px;
        font-weight: 600;
        color: var(--c);
        text-decoration: none;
        border-bottom: 1px solid color-mix(in srgb, var(--c) 40%, transparent);
