        place-items: center;
        border-radius: 8px;
        border: 1px solid var(--border);
        background: transparent;
        color: var(--text-dim);
        cursor: pointer;
        transition: color 0.15s ease, background 0.15s ease;
    }
    .tl-icon-btn:hover:not(:disabled) { color: var(--text); background: var(--bg-card-hover); }
    .tl-icon-btn:disabled { opacity: 0.3; cursor: default; }
    .tl-icon-btn:focus-visible { outline: 2px solid var(--c); outline-offset: 1px; }

    .tl-card-who {
        font-size: 14px;
        color: var(--text-dim);
        margin-bottom: clamp(8px, 1.6vh, 14px);
    }
    .tl-card-who strong { color: var(--text); }

    .tl-card-main {
        display: flex;
        align-items: center;
        gap: 18px;
        margin-bottom: 10px;
    }
    .tl-stat {
        flex: none;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        padding-right: 18px;
        border-right: 1px solid var(--border);
    }
    .tl-stat-value {
        font-size: clamp(34px, 5.4vh, 52px);
        font-weight: 800;
        letter-spacing: -1.5px;
        line-height: 1;
        color: var(--c);
    }
    .tl-stat-unit {
        font-family: var(--mono);
        font-size: 11px;
        color: var(--text-dim);
        margin-top: 4px;
        max-width: 12ch;
        line-height: 1.3;
    }
    .tl-card-headline {
        font-size: clamp(18px, 2.7vh, 25px);
        font-weight: 800;
        line-height: 1.2;
        letter-spacing: -0.3px;
        text-wrap: balance;
    }
    .tl-card-context {
        font-size: 13px;
        color: var(--text-dim);
        margin-bottom: 12px;
        line-height: 1.5;
    }
    .tl-card-bullets {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-bottom: 4px;
    }
    .tl-card-bullets li {
        position: relative;
        padding-left: 16px;
        font-size: clamp(13px, 1.75vh, 15px);
        line-height: 1.5;
