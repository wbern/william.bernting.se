---
import { useTranslations } from "../i18n/utils";
import { defaultLang, type Lang } from "../i18n/ui";
import { getJobs } from "../i18n/jobs";
import { getArcSteps, getTimeline } from "../i18n/timeline";

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);
const jobs = getJobs(lang);
const timeline = getTimeline(lang);
// Reverse: index 0 = bottom (oldest, HP), last = top (own agency).
// DOM order is chronological, which is also the screen-reader order.
const blocks = [...timeline].reverse();
const N = blocks.length;
const colorOf = Object.fromEntries(blocks.map((b) => [b.id, b.color]));
const arc = getArcSteps(lang);
// Lowest freelance block: where the KenDev rail starts
const firstFreelance = blocks.findIndex((b) => b.freelance);

function splitDate(date: string): [string, string] {
    const m = date.match(/^(\d{4})(.*)$/);
    return m ? [m[1], m[2]] : [date, ""];
}
---

<div class="section-inner tower-section" data-timeline>
    <header class="tl-head">
        <div class="section-label reveal">{t("timeline.label")}</div>
        <h2 class="section-heading tl-heading reveal reveal-delay-1">
            {t("timeline.heading.before")}<span class="highlight">{t("timeline.heading.highlight")}</span>{t("timeline.heading.after")}
        </h2>
        <p class="tl-sub reveal reveal-delay-1">{t("timeline.sub")}</p>
    </header>

    <div class="tl-body reveal reveal-delay-2" data-tl-body>
        <div class="tl-tower-col">
            <div class="tower-stage" data-testid="tower-stage">
                <ol class="tower-container" aria-label={t("timeline.listAria")}>
                    {blocks.map((block, i) => {
                        const [start, rest] = splitDate(block.date);
                        return (
                            <li
                                class:list={[
                                    "tower-row",
                                    block.freelance && "is-freelance",
                                    i === firstFreelance && "is-freelance-start",
                                ]}
                            >
                                <span class="row-date" aria-hidden="true"><span>{start}</span><span class="row-date-rest">{rest}</span></span>
                                <span class="row-rail" aria-hidden="true"></span>
                                <span class="row-lane">
                                    <button
                                        type="button"
                                        class:list={["tower-block", block.ongoing && "is-ongoing"]}
                                        data-block-index={i}
                                        data-job={block.id}
                                        aria-pressed="false"
                                        aria-controls={`tl-card-${block.id}`}
                                        tabindex={i === N - 1 ? 0 : -1}
                                        style={`--block-color: ${block.color}; --block-w: ${block.w};`}
                                    >
                                        <span class="tower-label">
                                            <span class="label-role">{block.role}</span>
                                            <span class="label-company">
                                                {block.company}
                                                <span class="tl-sr">, {block.period}</span>
                                                {block.chip && <span class="label-chip">{block.chip}</span>}
                                            </span>
                                        </span>
                                    </button>
                                </span>
                            </li>
                        );
                    })}
                </ol>
                <div class="tower-floor"></div>
            </div>

            <div class="tl-foot">
                <span class="tl-legend tl-legend-width"><i aria-hidden="true"></i>{t("timeline.legend.width")}</span>
                <span class="tl-legend tl-legend-rail"><i aria-hidden="true"></i>{t("timeline.legend.freelance")}</span>
                <button
                    type="button"
                    class="tl-knock"
                    data-knock
                >
                    <svg class="tl-knock-icon" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M4 20h16M7 16l3-9 4 4 3-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    <span class="tl-knock-labels">
                        <span class="tl-knock-l-knock">{t("timeline.knock")}</span>
                        <span class="tl-knock-l-rebuild" aria-hidden="true">{t("timeline.rebuild")}</span>
                    </span>
                </button>
            </div>
        </div>

        <aside class="tl-panel" data-tl-panel>
            <section class="tl-arc" data-arc>
                <p class="tl-panel-label">{t("timeline.arc.label")}</p>
                <ol class="tl-arc-steps">
                    {arc.map((step) => (
                        <li>
                            <button type="button" class="tl-arc-step" data-arc-step={step.id} style={`--c: ${colorOf[step.id]};`}>
                                <span class="tl-arc-dot" aria-hidden="true"></span>
                                <span>{step.text}</span>
                            </button>
                        </li>
                    ))}
                </ol>
                <blockquote class="tl-arc-quote">
                    &ldquo;{t("timeline.arc.quote")}&rdquo;
                </blockquote>
                <div class="tl-actions">
                    <button type="button" class="tl-cta" data-goto-contact>
                        {t("timeline.cta")}
                        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M5 12h13m-5-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>
                    <span class="tl-hint">
                        <span class="tl-hint-pointer">{t("timeline.hint.pointer")}</span>
                        <span class="tl-hint-touch">{t("timeline.hint.touch")}</span>
                    </span>
                </div>
            </section>

            <section class="tl-freed-msg" data-freed-msg hidden>
                <p>{t("timeline.freed")}</p>
            </section>

            {blocks.map((block, i) => (
                <article
                    class="tl-card"
                    id={`tl-card-${block.id}`}
                    data-card={block.id}
                    aria-labelledby={`tl-card-h-${block.id}`}
                    style={`--c: ${block.color};`}
                    hidden
                >
                    <div class="tl-card-top">
                        <span class="tl-card-swatch" aria-hidden="true"></span>
                        <span class="tl-card-period">{block.period}</span>
                        <span class="tl-card-nav">
                            <button type="button" class="tl-icon-btn" data-step="-1" aria-label={t("timeline.prev")} disabled={i === 0}>
                                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            </button>
                            <button type="button" class="tl-icon-btn" data-step="1" aria-label={t("timeline.next")} disabled={i === N - 1}>
                                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M6 15l6-6 6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            </button>
                            <button type="button" class="tl-icon-btn" data-close aria-label={t("timeline.close")}>
                                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
                            </button>
                        </span>
                    </div>
                    <p class="tl-card-who"><strong>{block.company}</strong> · {block.role}</p>
                    <div class="tl-card-main">
                        {block.stat && (
                            <div class="tl-stat">
                                <span class="tl-stat-value">{block.stat.value}</span>
                                <span class="tl-stat-unit">{block.stat.unit}</span>
                            </div>
                        )}
                        <h3 class="tl-card-headline" id={`tl-card-h-${block.id}`}>{block.headline}</h3>
                    </div>
                    <p class="tl-card-context">{block.context}</p>
                    <ul class="tl-card-bullets">
                        {block.bullets.map((b) => <li set:html={b} />)}
                    </ul>
                    {block.quote && (
                        <figure class="tl-card-quote">
                            <blockquote lang={block.quote.lang}>&ldquo;{block.quote.text}&rdquo;</blockquote>
                            <figcaption>&mdash; {block.quote.name}, {block.quote.relation[lang]}</figcaption>
                        </figure>
                    )}
                    {(block.cta || block.project) && (
                        <div class="tl-actions">
                            {block.cta && (
                                <button type="button" class="tl-cta" data-goto-contact>
                                    {t("timeline.cta")}
                                    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M5 12h13m-5-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                </button>
                            )}
                            {block.project && (
                                <a class="tl-link" href={`#${block.project}`} data-project={block.project}>
                                    {t("timeline.project")} &rarr;
                                </a>
                            )}
                        </div>
                    )}
                </article>
            ))}
        </aside>
    </div>
</div>

<!-- Print fallback -->
<div class="timeline-print-fallback" style="display:none">
    <div class="section-label">{t("timeline.label")}</div>
    <h2 class="section-heading">{t("timeline.heading.before")}<span class="highlight">{t("timeline.heading.highlight")}</span>{t("timeline.heading.after")}</h2>
    <div class="timeline-print-list">
        {jobs.map((job) => (
            <div class="timeline-print-item">
                <div class="timeline-print-date">{job.date}</div>
                <div class="timeline-print-role">{job.role}</div>
                <div class="timeline-print-company">{job.company}</div>
            </div>
        ))}
    </div>
</div>

<style>
    .tower-section {
        --tl-gap: clamp(4px, 0.8vh, 8px);
        --tl-scale: 0.5%;
        --tl-gutter: 66px;
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: stretch;
        width: 100%;
        max-width: 1160px;
        height: 100%;
    }

    .tl-sr {
        position: absolute;
        width: 1px; height: 1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
    }

    /* ===== HEAD ===== */
    .tl-heading { margin-bottom: 10px; }
    .tl-sub {
        color: var(--text-dim);
        font-size: clamp(14px, 1.9vh, 17px);
        line-height: 1.5;
        max-width: 56ch;
        margin-bottom: clamp(14px, 3vh, 30px);
    }

    /* ===== BODY: tower left, story panel right ===== */
    .tl-body {
        flex: 1 1 0;
        min-height: 0;
        display: grid;
        grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
        gap: clamp(20px, 3vw, 48px);
        max-height: 640px;
    }

    .tl-tower-col {
        display: flex;
        flex-direction: column;
        min-height: 0;
        min-width: 0;
    }

    .tower-stage {
        position: relative;
        flex: 1 1 0;
        min-height: 0;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .tower-container {
        list-style: none;
        flex: 1;
        min-height: 0;
        display: flex;
        flex-direction: column-reverse;
        justify-content: center;
        gap: var(--tl-gap);
        padding-bottom: 4px;
    }

    .tower-row {
        flex: 1 1 0;
        min-height: 24px;
        max-height: 64px;
        display: flex;
        align-items: stretch;
    }

    /* Start year on the left: static, stays put when the tower is knocked down */
    .row-date {
        flex: 0 0 var(--tl-gutter);
        align-self: center;
        font-family: var(--mono);
        font-size: clamp(10px, 1.25vh, 12px);
        color: var(--text-muted);
        white-space: nowrap;
        transition: color 0.2s ease;
    }

    /* KenDev freelance rail between the dates and the blocks */
    .row-rail {
        flex: 0 0 14px;
        position: relative;
    }
    .is-freelance .row-rail::before {
        content: '';
        position: absolute;
        left: 5px;
        width: 2px;
        top: 0;
        bottom: calc(-1 * var(--tl-gap));
        background: rgba(236, 236, 244, 0.55);
        border-radius: 2px;
    }
    .is-freelance-start .row-rail::before { bottom: 50%; }
    .is-freelance-start .row-rail::after {
        content: '';
        position: absolute;
        left: 2px;
        top: calc(50% - 4px);
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #ececf4;
    }

    .row-lane {
        flex: 1 1 auto;
        min-width: 0;
        display: flex;
        align-items: stretch;
    }

    /* ===== BLOCK ===== */
    .tower-block {
        appearance: none;
        border: 0;
        padding: 0;
        font: inherit;
        color: inherit;
        text-align: left;
        cursor: pointer;
        display: block;
        flex: none;
        height: 100%;
        width: calc(var(--block-w) * var(--tl-scale));
        border-radius: 4px;
        position: relative;
        opacity: 0;
        transform: translateY(-300px);
        will-change: transform;
        transform-origin: center bottom;
        translate: 0 0;
        transition: translate 0.25s cubic-bezier(.2,.8,.2,1), filter 0.25s ease, box-shadow 0.25s ease;
        background:
            linear-gradient(135deg,
                rgba(255,255,255,0.2) 0%,
                rgba(255,255,255,0.06) 35%,
                transparent 55%),
            var(--block-color);
        box-shadow:
            inset 0 1px 0 rgba(255,255,255,0.3),
            inset 0 -2px 0 rgba(0,0,0,0.2),
            0 2px 6px rgba(0,0,0,0.4);
        -webkit-tap-highlight-color: transparent;
    }

    /* Grid texture */
    .tower-block::before {
        content: '';
        position: absolute;
        inset: 0;
        background-image:
            linear-gradient(90deg, rgba(0,0,0,0.07) 1px, transparent 1px),
            linear-gradient(0deg, rgba(0,0,0,0.07) 1px, transparent 1px);
        background-size: 15px 15px;
        border-radius: inherit;
        pointer-events: none;
    }

    /* Ongoing: the block keeps going as a dashed, fading tail */
    .tower-block.is-ongoing { --tail: 22px; }
    .tower-block.is-ongoing::after {
        content: '';
        position: absolute;
        top: 18%;
        bottom: 18%;
        left: calc(100% + 3px);
        width: var(--tail);
        background: repeating-linear-gradient(90deg, var(--block-color) 0 5px, transparent 5px 9px);
        -webkit-mask-image: linear-gradient(90deg, #000, transparent);
        mask-image: linear-gradient(90deg, #000, transparent);
        opacity: 0.7;
        border-radius: 2px;
        pointer-events: none;
    }

    .tower-block:focus-visible {
        outline: 2px solid var(--text);
        outline-offset: 3px;
    }

    /* Selected block nudges right; the rest dim */
    .tower-block.is-active {
        translate: 10px 0;
        box-shadow:
            inset 0 1px 0 rgba(255,255,255,0.35),
            inset 0 -2px 0 rgba(0,0,0,0.2),
            0 0 0 2px var(--bg),
            0 0 0 4px var(--block-color),
            0 6px 18px rgba(0,0,0,0.45);
    }
    .has-selection .tower-block:not(.is-active) {
        filter: saturate(0.55) brightness(0.6);
    }
    .has-selection .tower-block:not(.is-active) .tower-label { opacity: 0.5; }
    .has-selection .tower-row:has(.is-active) .row-date { color: var(--text); }

    @media (hover: hover) and (pointer: fine) {
        .tower-block.settled:hover:not(.is-active) { translate: 4px 0; }
    }

    .tower-block.freed { cursor: grab; transition: none; translate: none; filter: none; }
    .tower-block.freed:active { cursor: grabbing; }

    /* One-time nudge on the top block so the tower reads as clickable */
    .tower-block.nudge { animation: tl-nudge 1.6s ease-in-out 2; }
    @keyframes tl-nudge {
        0%, 100% { box-shadow: inset 0 1px 0 rgba(255,255,255,0.3), 0 0 0 0 color-mix(in srgb, var(--block-color) 60%, transparent); }
        50% { box-shadow: inset 0 1px 0 rgba(255,255,255,0.3), 0 0 0 8px color-mix(in srgb, var(--block-color) 0%, transparent); }
    }

    /* ===== LABEL (right of block) ===== */
    .tower-label {
        position: absolute;
        left: calc(100% + 14px + var(--tail, 0px));
        top: 50%;
        transform: translateY(-50%);
        display: flex;
        flex-direction: column;
        white-space: nowrap;
        opacity: 0;
        transition: opacity 0.3s ease;
        pointer-events: none;
    }

    .tower-block.settled .tower-label,
    .tower-block.freed .tower-label {
        opacity: 1;
    }

    .label-role {
        font-size: clamp(13px, 1.9vh, 18px);
        font-weight: 700;
        color: var(--text);
        line-height: 1.2;
    }

    .label-company {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: clamp(10px, 1.3vh, 13px);
        color: var(--text-dim);
        line-height: 1.3;
        font-family: var(--mono);
    }

    .label-chip {
        font-family: var(--sans);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.02em;
        color: var(--bg);
        background: var(--block-color);
        padding: 1px 7px;
        border-radius: 999px;
        line-height: 1.5;
    }

    /* ===== FLOOR + FOOT ===== */
    .tower-floor {
        margin-left: calc(var(--tl-gutter) + 14px);
        height: 3px;
        background: var(--border);
        border-radius: 2px;
        flex-shrink: 0;
    }

    .tl-foot {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 6px 16px;
        padding: 10px 0 0 calc(var(--tl-gutter) + 14px);
        font-family: var(--mono);
        font-size: 11px;
        color: var(--text-muted);
    }
    .tl-legend { display: inline-flex; align-items: center; gap: 7px; }
    .tl-legend i { display: inline-block; flex: none; }
    .tl-legend-width i {
        width: 22px; height: 8px;
        border: 1px solid var(--text-muted);
        border-radius: 2px;
        position: relative;
    }
    .tl-legend-width i::after {
        content: '';
        position: absolute;
        left: 2px; right: 2px; top: 50%;
        height: 1px;
        background: var(--text-muted);
    }
    .tl-legend-rail i {
        width: 2px; height: 14px;
        background: rgba(236, 236, 244, 0.55);
        border-radius: 2px;
    }

    .tl-knock {
        margin-left: auto;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        appearance: none;
        background: transparent;
        border: 1px solid var(--border);
        color: var(--text-dim);
        font: inherit;
        font-size: 11px;
        padding: 5px 10px;
        border-radius: 999px;
        cursor: pointer;
        transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
    }
    .tl-knock:hover { color: var(--text); border-color: var(--text-muted); }
    .tl-knock:focus-visible { outline: 2px solid var(--purple); outline-offset: 2px; }
    /* Both labels share one grid cell so the button never changes width */
    .tl-knock-labels { display: inline-grid; }
    .tl-knock-labels > span { grid-area: 1 / 1; text-align: left; }
    .tl-knock-l-rebuild { visibility: hidden; }
    .tl-knock[data-state="freed"] .tl-knock-l-knock { visibility: hidden; }
    .tl-knock[data-state="freed"] .tl-knock-l-rebuild { visibility: visible; }
    .tl-knock[data-state="freed"] {
        color: var(--bg);
        background: var(--text);
        border-color: var(--text);
    }

    /* ===== STORY PANEL ===== */
    .tl-panel {
        position: relative;
        min-height: 0;
        min-width: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .tl-arc, .tl-card, .tl-freed-msg {
        animation: tl-in 0.28s cubic-bezier(.2,.8,.2,1);
    }
    @keyframes tl-in {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: none; }
    }

    .tl-panel-label {
        font-family: var(--mono);
        font-size: 11px;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--text-muted);
        margin-bottom: 14px;
    }

    .tl-arc-steps {
        list-style: none;
        display: flex;
        flex-direction: column;
        position: relative;
        margin-bottom: clamp(16px, 3vh, 28px);
    }
    .tl-arc-steps::before {
        content: '';
        position: absolute;
        left: 6px;
        top: 18px;
        bottom: 18px;
        width: 2px;
        background: linear-gradient(var(--border), var(--text-muted));
    }
    .tl-arc-step {
        appearance: none;
        background: transparent;
        border: 0;
        color: var(--text);
        font: inherit;
        font-size: clamp(15px, 2.1vh, 19px);
        font-weight: 600;
        line-height: 1.35;
        text-align: left;
        display: flex;
        align-items: baseline;
        gap: 16px;
        padding: 9px 10px 9px 0;
        border-radius: 8px;
        cursor: pointer;
        width: 100%;
        transition: color 0.2s ease, transform 0.2s ease;
    }
    .tl-arc-step:hover, .tl-arc-step:focus-visible { transform: translateX(4px); }
    .tl-arc-step:focus-visible { outline: 2px solid var(--c); outline-offset: 2px; }
    .tl-arc-dot {
        flex: none;
        width: 14px;
        height: 14px;
        border-radius: 3px;
        background: var(--c);
        position: relative;
        top: 1px;
        box-shadow: 0 0 0 3px var(--bg);
    }

    .tl-arc-quote {
        font-size: clamp(14px, 1.8vh, 16px);
        font-style: italic;
        color: var(--text-dim);
        text-indent: -0.42em;
        margin-bottom: clamp(16px, 3vh, 28px);
    }

    .tl-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px 18px;
    }

    .tl-cta {
        appearance: none;
        border: 0;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--purple);
        color: #fff;
        font: inherit;
        font-size: 15px;
        font-weight: 700;
        padding: 10px 18px;
        border-radius: 999px;
        cursor: pointer;
        transition: transform 0.2s ease, background 0.2s ease;
    }
    .tl-cta:hover { background: var(--purple-dim); transform: translateY(-1px); }
    .tl-cta:hover svg { transform: translateX(2px); }
    .tl-cta svg { transition: transform 0.2s ease; }
    .tl-cta:focus-visible { outline: 2px solid var(--text); outline-offset: 3px; }

    .tl-hint {
        font-family: var(--mono);
        font-size: 12px;
        color: var(--text-muted);
    }
    .tl-hint-touch { display: none; }
    @media (hover: none), (pointer: coarse) {
        .tl-hint-pointer { display: none; }
        .tl-hint-touch { display: inline; }
    }

    .tl-freed-msg p {
        font-size: 16px;
        color: var(--text-dim);
        max-width: 34ch;
    }

    /* ===== CARD ===== */
    .tl-card {
        position: relative;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: clamp(16px, 2.6vh, 26px) clamp(18px, 2vw, 28px);
        max-height: 100%;
        overflow-y: auto;
        scrollbar-width: thin;
        box-shadow: 0 20px 60px rgba(0,0,0,0.45);
    }
    .tl-card[hidden], .tl-arc[hidden], .tl-freed-msg[hidden] { display: none; }

    .tl-card-top {
        display: flex;
        align-items: center;
