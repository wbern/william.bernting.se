    @media (max-width: 600px) {
        .tower-section { --tl-scale: 0.38%; }
        .tl-card { padding: 14px 16px 16px 18px; max-height: 74%; }
        .tl-card-who { font-size: 13px; margin-bottom: 6px; }
        .tl-card-main { flex-direction: column; align-items: flex-start; gap: 4px; margin-bottom: 8px; }
        .tl-stat { flex-direction: row; align-items: baseline; gap: 8px; padding-right: 0; border-right: 0; }
        .tl-stat-value { font-size: 30px; letter-spacing: -1px; }
        .tl-stat-unit { margin-top: 0; max-width: none; }
        .tl-card-headline { font-size: 19px; }
        .tl-card-context { font-size: 12px; margin-bottom: 8px; }
        .tl-card-bullets { gap: 6px; }
        .tl-card-bullets li { font-size: 13px; line-height: 1.45; }
        .tl-card-quote { margin-top: 10px; }
        .tl-card-quote blockquote { font-size: 12.5px; }
        .tl-card .tl-actions { margin-top: 12px; }
        .tl-sub { font-size: 14px; margin-bottom: 14px; }
        .tower-row { min-height: 26px; max-height: 46px; }
        .tower-label { left: calc(100% + 9px + var(--tail, 0px)); }
        .tower-block.is-ongoing { --tail: 14px; }
        .label-chip { display: none; }
        .tl-foot { font-size: 10px; gap: 6px 12px; }
        .tl-knock { padding: 4px 9px; font-size: 10px; }
