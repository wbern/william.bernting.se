    .tl-link:hover { border-bottom-color: var(--c); }
    .tl-link:focus-visible { outline: 2px solid var(--c); outline-offset: 3px; border-radius: 2px; }

    /* ===== NARROW: tower full width, card becomes a bottom sheet ===== */
    @media (max-width: 899px) {
        .tower-section { --tl-scale: 0.46%; }
        .tl-body {
            grid-template-columns: minmax(0, 1fr);
            grid-template-rows: minmax(0, 1fr) auto;
            gap: 14px;
            max-height: none;
        }
        .tl-arc .tl-panel-label,
        .tl-arc-steps,
        .tl-arc-quote { display: none; }
        .tl-panel { position: static; display: grid; align-content: start; }
        /* Arc row and knocked-down note share a cell so the tower never resizes */
        .tl-arc, .tl-freed-msg { grid-area: 1 / 1; }
        .tl-arc[hidden], .tl-freed-msg[hidden] { display: block; visibility: hidden; }
        .tl-arc .tl-actions { padding-left: calc(var(--tl-gutter) + 14px); }
        .tl-cta { font-size: 14px; padding: 8px 16px; }
        .tl-freed-msg { padding-left: calc(var(--tl-gutter) + 14px); }
        .tl-freed-msg p { font-size: 14px; }

        .tl-card {
            position: absolute;
            left: -4px;
            right: -4px;
            bottom: 0;
            max-height: min(68%, 520px);
            z-index: 5;
            box-shadow: 0 -10px 40px rgba(0,0,0,0.6);
            animation-name: tl-sheet;
        }
        @keyframes tl-sheet {
            from { opacity: 0; transform: translateY(24px); }
            to { opacity: 1; transform: none; }
        }
    }

    @media (max-width: 600px) {
        .tower-section { --tl-scale: 0.38%; }
        .tl-card { padding: 14px 16px 16px 18px; max-height: 74%; }
        .tl-card-who { font-size: 13px; margin-bottom: 6px; }
        .tl-card-main { flex-direction: column; align-items: flex-start; gap: 4px; margin-bottom: 8px; }
        .tl-stat { flex-direction: row; align-items: baseline; gap: 8px; padding-right: 0; border-right: 0; }
        .tl-stat-value { font-size: 30px; letter-spacing: -1px; }
        .tl-stat-unit { margin-top: 0; max-width: none; }
        .tl-card-headline { font-size: 19px; }
        .tl-card-context { font-size: 12px; margin-bottom: 8px; }
        .tl-card-bullets { gap: 6px; }
        .tl-card-bullets li { font-size: 13px; line-height: 1.45; }
        .tl-card-quote { margin-top: 10px; }
        .tl-card-quote blockquote { font-size: 12.5px; }
        .tl-card .tl-actions { margin-top: 12px; }
        .tl-sub { font-size: 14px; margin-bottom: 14px; }
        .tower-row { min-height: 26px; max-height: 46px; }
        .tower-label { left: calc(100% + 9px + var(--tail, 0px)); }
        .tower-block.is-ongoing { --tail: 14px; }
        .label-chip { display: none; }
        .tl-foot { font-size: 10px; gap: 6px 12px; }
        .tl-knock { padding: 4px 9px; font-size: 10px; }
    }

    /* Only the start year on phones — "2020 – 21" does not fit next to a 6-month block */
    @media (max-width: 420px) {
        .tower-section { --tl-gutter: 32px; }
        .row-date-rest { display: none; }
        .tl-legend-rail { order: 1; }
        .tl-knock { margin-left: 0; }
    }

    /* Short laptop screens: tighten the card so it rarely needs to scroll */
    @media (min-width: 900px) and (max-height: 780px) {
        .tl-sub { margin-bottom: 12px; }
        .tl-card { padding: 14px 20px 16px 22px; }
        .tl-card-who { margin-bottom: 6px; }
        .tl-card-context { margin-bottom: 8px; }
        .tl-card-bullets { gap: 5px; }
        .tl-card-quote { margin-top: 10px; }
        .tl-card .tl-actions { margin-top: 10px; }
    }

    /* Short phones (iPhone SE and friends): drop the extras, keep the tower whole */
    @media (max-width: 899px) and (max-height: 700px) {
        .tl-sub { display: none; }
        .tl-heading { margin-bottom: 14px; }
        .tower-row { min-height: 20px; }
        .tl-arc .tl-cta { display: none; }
        .tl-foot { padding-top: 6px; }
    }

    /* Reduced motion */
    @media (prefers-reduced-motion: reduce) {
        .tower-block { opacity: 1; transform: none; transition: none; }
        .tower-label { opacity: 1; transition: none; }
        .tl-arc, .tl-card, .tl-freed-msg { animation: none; }
        .tower-block.nudge { animation: none; }
    }

    /* Print */
    .timeline-print-fallback { display: none; }
    @media print {
        .tower-section { display: none !important; }
        .timeline-print-fallback { display: block !important; }
        .timeline-print-list { position: relative; padding-left: 24px; }
        .timeline-print-list::before {
            content: ''; position: absolute; left: 5px; top: 0; bottom: 0;
            width: 2px; background: var(--border);
        }
        .timeline-print-item { position: relative; margin-bottom: 5px; padding-left: 14px; }
        .timeline-print-item::before {
            content: ''; position: absolute; left: -22px; top: 5px;
            width: 8px; height: 8px; border-radius: 50%;
            background: var(--purple); border: 3px solid var(--bg);
        }
        .timeline-print-item:first-child::before { box-shadow: 0 0 12px var(--purple); }
        .timeline-print-date { font-family: var(--mono); font-size: 8px; color: var(--purple); }
        .timeline-print-role { font-size: 10px; font-weight: 700; line-height: 1.2; }
        .timeline-print-company { font-size: 8px; color: var(--text-dim); }
    }
</style>

<script>
    import Matter from 'matter-js';

    (function () {
        /*
         * Spring-damper physics: F = -K * displacement - B * velocity
         * Damping ratio ζ = B / (2√K). ζ < 1 = underdamped wobble.
         *
         * All transforms are offsets from the block's natural flex position.
         * Y=0 is "at rest in stack". Y<0 is "above rest".
         */

        const { Engine, Composite, Bodies, Body, Mouse, MouseConstraint, Events } = Matter;

        const GRAVITY    = 1800;   // px/s² — slower, dramatic fall
        const DT_CAP     = 0.05;
        const STAGGER_MS = 110;    // gap between block drops
        const START_Y    = -300;   // initial offset above rest

        // Y spring (bounce on landing)
        const Y_K = 450;  const Y_B = 30;   // ζ ≈ 0.71

        // X spring (lateral wobble)
        const X_K = 380;  const X_B = 24;   // ζ ≈ 0.62

        // Rotation spring
        const R_K = 320;  const R_B = 21;   // ζ ≈ 0.59

        const SETTLE_VEL = 1.0;
        const SETTLE_POS = 0.5;

        const WALL_THICKNESS = 60;

        const root = document.querySelector<HTMLElement>('[data-timeline]');
        const stage = root?.querySelector<HTMLElement>('.tower-stage');
        if (!root || !stage) return;
        const els = Array.from(stage.querySelectorAll<HTMLElement>('.tower-block'));
        if (!els.length) return;
        const panel = root.querySelector<HTMLElement>('[data-tl-panel]')!;
        const arcEl = root.querySelector<HTMLElement>('[data-arc]')!;
        const freedMsg = root.querySelector<HTMLElement>('[data-freed-msg]')!;
        const knockBtn = root.querySelector<HTMLButtonElement>('[data-knock]')!;
        const cards = new Map<string, HTMLElement>();
        root.querySelectorAll<HTMLElement>('[data-card]').forEach((c) => cards.set(c.dataset.card!, c));
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // Per-block personality derived from count — scales with any number of jobs
        const N = els.length;
        const W      = Array.from({length: N}, (_, i) => +((i + 1) / N).toFixed(2));
        const REST_X = Array.from({length: N}, (_, i) =>
            i === 0 ? 0 : +((i % 2 ? 1 : -1) * (0.5 + 0.3 * Math.sin(i * 1.7))).toFixed(1));
        const REST_R = Array.from({length: N}, (_, i) =>
            i === 0 ? 0 : +((i % 2 ? -1 : 1) * (0.15 + 0.1 * Math.sin(i * 2.3))).toFixed(2));
        const HIT_R  = Array.from({length: N}, (_, i) =>
            i === 0 ? 0 : Math.round((i % 2 ? 1 : -1) * (20 + i * 4)));
        const HIT_X  = Array.from({length: N}, (_, i) =>
            i === 0 ? 0 : Math.round((i % 2 ? 1 : -1) * (10 + i * 2)));

        let animId: number | null = null;
        let running = false;
        let nudged = false;

        // Matter.js state
        let engine: Matter.Engine | null = null;
        let mConstraint: Matter.MouseConstraint | null = null;
        let mMouse: Matter.Mouse | null = null;
        let walls: Matter.Body[] = [];
        let freed = false;

        interface S {
            el: HTMLElement; i: number;
            y: number; vy: number;
            x: number; vx: number;
            r: number; vr: number;
            phase: 'wait' | 'fall' | 'settle' | 'done' | 'freed';
            t0: number;
            body: Matter.Body | null;
            w: number; h: number;
        }
        const st: S[] = [];

        // ─── Story selection ───

        let selected = -1;

        function showPanel(which: 'arc' | 'freed' | number) {
            arcEl.hidden = which !== 'arc';
            freedMsg.hidden = which !== 'freed';
            cards.forEach((card) => { card.hidden = true; });
            if (typeof which === 'number') {
                const card = cards.get(els[which].dataset.job!);
                if (card) card.hidden = false;
            }
        }

        function setRoving(i: number) {
            els.forEach((el, j) => { el.tabIndex = j === i ? 0 : -1; });
        }

        function select(i: number, opts: { focus?: boolean } = {}) {
            if (freed || i < 0 || i >= N) return;
            if (i === selected) { if (opts.focus) els[i].focus(); return; }
            selected = i;
            els.forEach((el, j) => {
                const on = j === i;
                el.classList.toggle('is-active', on);
                el.setAttribute('aria-pressed', String(on));
            });
            root.classList.add('has-selection');
            setRoving(i);
            showPanel(i);
            stopNudge();
            if (opts.focus) els[i].focus({ preventScroll: true });
        }

        function deselect(opts: { focusBlock?: boolean } = {}) {
            const prev = selected;
            selected = -1;
            els.forEach((el) => {
                el.classList.remove('is-active');
                el.setAttribute('aria-pressed', 'false');
            });
            root.classList.remove('has-selection');
            showPanel(freed ? 'freed' : 'arc');
            if (opts.focusBlock && prev >= 0) els[prev].focus({ preventScroll: true });
        }

        function stopNudge() {
            els.forEach((el) => el.classList.remove('nudge'));
        }

        const indexOfJob = (id: string) => els.findIndex((el) => el.dataset.job === id);

        stage.addEventListener('click', (e) => {
            const block = (e.target as HTMLElement).closest<HTMLElement>('.tower-block');
            if (!block || freed) return;
            select(Number(block.dataset.blockIndex));
        });

        // Hover explores on mouse — no click needed
        let hoverTimer: ReturnType<typeof setTimeout> | null = null;
        els.forEach((el, i) => {
            el.addEventListener('pointerenter', (e) => {
                if (e.pointerType !== 'mouse' || freed) return;
                if (hoverTimer) clearTimeout(hoverTimer);
                hoverTimer = setTimeout(() => select(i), 90);
            });
            el.addEventListener('pointerleave', () => {
                if (hoverTimer) { clearTimeout(hoverTimer); hoverTimer = null; }
            });
            el.addEventListener('focus', () => {
                if (!freed && selected !== i && el.matches(':focus-visible')) select(i);
            });
        });

        // Arrow keys walk the tower; at either end the slider gets the key
        stage.addEventListener('keydown', (e) => {
            const block = (e.target as HTMLElement).closest<HTMLElement>('.tower-block');
            if (!block || freed) return;
            const i = Number(block.dataset.blockIndex);
            let next: number | null = null;
            if (e.key === 'ArrowUp' || e.key === 'ArrowRight') next = i + 1;
            else if (e.key === 'ArrowDown' || e.key === 'ArrowLeft') next = i - 1;
            else if (e.key === 'Home') next = 0;
            else if (e.key === 'End') next = N - 1;
            else if (e.key === 'Escape' && selected >= 0) {
                e.stopPropagation();
                deselect({ focusBlock: true });
                return;
            }
            if (next === null || next < 0 || next >= N) return;
            e.preventDefault();
            e.stopPropagation();
            select(next, { focus: true });
        });

        panel.addEventListener('click', (e) => {
            const target = e.target as HTMLElement;
            const step = target.closest<HTMLElement>('[data-step]');
            if (step && selected >= 0) {
                select(selected + Number(step.dataset.step));
                return;
            }
            if (target.closest('[data-close]')) {
                deselect({ focusBlock: true });
                return;
            }
            const arcStep = target.closest<HTMLElement>('[data-arc-step]');
            if (arcStep) {
                select(indexOfJob(arcStep.dataset.arcStep!), { focus: true });
                return;
            }
            if (target.closest('[data-goto-contact]')) {
                const last = document.querySelectorAll('#slider > .keen-slider__slide').length - 1;
                document.dispatchEvent(new CustomEvent('slider-goto', { detail: { index: last } }));
                return;
            }
            const project = target.closest<HTMLAnchorElement>('[data-project]');
            if (project) {
                // Projects.astro opens the detail view for a matching hash
                // when its slide becomes active.
                e.preventDefault();
                history.replaceState(null, '', `#${project.dataset.project}`);
                document.dispatchEvent(new CustomEvent('slider-goto', { detail: { index: 1 } }));
            }
        });

        panel.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && selected >= 0) {
                e.stopPropagation();
                deselect({ focusBlock: true });
            }
        });

        // The mobile sheet sits over the slide: keep its touches away from keen-slider
        const stopProp = (e: Event) => { if (selected >= 0) e.stopPropagation(); };
        panel.addEventListener('touchstart', stopProp, { passive: true });
        panel.addEventListener('touchmove', stopProp, { passive: true });
        panel.addEventListener('mousedown', stopProp);

        // ─── Drop-in animation ───

        function init() {
            st.length = 0;
            els.forEach((el, i) => {
                el.style.opacity = '0';
                el.style.transform = `translateY(${START_Y}px)`;
                el.classList.remove('settled');
                st.push({
                    el, i,
                    y: START_Y, vy: 0,
                    x: 0, vx: 0,
                    r: 0, vr: 0,
                    phase: 'wait',
                    t0: i * STAGGER_MS,
                    body: null,
                    w: 0, h: 0,
                });
            });
        }

        function tx(s: S) {
            s.el.style.transform =
                `translateY(${s.y}px) translateX(${s.x}px) rotate(${s.r}deg)`;
        }

        function onAllSettled() {
            if (nudged || selected >= 0) return;
            nudged = true;
            els[N - 1].classList.add('nudge');
            els[N - 1].addEventListener('animationend', stopNudge, { once: true });
        }

        function run() {
            if (running) return;
            running = true;
            init();
            const t0 = performance.now();
            let prev = t0;

            function tick(now: number) {
                const dt = Math.min((now - prev) / 1000, DT_CAP);
                prev = now;
                const elapsed = now - t0;
                let allDone = true;

                for (const s of st) {
                    if (s.phase === 'done' || s.phase === 'freed') continue;
                    allDone = false;

                    if (s.phase === 'wait') {
                        if (elapsed >= s.t0) {
                            s.phase = 'fall';
                            s.el.style.opacity = '1';
                        }
                        continue;
                    }

                    if (s.phase === 'fall') {
                        s.vy += GRAVITY * dt;
                        s.y += s.vy * dt;
                        // Gentle tumble
                        s.r = Math.sin(elapsed * 0.005 + s.i * 1.7) * 3 * W[s.i];

                        if (s.y >= 0) {
                            s.y = 0;
                            s.phase = 'settle';
                            s.vy = -s.vy * 0.1;
                            s.vx = HIT_X[s.i] * W[s.i];
                            s.vr = HIT_R[s.i] * W[s.i];
                            s.r = 0;
                            s.x = 0;
                        }
                        tx(s);
                        continue;
                    }

                    if (s.phase === 'settle') {
                        // Y spring
                        s.vy += (-Y_K * s.y - Y_B * s.vy) * dt;
                        s.y  += s.vy * dt;
                        // X spring
                        const xr = REST_X[s.i];
                        s.vx += (-X_K * (s.x - xr) - X_B * s.vx) * dt;
                        s.x  += s.vx * dt;
                        // Rotation spring
                        const rr = REST_R[s.i];
                        s.vr += (-R_K * (s.r - rr) - R_B * s.vr) * dt;
                        s.r  += s.vr * dt;

                        if (Math.abs(s.vy) < SETTLE_VEL &&
                            Math.abs(s.y) < SETTLE_POS &&
                            Math.abs(s.vx) < SETTLE_VEL &&
                            Math.abs(s.vr) < SETTLE_VEL) {
                            s.phase = 'done';
                            s.y = 0; s.x = xr; s.r = rr;
                            s.el.classList.add('settled');
                        }
                        tx(s);
                    }
                }

                if (allDone) { animId = null; running = false; onAllSettled(); return; }
                animId = requestAnimationFrame(tick);
            }
            animId = requestAnimationFrame(tick);
        }

        function showFinal() {
            st.length = 0;
            els.forEach((el, i) => {
                el.style.opacity = '1';
                el.style.transform =
                    `translateY(0) translateX(${REST_X[i]}px) rotate(${REST_R[i]}deg)`;
                el.classList.add('settled');
                st.push({
                    el, i, y: 0, vy: 0, x: REST_X[i], vx: 0, r: REST_R[i], vr: 0,
                    phase: 'done', t0: 0, body: null, w: 0, h: 0,
                });
            });
        }

        function teardownPhysics() {
            if (animId !== null) { cancelAnimationFrame(animId); animId = null; }
            running = false;
            freed = false;

            if (mConstraint && engine) {
                Composite.remove(engine.world, mConstraint);
            }
            if (mMouse) {
                Mouse.clearSourceEvents(mMouse);
                mMouse = null;
            }
            mConstraint = null;
            walls = [];
            if (engine) {
                Engine.clear(engine);
                engine = null;
            }
            window.removeEventListener('resize', updateWalls);
            stage.removeEventListener('touchmove', preventDefaultOnDrag);
            stage.removeEventListener('mousedown', ensureSyncRunning);
            stage.removeEventListener('touchstart', ensureSyncRunning);

            els.forEach(el => {
                el.style.position = '';
                el.style.left = '';
                el.style.top = '';
                el.style.flex = '';
                el.style.width = '';
                el.style.height = '';
                el.classList.remove('freed');
            });
            for (const s of st) s.body = null;
            setKnockState(false);
        }

        function reset() {
            teardownPhysics();
            deselect();
            setRoving(N - 1);
            els.forEach(el => {
                el.style.opacity = '0';
                el.style.transform = `translateY(${START_Y}px)`;
                el.classList.remove('settled', 'nudge');
            });
        }

        // ─── Knock it down / rebuild ───

        function setKnockState(isFreed: boolean) {
            knockBtn.dataset.state = isFreed ? 'freed' : '';
            knockBtn.querySelector('.tl-knock-l-knock')!.toggleAttribute('aria-hidden', isFreed);
            knockBtn.querySelector('.tl-knock-l-rebuild')!.toggleAttribute('aria-hidden', !isFreed);
        }

        knockBtn.addEventListener('click', () => {
            if (freed) {
                teardownPhysics();
                showPanel('arc');
                if (reducedMotion) { showFinal(); return; }
                els.forEach(el => el.classList.remove('settled'));
                run();
                return;
            }
            // Finish an in-flight drop first so every block has a rest rect
            if (running) {
                if (animId !== null) cancelAnimationFrame(animId);
                animId = null; running = false;
                showFinal();
            }
            deselect();
            freeAllBlocks();
            // Give the tower a shove so it actually falls
            for (const s of st) {
                if (!s.body) continue;
                const dir = s.i % 2 ? 1 : -1;
                Body.setVelocity(s.body, { x: dir * (2 + Math.random() * 5), y: -2 - Math.random() * 4 * W[s.i] });
                Body.setAngularVelocity(s.body, dir * (0.04 + Math.random() * 0.08));
            }
            showPanel('freed');
        });

        // ─── Matter.js freed-block physics ───

        /** Free ALL blocks — snapshot positions, switch to absolute, create Matter.js world */
        function freeAllBlocks() {
            if (freed) return;
            freed = true;
            setKnockState(true);
            stopNudge();

            const stageRect = stage.getBoundingClientRect();
            const stageW = stage.offsetWidth;
            const stageH = stage.offsetHeight;
            const snapshots: { s: S; rect: DOMRect }[] = [];

            // 1) Snapshot every block's current visual rect while flex is intact
            for (const s of st) {
                if (s.phase !== 'done') continue;
                snapshots.push({ s, rect: s.el.getBoundingClientRect() });
            }

            // 2) Apply absolute positioning using the snapshotted rects
            for (const { s, rect } of snapshots) {
                s.phase = 'freed';
                s.el.classList.remove('settled');
                s.el.classList.add('freed');

                s.w = rect.width;
                s.h = rect.height;
                s.x = rect.left - stageRect.left;
                s.y = rect.top - stageRect.top;
                s.r = 0;

                s.el.style.width = rect.width + 'px';
                s.el.style.height = rect.height + 'px';
                s.el.style.position = 'absolute';
                s.el.style.left = '0';
                s.el.style.top = '0';
                s.el.style.flex = 'none';

                tx(s);
            }

            // 3) Create Matter.js engine and world
            engine = Engine.create({ enableSleeping: true });

            // 4) Create static walls (floor, left, right, ceiling)
            walls = createWalls(stageW, stageH);
            Composite.add(engine.world, walls);
            window.addEventListener('resize', updateWalls);

            // 5) Create a Matter body for each freed block
            for (const { s } of snapshots) {
                const cx = s.x + s.w / 2;
                const cy = s.y + s.h / 2;

                const body = Bodies.rectangle(cx, cy, s.w, s.h, {
                    restitution: 0.2,
                    friction: 0.6,
                    frictionStatic: 1.0,
                    frictionAir: 0.01,
                    density: 0.002,
                    sleepThreshold: 30,
                });
                s.body = body;
                Composite.add(engine.world, body);
            }

            // 6) Set up MouseConstraint for drag-and-throw
            mMouse = Mouse.create(stage);
            mConstraint = MouseConstraint.create(engine, {
                mouse: mMouse,
                constraint: {
                    stiffness: 0.8,
                    render: { visible: false },
                } as any,
            });
            Composite.add(engine.world, mConstraint);

            // Restart sync loop when user grabs a sleeping body
            Events.on(mConstraint, 'startdrag', () => ensureSyncRunning());
            // The constraint only grabs during an engine tick, and the loop stops
            // once the pile sleeps. Tick again on press so a settled block can be grabbed.
            stage.addEventListener('mousedown', ensureSyncRunning);
            stage.addEventListener('touchstart', ensureSyncRunning, { passive: true });

            // Prevent default scroll/zoom on stage during drag
            stage.addEventListener('touchmove', preventDefaultOnDrag, { passive: false });

            // 7) Start the sync loop
            startSyncLoop();
        }

        function stopSliderPropagation(e: Event) {
            // Only in knocked-down mode: the standing tower lets swipes through
            // so the slider still works when a phone screen is mostly tower.
            if (!freed) return;
            const onBlock = (e.target as HTMLElement)?.closest?.('.tower-block');
            const draggingBody = mConstraint && mConstraint.body;
            if (!onBlock && !draggingBody) return;
            e.stopPropagation();
        }

        function createWalls(w: number, h: number): Matter.Body[] {
            return [
                Bodies.rectangle(w / 2, h + WALL_THICKNESS / 2, w + WALL_THICKNESS * 2, WALL_THICKNESS, { isStatic: true }),       // floor
                Bodies.rectangle(w / 2, -WALL_THICKNESS / 2, w + WALL_THICKNESS * 2, WALL_THICKNESS, { isStatic: true }),            // ceiling
                Bodies.rectangle(-WALL_THICKNESS / 2, h / 2, WALL_THICKNESS, h + WALL_THICKNESS * 2, { isStatic: true }),            // left
                Bodies.rectangle(w + WALL_THICKNESS / 2, h / 2, WALL_THICKNESS, h + WALL_THICKNESS * 2, { isStatic: true }),         // right
            ];
        }

        function updateWalls() {
            if (!engine) return;
            const stageW = stage.offsetWidth;
            const stageH = stage.offsetHeight;
            Composite.remove(engine.world, walls);
            walls = createWalls(stageW, stageH);
            Composite.add(engine.world, walls);
        }

        function preventDefaultOnDrag(e: TouchEvent) {
            if (mConstraint && mConstraint.body) {
                e.preventDefault();
            }
        }

        /** Sync Matter.js body positions → DOM transforms each frame */
        function startSyncLoop() {
            if (!engine) return;

            function syncDOM() {
                if (!engine) return;
                Engine.update(engine, 1000 / 60);

                let allSleeping = true;
                for (const s of st) {
                    if (s.phase !== 'freed' || !s.body) continue;
                    if (s.body.isSleeping) continue; // skip DOM write for sleeping bodies
                    allSleeping = false;
                    s.x = s.body.position.x - s.w / 2;
                    s.y = s.body.position.y - s.h / 2;
                    s.r = s.body.angle * (180 / Math.PI);
                    tx(s);
                }

                if (allSleeping && !mConstraint?.body) {
                    animId = null;
                    return;
                }
                animId = requestAnimationFrame(syncDOM);
            }
            animId = requestAnimationFrame(syncDOM);
        }

        /** Resume the sync loop if it was paused due to all bodies sleeping */
        function ensureSyncRunning() {
            if (animId !== null || !engine) return;
            startSyncLoop();
        }

        // Prevent mouse/touch events from bubbling to keen-slider while the
        // tower is knocked down — otherwise block drags read as slide swipes.
        stage.addEventListener('mousedown', stopSliderPropagation);
        stage.addEventListener('mousemove', stopSliderPropagation);
        stage.addEventListener('mouseup', stopSliderPropagation);
        stage.addEventListener('touchstart', stopSliderPropagation);
        stage.addEventListener('touchmove', stopSliderPropagation);
        stage.addEventListener('touchend', stopSliderPropagation);

        if (reducedMotion) {
            showFinal(); return;
        }

        const rev = root.querySelector('[data-tl-body]') || stage;
        let resetTimer: ReturnType<typeof setTimeout> | null = null;

        const obs = new MutationObserver(() => {
            if (rev.classList.contains('visible')) {
                if (resetTimer) { clearTimeout(resetTimer); resetTimer = null; }
                if (!running && !st.some((s) => s.phase === 'done' || s.phase === 'freed')) run();
            } else {
                // Delay reset so transient class flickers (e.g. click) don't restart
                resetTimer = setTimeout(() => { reset(); st.length = 0; resetTimer = null; }, 200);
            }
        });
        obs.observe(rev, { attributes: true, attributeFilter: ['class'] });
        if (rev.classList.contains('visible')) run();
    })();
</script>
