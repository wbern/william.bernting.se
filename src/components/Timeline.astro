    /* Only the start year on phones — "2020 – 21" does not fit next to a 6-month block */
    @media (max-width: 420px) {
        .tower-section { --tl-gutter: 32px; }
        .row-date-rest { display: none; }
        .tl-legend-rail { order: 1; }
        .tl-knock { margin-left: 0; }
    }

    /* Short laptop screens: tighten the card so it rarely needs to scroll */
    @media (min-width: 900px) and (max-height: 780px) {
        .tl-sub { margin-bottom: 12px; }
        .tl-card { padding: 14px 20px 16px 22px; }
        .tl-card-who { margin-bottom: 6px; }
        .tl-card-context { margin-bottom: 8px; }
        .tl-card-bullets { gap: 5px; }
        .tl-card-quote { margin-top: 10px; }
        .tl-card .tl-actions { margin-top: 10px; }
    }

    /* Short phones (iPhone SE and friends): drop the extras, keep the tower whole */
    @media (max-width: 899px) and (max-height: 700px) {
        .tl-sub { display: none; }
        .tl-heading { margin-bottom: 14px; }
        .tower-row { min-height: 20px; }
        .tl-arc .tl-cta { display: none; }
        .tl-foot { padding-top: 6px; }
    }

    /* Reduced motion */
    @media (prefers-reduced-motion: reduce) {
        .tower-block { opacity: 1; transform: none; transition: none; }
        .tower-label { opacity: 1; transition: none; }
        .tl-arc, .tl-card, .tl-freed-msg { animation: none; }
        .tower-block.nudge { animation: none; }
    }

    /* Print */
    .timeline-print-fallback { display: none; }
    @media print {
        .tower-section { display: none !important; }
        .timeline-print-fallback { display: block !important; }
        .timeline-print-list { position: relative; padding-left: 24px; }
        .timeline-print-list::before {
            content: ''; position: absolute; left: 5px; top: 0; bottom: 0;
            width: 2px; background: var(--border);
        }
        .timeline-print-item { position: relative; margin-bottom: 5px; padding-left: 14px; }
        .timeline-print-item::before {
            content: ''; position: absolute; left: -22px; top: 5px;
            width: 8px; height: 8px; border-radius: 50%;
            background: var(--purple); border: 3px solid var(--bg);
        }
        .timeline-print-item:first-child::before { box-shadow: 0 0 12px var(--purple); }
        .timeline-print-date { font-family: var(--mono); font-size: 8px; color: var(--purple); }
        .timeline-print-role { font-size: 10px; font-weight: 700; line-height: 1.2; }
        .timeline-print-company { font-size: 8px; color: var(--text-dim); }
    }
</style>

<script>
    import Matter from 'matter-js';

    (function () {
        /*
         * Spring-damper physics: F = -K * displacement - B * velocity
         * Damping ratio ζ = B / (2√K). ζ < 1 = underdamped wobble.
         *
         * All transforms are offsets from the block's natural flex position.
         * Y=0 is "at rest in stack". Y<0 is "above rest".
         */

        const { Engine, Composite, Bodies, Body, Mouse, MouseConstraint, Events, Sleeping, Query } = Matter;

        const GRAVITY    = 1800;   // px/s² — slower, dramatic fall
        const DT_CAP     = 0.05;
        const STAGGER_MS = 110;    // gap between block drops
        const START_Y    = -300;   // initial offset above rest

        // Y spring (bounce on landing)
        const Y_K = 450;  const Y_B = 30;   // ζ ≈ 0.71

        // X spring (lateral wobble)
        const X_K = 380;  const X_B = 24;   // ζ ≈ 0.62

        // Rotation spring
        const R_K = 320;  const R_B = 21;   // ζ ≈ 0.59

        const SETTLE_VEL = 1.0;
        const SETTLE_POS = 0.5;

        const WALL_THICKNESS = 60;

        // Knocked-down physics: light and floaty (Matter units, one step per frame)
        const GRAVITY_Y = 0.6;     // × Matter's default gravity
        const AIR_DRAG  = 0.016;
        const BOUNCE    = 0.45;

        // Collision categories: blocks still in flight only touch the floor
        const CAT_BLOCK = 0x1;
        const CAT_FLOOR = 0x2;
        const CAT_WALL  = 0x4;
        const CAT_AIR   = 0x8;

        // Blast (2.5D). Depth z > 0 is toward the viewer; scale = FOCAL / (FOCAL - z).
        const ANTICIPATE_MS = 150;
        const FOCAL     = 600;
        const Z_FADE    = FOCAL * 0.45;  // flying past the camera starts fading here…
        const Z_PASS    = FOCAL * 0.76;  // …and has left the screen here
        const Z_K = 0.004;  const Z_B = 0.11;   // depth spring back to the screen plane
        const RAIN_K = 0.012; const RAIN_B = 0.2;
        const TRAIL_LEN   = 5;     // afterimages per block
        const TRAIL_EVERY = 2;     // steps between afterimages
        const DEBRIS      = 40;
        const BLAST_MAX_STEPS = 480;   // ~8 s safety net: anything still flying lands

        const root = document.querySelector<HTMLElement>('[data-timeline]');
        const stage = root?.querySelector<HTMLElement>('.tower-stage');
        if (!root || !stage) return;
        const els = Array.from(stage.querySelectorAll<HTMLElement>('.tower-block'));
        if (!els.length) return;
        const panel = root.querySelector<HTMLElement>('[data-tl-panel]')!;
        const arcEl = root.querySelector<HTMLElement>('[data-arc]')!;
        const freedMsg = root.querySelector<HTMLElement>('[data-freed-msg]')!;
        const knockBtn = root.querySelector<HTMLButtonElement>('[data-knock]')!;
        const cards = new Map<string, HTMLElement>();
        root.querySelectorAll<HTMLElement>('[data-card]').forEach((c) => cards.set(c.dataset.card!, c));
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // Per-block personality derived from count — scales with any number of jobs
        const N = els.length;
        const W      = Array.from({length: N}, (_, i) => +((i + 1) / N).toFixed(2));
        const REST_X = Array.from({length: N}, (_, i) =>
            i === 0 ? 0 : +((i % 2 ? 1 : -1) * (0.5 + 0.3 * Math.sin(i * 1.7))).toFixed(1));
        const REST_R = Array.from({length: N}, (_, i) =>
            i === 0 ? 0 : +((i % 2 ? -1 : 1) * (0.15 + 0.1 * Math.sin(i * 2.3))).toFixed(2));
        const HIT_R  = Array.from({length: N}, (_, i) =>
            i === 0 ? 0 : Math.round((i % 2 ? 1 : -1) * (20 + i * 4)));
        const HIT_X  = Array.from({length: N}, (_, i) =>
            i === 0 ? 0 : Math.round((i % 2 ? 1 : -1) * (10 + i * 2)));

        let animId: number | null = null;
        let running = false;
        let nudged = false;

        // Matter.js state
        let engine: Matter.Engine | null = null;
        let mConstraint: Matter.MouseConstraint | null = null;
        let mMouse: Matter.Mouse | null = null;
        let walls: Matter.Body[] = [];
        let freed = false;

        interface S {
            el: HTMLElement; i: number;
            y: number; vy: number;
            x: number; vx: number;
            r: number; vr: number;
            phase: 'wait' | 'fall' | 'settle' | 'done' | 'freed';
            t0: number;
            body: Matter.Body | null;
            w: number; h: number;
        }
        const st: S[] = [];

        // Per-block flight state while the blast runs (indexed like st)
        interface Fly {
            s: S;
            z: number; vz: number;
            zk: number; zb: number;   // depth spring; 0 = free flight (past the camera)
            air: boolean;             // in flight: collides with the floor only
            airT: number;             // steps since launch or respawn
            fade: number;             // 0..1 fade-in after a respawn
            k: number; px: number; py: number;   // projected scale + centre
            trail: number[];          // [x, y, angle, scale, alpha] × TRAIL_LEN
            zi: number; op: number;
            color: string;
        }
        interface Bit {
            x: number; y: number; vx: number; vy: number;
            a: number; va: number; size: number; life: number; max: number; color: string;
        }
        let fly: Fly[] = [];
        let bits: Bit[] = [];
        let blastStep = -1;   // -1 = no blast running
        let knockTimer: ReturnType<typeof setTimeout> | null = null;
        let squash: Animation[] = [];
        // Blast geometry in stage coordinates, measured once when it starts
        let stageW = 0, stageH = 0;
        let vpX = 0, vpY = 0;                          // vanishing point
        let clipL = 0, clipT = 0, clipR = 0, clipB = 0; // visible area
        let fxX = 0, fxY = 0, fxDpr = 1;
        const fxCanvas = root.querySelector<HTMLCanvasElement>('[data-tl-fx]')!;
        const fxCtx = fxCanvas.getContext('2d');
        const flashEl = stage.querySelector<HTMLElement>('[data-blast-flash]')!;
        const ringEl = stage.querySelector<HTMLElement>('[data-blast-ring]')!;

        // ─── Story selection ───

        let selected = -1;

        function showPanel(which: 'arc' | 'freed' | number) {
            arcEl.hidden = which !== 'arc';
            freedMsg.hidden = which !== 'freed';
            cards.forEach((card) => { card.hidden = true; });
            if (typeof which === 'number') {
                const card = cards.get(els[which].dataset.job!);
                if (card) card.hidden = false;
            }
        }

        function setRoving(i: number) {
            els.forEach((el, j) => { el.tabIndex = j === i ? 0 : -1; });
        }

        function select(i: number, opts: { focus?: boolean } = {}) {
            if (freed || i < 0 || i >= N) return;
            if (i === selected) { if (opts.focus) els[i].focus(); return; }
            selected = i;
            els.forEach((el, j) => {
                const on = j === i;
                el.classList.toggle('is-active', on);
                el.setAttribute('aria-pressed', String(on));
            });
            root.classList.add('has-selection');
            setRoving(i);
            showPanel(i);
            stopNudge();
            if (opts.focus) els[i].focus({ preventScroll: true });
        }

        function deselect(opts: { focusBlock?: boolean } = {}) {
            const prev = selected;
            selected = -1;
            els.forEach((el) => {
                el.classList.remove('is-active');
                el.setAttribute('aria-pressed', 'false');
            });
            root.classList.remove('has-selection');
            showPanel(freed ? 'freed' : 'arc');
            if (opts.focusBlock && prev >= 0) els[prev].focus({ preventScroll: true });
        }

        function stopNudge() {
            els.forEach((el) => el.classList.remove('nudge'));
        }

        const indexOfJob = (id: string) => els.findIndex((el) => el.dataset.job === id);

        stage.addEventListener('click', (e) => {
            const block = (e.target as HTMLElement).closest<HTMLElement>('.tower-block');
            if (!block || freed) return;
            select(Number(block.dataset.blockIndex));
        });

        // Hover explores on mouse — no click needed
        let hoverTimer: ReturnType<typeof setTimeout> | null = null;
        els.forEach((el, i) => {
            el.addEventListener('pointerenter', (e) => {
                if (e.pointerType !== 'mouse' || freed) return;
                if (hoverTimer) clearTimeout(hoverTimer);
                hoverTimer = setTimeout(() => select(i), 90);
            });
            el.addEventListener('pointerleave', () => {
                if (hoverTimer) { clearTimeout(hoverTimer); hoverTimer = null; }
            });
            el.addEventListener('focus', () => {
                if (!freed && selected !== i && el.matches(':focus-visible')) select(i);
            });
        });

        // Arrow keys walk the tower; at either end the slider gets the key
        stage.addEventListener('keydown', (e) => {
            const block = (e.target as HTMLElement).closest<HTMLElement>('.tower-block');
            if (!block || freed) return;
            const i = Number(block.dataset.blockIndex);
            let next: number | null = null;
            if (e.key === 'ArrowUp' || e.key === 'ArrowRight') next = i + 1;
            else if (e.key === 'ArrowDown' || e.key === 'ArrowLeft') next = i - 1;
            else if (e.key === 'Home') next = 0;
            else if (e.key === 'End') next = N - 1;
            else if (e.key === 'Escape' && selected >= 0) {
                e.stopPropagation();
                deselect({ focusBlock: true });
                return;
            }
            if (next === null || next < 0 || next >= N) return;
            e.preventDefault();
            e.stopPropagation();
            select(next, { focus: true });
        });

        panel.addEventListener('click', (e) => {
            const target = e.target as HTMLElement;
            const step = target.closest<HTMLElement>('[data-step]');
            if (step && selected >= 0) {
                select(selected + Number(step.dataset.step));
                return;
            }
            if (target.closest('[data-close]')) {
                deselect({ focusBlock: true });
                return;
            }
            const arcStep = target.closest<HTMLElement>('[data-arc-step]');
            if (arcStep) {
                select(indexOfJob(arcStep.dataset.arcStep!), { focus: true });
                return;
            }
            if (target.closest('[data-goto-contact]')) {
                const last = document.querySelectorAll('#slider > .keen-slider__slide').length - 1;
                document.dispatchEvent(new CustomEvent('slider-goto', { detail: { index: last } }));
                return;
            }
            const project = target.closest<HTMLAnchorElement>('[data-project]');
            if (project) {
                // Projects.astro opens the detail view for a matching hash
                // when its slide becomes active.
                e.preventDefault();
                history.replaceState(null, '', `#${project.dataset.project}`);
                document.dispatchEvent(new CustomEvent('slider-goto', { detail: { index: 1 } }));
            }
        });

        panel.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && selected >= 0) {
                e.stopPropagation();
                deselect({ focusBlock: true });
            }
        });

        // The mobile sheet sits over the slide: keep its touches away from keen-slider
        const stopProp = (e: Event) => { if (selected >= 0) e.stopPropagation(); };
        panel.addEventListener('touchstart', stopProp, { passive: true });
        panel.addEventListener('touchmove', stopProp, { passive: true });
        panel.addEventListener('mousedown', stopProp);

        // ─── Drop-in animation ───

        function init() {
            st.length = 0;
            els.forEach((el, i) => {
                el.style.opacity = '0';
                el.style.transform = `translateY(${START_Y}px)`;
                el.classList.remove('settled');
                st.push({
                    el, i,
                    y: START_Y, vy: 0,
                    x: 0, vx: 0,
                    r: 0, vr: 0,
                    phase: 'wait',
                    t0: i * STAGGER_MS,
                    body: null,
                    w: 0, h: 0,
                });
            });
        }

        function tx(s: S) {
            s.el.style.transform =
                `translateY(${s.y}px) translateX(${s.x}px) rotate(${s.r}deg)`;
        }

        function onAllSettled() {
            if (nudged || selected >= 0) return;
            nudged = true;
            els[N - 1].classList.add('nudge');
            els[N - 1].addEventListener('animationend', stopNudge, { once: true });
        }

        function run() {
            if (running) return;
            running = true;
            init();
            const t0 = performance.now();
            let prev = t0;

            function tick(now: number) {
                const dt = Math.min((now - prev) / 1000, DT_CAP);
                prev = now;
                const elapsed = now - t0;
                let allDone = true;

                for (const s of st) {
                    if (s.phase === 'done' || s.phase === 'freed') continue;
                    allDone = false;

                    if (s.phase === 'wait') {
                        if (elapsed >= s.t0) {
                            s.phase = 'fall';
                            s.el.style.opacity = '1';
                        }
                        continue;
                    }

                    if (s.phase === 'fall') {
                        s.vy += GRAVITY * dt;
                        s.y += s.vy * dt;
                        // Gentle tumble
                        s.r = Math.sin(elapsed * 0.005 + s.i * 1.7) * 3 * W[s.i];

                        if (s.y >= 0) {
                            s.y = 0;
                            s.phase = 'settle';
                            s.vy = -s.vy * 0.1;
                            s.vx = HIT_X[s.i] * W[s.i];
                            s.vr = HIT_R[s.i] * W[s.i];
                            s.r = 0;
                            s.x = 0;
                        }
                        tx(s);
                        continue;
                    }

                    if (s.phase === 'settle') {
                        // Y spring
                        s.vy += (-Y_K * s.y - Y_B * s.vy) * dt;
                        s.y  += s.vy * dt;
                        // X spring
                        const xr = REST_X[s.i];
                        s.vx += (-X_K * (s.x - xr) - X_B * s.vx) * dt;
                        s.x  += s.vx * dt;
                        // Rotation spring
                        const rr = REST_R[s.i];
                        s.vr += (-R_K * (s.r - rr) - R_B * s.vr) * dt;
                        s.r  += s.vr * dt;

                        if (Math.abs(s.vy) < SETTLE_VEL &&
                            Math.abs(s.y) < SETTLE_POS &&
                            Math.abs(s.vx) < SETTLE_VEL &&
                            Math.abs(s.vr) < SETTLE_VEL) {
                            s.phase = 'done';
                            s.y = 0; s.x = xr; s.r = rr;
                            s.el.classList.add('settled');
                        }
                        tx(s);
                    }
                }

                if (allDone) { animId = null; running = false; onAllSettled(); return; }
                animId = requestAnimationFrame(tick);
            }
            animId = requestAnimationFrame(tick);
        }

        function showFinal() {
            st.length = 0;
            els.forEach((el, i) => {
                el.style.opacity = '1';
                el.style.transform =
                    `translateY(0) translateX(${REST_X[i]}px) rotate(${REST_R[i]}deg)`;
                el.classList.add('settled');
                st.push({
                    el, i, y: 0, vy: 0, x: REST_X[i], vx: 0, r: REST_R[i], vr: 0,
                    phase: 'done', t0: 0, body: null, w: 0, h: 0,
                });
            });
        }

        function teardownPhysics() {
            if (animId !== null) { cancelAnimationFrame(animId); animId = null; }
            if (knockTimer) { clearTimeout(knockTimer); knockTimer = null; }
            squash.forEach((a) => a.cancel());
            squash = [];
            endBlast();
            running = false;
            freed = false;

            if (mConstraint && engine) {
                Composite.remove(engine.world, mConstraint);
            }
            if (mMouse) {
                Mouse.clearSourceEvents(mMouse);
                mMouse = null;
            }
            mConstraint = null;
            walls = [];
            if (engine) {
                Engine.clear(engine);
                engine = null;
            }
            window.removeEventListener('resize', updateWalls);
            stage.removeEventListener('touchmove', preventDefaultOnDrag);
            stage.removeEventListener('mousedown', ensureSyncRunning);
            stage.removeEventListener('touchstart', ensureSyncRunning);

            els.forEach(el => {
                el.style.position = '';
                el.style.left = '';
                el.style.top = '';
                el.style.flex = '';
                el.style.width = '';
                el.style.height = '';
                el.style.zIndex = '';
                el.style.opacity = '1';
                el.classList.remove('freed', 'is-flying');
            });
            for (const s of st) s.body = null;
            setKnockState(false);
        }

        function reset() {
            teardownPhysics();
            deselect();
            setRoving(N - 1);
            els.forEach(el => {
                el.style.opacity = '0';
                el.style.transform = `translateY(${START_Y}px)`;
                el.classList.remove('settled', 'nudge');
            });
        }

        // ─── Knock it down / rebuild ───

        function setKnockState(isFreed: boolean) {
            knockBtn.dataset.state = isFreed ? 'freed' : '';
            knockBtn.querySelector('.tl-knock-l-knock')!.toggleAttribute('aria-hidden', isFreed);
            knockBtn.querySelector('.tl-knock-l-rebuild')!.toggleAttribute('aria-hidden', !isFreed);
        }

        knockBtn.addEventListener('click', () => {
            if (freed) {
                teardownPhysics();
                showPanel('arc');
                if (reducedMotion) { showFinal(); return; }
                els.forEach(el => el.classList.remove('settled'));
                run();
                return;
            }
            if (knockTimer) return;   // already winding up
            // Finish an in-flight drop first so every block has a rest rect
            if (running) {
                if (animId !== null) cancelAnimationFrame(animId);
                animId = null; running = false;
                showFinal();
            }
            // Read layout before any writes so it is measured once, clean
            const snap = snapshot();
            const geo = reducedMotion ? null : measureBlast();
            deselect();
            freed = true;
            setKnockState(true);
            stopNudge();
            showPanel('freed');

            if (reducedMotion) {
                // No blast: the tower just tips over
                freeAllBlocks(snap);
                for (const s of st) {
                    if (!s.body) continue;
                    const dir = s.i % 2 ? 1 : -1;
                    Body.setVelocity(s.body, { x: dir * (2 + Math.random() * 5), y: -2 - Math.random() * 4 * W[s.i] });
                    Body.setAngularVelocity(s.body, dir * (0.04 + Math.random() * 0.08));
                }
                return;
            }

            // Wind-up: the tower squashes and shivers, then blows.
            // The clip/canvas set-up waits a frame so the click frame stays light.
            requestAnimationFrame(() => requestAnimationFrame(() => { if (knockTimer) prepareBlast(geo!); }));
            els.forEach((el) => el.classList.add('is-flying'));
            squash = st.map((s) => {
                const base = s.el.style.transform;
                const j = () => ((Math.random() - 0.5) * 3).toFixed(1);
                return s.el.animate([
                    { transform: base },
                    { transform: `${base} translateX(${j()}px) scale(1.03, 0.94)`, offset: 0.4 },
                    { transform: `${base} translateX(${j()}px) scale(1.05, 0.9)`, offset: 0.75 },
                    { transform: `${base} scale(1.07, 0.86)` },
                ], { duration: ANTICIPATE_MS, easing: 'ease-in', fill: 'forwards' });
            });
            knockTimer = setTimeout(() => {
                knockTimer = null;
                squash.forEach((a) => a.cancel());
                squash = [];
                freeAllBlocks(snap);
                startBlast();
            }, ANTICIPATE_MS);
        });

        // ─── Matter.js freed-block physics ───

        /** Free ALL blocks — snapshot positions, switch to absolute, create Matter.js world */
        interface Snap { stage: DOMRect; blocks: (DOMRect | null)[] }

        /** Every block's current visual rect, while flex is intact */
        function snapshot(): Snap {
            return {
                stage: stage.getBoundingClientRect(),
                blocks: st.map((s) => (s.phase === 'done' ? s.el.getBoundingClientRect() : null)),
            };
        }

        function freeAllBlocks(snap: Snap = snapshot()) {
            if (engine) return;
            freed = true;
            setKnockState(true);
            stopNudge();

            const stageRect = snap.stage;
            stageW = stageRect.width;
            stageH = stageRect.height;
            const snapshots: { s: S; rect: DOMRect }[] = [];
            st.forEach((s, n) => {
                const rect = snap.blocks[n];
                if (rect) snapshots.push({ s, rect });
            });

            // 1) Apply absolute positioning using the snapshotted rects
            for (const { s, rect } of snapshots) {
                s.phase = 'freed';
                s.el.classList.remove('settled');
                s.el.classList.add('freed');

                s.w = rect.width;
                s.h = rect.height;
                s.x = rect.left - stageRect.left;
                s.y = rect.top - stageRect.top;
                s.r = 0;

                s.el.style.width = rect.width + 'px';
                s.el.style.height = rect.height + 'px';
                s.el.style.position = 'absolute';
                s.el.style.left = '0';
                s.el.style.top = '0';
                s.el.style.flex = 'none';

                tx(s);
            }

            // 2) Create Matter.js engine and world
            engine = Engine.create({ enableSleeping: true, gravity: { x: 0, y: GRAVITY_Y } });

            // 3) Create static walls (floor, left, right, ceiling)
            walls = createWalls(stageW, stageH);
            Composite.add(engine.world, walls);
            window.addEventListener('resize', updateWalls);

            // 4) Create a Matter body for each freed block
            for (const { s } of snapshots) {
                const cx = s.x + s.w / 2;
                const cy = s.y + s.h / 2;

                const body = Bodies.rectangle(cx, cy, s.w, s.h, {
                    restitution: BOUNCE,
                    friction: 0.5,
                    frictionStatic: 0.9,
                    frictionAir: AIR_DRAG,
                    density: 0.002,
                    sleepThreshold: 30,
                });
                s.body = body;
                Composite.add(engine.world, body);
            }

            // 5) Set up MouseConstraint for drag-and-throw
            mMouse = Mouse.create(stage);
            mConstraint = MouseConstraint.create(engine, {
                mouse: mMouse,
                constraint: {
                    stiffness: 0.8,
                    render: { visible: false },
                } as any,
            });
            Composite.add(engine.world, mConstraint);

            // Restart sync loop when user grabs a sleeping body
            Events.on(mConstraint, 'startdrag', () => ensureSyncRunning());
            // The constraint only grabs during an engine tick, and the loop stops
            // once the pile sleeps. Tick again on press so a settled block can be grabbed.
            stage.addEventListener('mousedown', ensureSyncRunning);
            stage.addEventListener('touchstart', ensureSyncRunning, { passive: true });

            // Prevent default scroll/zoom on stage during drag
            stage.addEventListener('touchmove', preventDefaultOnDrag, { passive: false });

            // 6) Start the sync loop
            startSyncLoop();
        }

        // ─── Blast: 2.5D explosion on knock-down ───
        //
        // Matter.js owns x/y/angle; the blast adds a depth axis on top. Blocks in
        // flight only collide with the floor, so they pass through each other
        // and fly past the stage edges. Once a block is back on the screen plane
        // and inside the stage it "lands" and becomes a normal pile block.

        const rand = (a: number, b: number) => a + Math.random() * (b - a);
        const clamp = (v: number, a: number, b: number) => Math.min(b, Math.max(a, v));

        interface BlastGeo { slide: DOMRect; sec: DOMRect; stage: DOMRect; padT: number; padB: number }

        /** One-off layout reads for the blast; nothing per frame reads layout */
        function measureBlast(): BlastGeo {
            const slide = root.parentElement!;
            const cs = getComputedStyle(slide);
            return {
                slide: slide.getBoundingClientRect(),
                sec: root.getBoundingClientRect(),
                stage: stage.getBoundingClientRect(),
                padT: parseFloat(cs.paddingTop) || 0,
                padB: parseFloat(cs.paddingBottom) || 0,
            };
        }

        /** During the wind-up: open up the clip and size the FX canvas */
        function prepareBlast(g: BlastGeo) {
            const { slide: slideR, sec: secR, stage: stR, padT, padB } = g;
            // Visible area in stage coordinates: slide edges sideways,
            // the section grown into the slide padding vertically
            clipL = slideR.left - stR.left;
            clipR = slideR.right - stR.left;
            clipT = secR.top - padT - stR.top;
            clipB = secR.bottom + padB - stR.top;
            root.style.setProperty('--tl-pad-t', padT + 'px');
            root.style.setProperty('--tl-pad-b', padB + 'px');

            // FX canvas covers that area; it sits in the section's padding box
            fxDpr = 1;   // trails and debris are soft and fast; 1x keeps fill cost low
            const cw = clipR - clipL;
            const ch = clipB - clipT;
            fxCanvas.width = Math.round(cw * fxDpr);
            fxCanvas.height = Math.round(ch * fxDpr);
            fxCanvas.style.width = cw + 'px';
            fxCanvas.style.height = ch + 'px';
            fxCanvas.style.transform = `translateX(${slideR.left - secR.left}px)`;
            fxCanvas.hidden = false;
            fxX = -clipL;
            fxY = -clipT;
            root.classList.add('is-blasting');
        }

        function startBlast() {
            if (!engine) return;

            // Burst from low in the tower, a little under its middle
            const blocks = st.filter((s) => s.body);
            let top = Infinity, bot = -Infinity, sumX = 0;
            for (const s of blocks) {
                top = Math.min(top, s.y);
                bot = Math.max(bot, s.y + s.h);
                sumX += s.x + s.w / 2;
            }
            const ox = sumX / blocks.length;
            const oy = bot - (bot - top) * 0.28;
            vpX = ox;
            vpY = stageH * 0.45;
            const u = clamp(stageH / 560, 0.7, 1.15);   // smaller stage, smaller blast

            // Depth roles: a couple fly past the viewer, some toward, the rest away
            const order = blocks.map((s) => s.i).sort(() => Math.random() - 0.5);
            const role = new Map<number, 'pass' | 'near' | 'far'>();
            order.forEach((i, n) => role.set(i, n < 2 ? 'pass' : n < 5 ? 'near' : 'far'));

            // Launch angles, evenly spread from left-ish to right-ish, shuffled
            const fan: number[] = [];
            const spread = blocks.map((_, n) => -Math.PI * (0.06 + 0.88 * n / Math.max(1, blocks.length - 1)))
                .sort(() => Math.random() - 0.5);
            blocks.forEach((s, n) => { fan[s.i] = spread[n]; });

            fly = [];
            for (const s of blocks) {
                const b = s.body!;
                const r = role.get(s.i)!;
                const f: Fly = {
                    s, z: 0, vz: 0, zk: Z_K, zb: Z_B,
                    air: true, airT: 0, fade: 1,
                    k: 1, px: 0, py: 0, trail: [], zi: -1, op: 1,
                    color: s.el.style.getPropertyValue('--block-color').trim() || '#fff',
                };
                if (r === 'pass') { f.vz = rand(15, 19); f.zk = 0; f.zb = 0; }
                else if (r === 'near') f.vz = rand(34, 52);
                else f.vz = -rand(70, 105);
                fly[s.i] = f;

                b.collisionFilter.category = CAT_AIR;
                b.collisionFilter.mask = CAT_FLOOR;
                // Fan out over the upper half-circle; blocks above the blast get pushed up harder
                const ang = fan[s.i] + rand(-0.12, 0.12);
                const lift = clamp((oy - (s.y + s.h / 2)) / stageH, 0, 0.6);
                const speed = (r === 'pass' ? rand(3, 6) : rand(8, 14) * (1 + lift * 0.5)) * u;
                Body.setVelocity(b, { x: Math.cos(ang) * speed, y: Math.sin(ang) * speed });
                Body.setAngularVelocity(b, (Math.random() < 0.5 ? -1 : 1) * rand(0.06, 0.22));
            }

            // Debris in the block colours
            const colors = fly.filter(Boolean).map((f) => f.color);
            bits = [];
            for (let n = 0; n < DEBRIS; n++) {
                const ang = rand(-Math.PI * 0.95, -Math.PI * 0.05) + (Math.random() < 0.2 ? Math.PI * 0.5 : 0);
                const sp = rand(3, 13) * u;
                const max = Math.round(rand(40, 80));
                bits.push({
                    x: ox + rand(-12, 12), y: oy + rand(-8, 8),
                    vx: Math.cos(ang) * sp, vy: Math.sin(ang) * sp,
                    a: rand(0, Math.PI), va: rand(-0.3, 0.3),
                    size: Math.random() < 0.15 ? rand(7, 11) : rand(2.5, 6),
                    life: max, max,
                    color: colors[n % colors.length],
                });
            }

            // Flash + shockwave ring: compositor-only animations
            for (const el of [flashEl, ringEl]) {
                el.style.left = ox + 'px';
                el.style.top = oy + 'px';
            }
            flashEl.animate([
                { opacity: 1, transform: 'scale(0.3)' },
                { opacity: 0, transform: `scale(${(1.7 * u).toFixed(2)})` },
            ], { duration: 280, easing: 'cubic-bezier(.1,.7,.3,1)' });
            ringEl.animate([
                { opacity: 0.9, transform: 'scale(0.2)', borderWidth: '3px' },
                { opacity: 0, transform: `scale(${(9 * u).toFixed(1)})`, borderWidth: '1px' },
            ], { duration: 600, easing: 'cubic-bezier(.15,.75,.3,1)' });

            root.dataset.blast = 'on';
            blastStep = 0;
        }

        /** Respawn above the stage and drift down, coming back in from slightly behind the screen */
        function rain(f: Fly) {
            const s = f.s, b = s.body!;
            const x = s.w / 2 + 4 + Math.random() * Math.max(0, stageW - s.w - 8);
            Body.setPosition(b, { x, y: Math.min(-s.h, clipT) - rand(10, 60) });
            Body.setVelocity(b, { x: (stageW / 2 - x) * 0.006, y: rand(1.5, 3) });
            Body.setAngle(b, rand(-0.5, 0.5));
            Body.setAngularVelocity(b, rand(-0.05, 0.05));
            f.z = -rand(60, 130); f.vz = 0;
            f.zk = RAIN_K; f.zb = RAIN_B;
            f.fade = 0; f.airT = 0; f.trail.length = 0;
        }

        /** Respawn just outside the side it left and drift back in on an arc */
        function reenter(f: Fly, fromLeft: boolean) {
            const s = f.s, b = s.body!;
            const rad = Math.hypot(s.w, s.h) / 2;
            const x = fromLeft ? Math.max(clipL, -300) - rad : Math.min(clipR, stageW + 300) + rad;
            const target = s.w / 2 + 6 + Math.random() * Math.max(0, stageW - s.w - 12);
            // Air drag shrinks reach: v0 ≈ d·drag / (1 − (1 − drag)^steps)
            const vx = (target - x) * AIR_DRAG / (1 - Math.pow(1 - AIR_DRAG, 70));
            Body.setPosition(b, { x, y: stageH * rand(0.05, 0.3) });
            Body.setVelocity(b, { x: vx, y: -rand(1, 3) });
            Body.setAngularVelocity(b, rand(-0.08, 0.08));
            f.z = -rand(40, 100); f.vz = 0;
            f.zk = RAIN_K; f.zb = RAIN_B;
            f.fade = 0; f.airT = 0; f.trail.length = 0;
        }

        function land(f: Fly) {
            const b = f.s.body!;
            f.air = false;
            f.s.el.classList.remove('is-flying');
            f.z = 0; f.vz = 0;
            b.collisionFilter.category = CAT_BLOCK;
            b.collisionFilter.mask = 0xFFFFFFFF;
        }

        /** Does this body sit inside a block that is already part of the pile? */
        function overlapsPile(b: Matter.Body): boolean {
            const pile: Matter.Body[] = [];
            for (const o of st) {
                if (o.body && o.body !== b && !fly[o.i]?.air) pile.push(o.body);
            }
            return Query.collides(b, pile).some((c) => c.depth > 1);
        }

        /** Depth, respawns and landing — runs before each engine step */
        function blastStepPhysics() {
            blastStep++;
            const late = blastStep > BLAST_MAX_STEPS;
            for (const f of fly) {
                if (!f || !f.air) continue;
                const s = f.s, b = s.body!;
                f.airT++;
                if (b.isSleeping) Sleeping.set(b, false);

                if (f.zk) f.vz += -f.zk * f.z - f.zb * f.vz;
                else f.vz *= 0.995;
                f.z = Math.min(f.z + f.vz, Z_PASS);
                if (f.fade < 1) f.fade = Math.min(1, f.fade + 0.08);

                const k = FOCAL / (FOCAL - f.z);
                const px = vpX + (b.position.x - vpX) * k;
                const py = vpY + (b.position.y - vpY) * k;
                const rad = 0.5 * Math.hypot(s.w, s.h) * k;

                if (f.z >= Z_PASS || py - rad > clipB || f.airT > 360) { rain(f); continue; }
                if (px + rad < clipL) { reenter(f, true); continue; }
                if (px - rad > clipR) { reenter(f, false); continue; }

                // Back on the screen plane: land once fully inside the stage
                if (late || (f.zk && Math.abs(f.z) < 6 && Math.abs(f.vz) < 1.5)) {
                    const { min, max } = b.bounds;
                    if (min.x >= 0 && max.x <= stageW && min.y >= 0 && max.y <= stageH + 1) {
                        // Landing inside a pile block would let the solver crush
                        // one of them into the floor or a wall for good: hop over
                        // the pile instead and land once clear of it.
                        if (late || !overlapsPile(b)) land(f);
                        else if (b.speed < 1.5) {
                            Body.setVelocity(b, { x: (stageW / 2 - b.position.x) * 0.02, y: -rand(7, 10) });
                        }
                    } else if (late) {
                        Body.setPosition(b, { x: stageW / 2, y: s.h });
                        Body.setAngle(b, 0);
                        land(f);
                    } else if (min.y >= 0 && b.speed < 1.5) {
                        // Resting on the floor overhang: shuffle inward
                        Body.setVelocity(b, { x: b.velocity.x + (b.position.x < stageW / 2 ? 0.5 : -0.5), y: b.velocity.y });
                    }
                }
            }

            for (let n = bits.length - 1; n >= 0; n--) {
                const p = bits[n];
                p.vy += 0.16;
                p.vx *= 0.975; p.vy *= 0.975;
                p.x += p.vx; p.y += p.vy;
                p.a += p.va;
                if (--p.life <= 0) bits.splice(n, 1);
            }
        }

        /** Project a flying block through the depth camera and write its transform */
        function place(f: Fly) {
            const s = f.s;
            const k = FOCAL / (FOCAL - f.z);
            const hw = s.w / 2, hh = s.h / 2;
            f.k = k;
            f.px = vpX + (s.x + hw - vpX) * k;
            f.py = vpY + (s.y + hh - vpY) * k;
            s.el.style.transform =
                `translate(${(f.px - hw).toFixed(1)}px, ${(f.py - hh).toFixed(1)}px) rotate(${s.r.toFixed(1)}deg) scale(${k.toFixed(3)})`;
        }

        /** Opacity, stacking, trails and the FX canvas — runs after each engine step */
        function blastFrame() {
            let busy = bits.length > 0;
            const record = blastStep % TRAIL_EVERY === 0;
            for (const f of fly) {
                if (!f) continue;
                const el = f.s.el;
                if (f.air) busy = true;

                // Far = dimmer (dark page, so lower opacity reads as dimmer);
                // flying past the camera fades out
                let op = f.k < 1 ? 0.45 + 0.55 * clamp((f.k - 0.5) * 2, 0, 1) : 1;
                if (f.z > Z_FADE) op *= 1 - (f.z - Z_FADE) / (Z_PASS - Z_FADE);
                op = f.air ? op * f.fade : 1;
                if (Math.abs(op - f.op) > 0.02 || (op === 1 && f.op !== 1)) {
                    f.op = op;
                    el.style.opacity = op.toFixed(2);
                }
                const zi = f.air ? 2 + clamp(Math.round((f.z + FOCAL) / 40), 0, 30) : 17;
                if (zi !== f.zi) { f.zi = zi; el.style.zIndex = String(zi); }

                if (record) {
                    const t = f.trail;
                    if (f.air && f.fade >= 1) {
                        t.push(f.px, f.py, f.s.r * Math.PI / 180, f.k, op);
                        if (t.length > TRAIL_LEN * 5) t.splice(0, 5);
                    } else if (t.length) {
                        t.splice(0, 5);
                    }
                }
                if (f.trail.length) busy = true;
            }
            drawFx();
            if (!busy) endBlast();
        }

        function drawFx() {
            if (!fxCtx) return;
            const ctx = fxCtx;
            ctx.setTransform(1, 0, 0, 1, 0, 0);
            ctx.clearRect(0, 0, fxCanvas.width, fxCanvas.height);
            const ox = fxX * fxDpr, oy = fxY * fxDpr;

            // Afterimages: oldest faintest, like the Solitaire win screen
            for (const f of fly) {
                if (!f || !f.trail.length) continue;
                const t = f.trail;
                const n = t.length / 5;
                const hw = f.s.w / 2, hh = f.s.h / 2;
                ctx.fillStyle = f.color;
                for (let j = 0; j < n - 1; j++) {
                    const o = j * 5;
                    const k = t[o + 3] * fxDpr;
                    const c = Math.cos(t[o + 2]) * k, sn = Math.sin(t[o + 2]) * k;
                    ctx.globalAlpha = t[o + 4] * 0.32 * (j + 1) / n;
                    ctx.setTransform(c, sn, -sn, c, ox + t[o] * fxDpr, oy + t[o + 1] * fxDpr);
                    ctx.fillRect(-hw, -hh, hw * 2, hh * 2);
                }
            }

            for (const p of bits) {
                const c = Math.cos(p.a) * fxDpr, sn = Math.sin(p.a) * fxDpr;
                ctx.globalAlpha = Math.min(1, (p.life / p.max) * 1.6);
                ctx.fillStyle = p.color;
                ctx.setTransform(c, sn, -sn, c, ox + p.x * fxDpr, oy + p.y * fxDpr);
                ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size);
            }
            ctx.globalAlpha = 1;
        }

        function endBlast() {
            blastStep = -1;
            for (const f of fly) {
                if (!f) continue;
                if (f.air && f.s.body) land(f);
                f.s.el.style.zIndex = '';
                f.s.el.style.opacity = '1';
            }
            fly = [];
            bits = [];
            fxCanvas.width = fxCanvas.height = 0;   // also frees the backing store
            fxCanvas.hidden = true;
            root.classList.remove('is-blasting');
            root.style.removeProperty('--tl-pad-t');
            root.style.removeProperty('--tl-pad-b');
            delete root.dataset.blast;
            // Sideways overflow is clipped, never scrollable — but make sure
            const slide = root.parentElement;
            if (slide && slide.scrollLeft) slide.scrollLeft = 0;
        }

        function stopSliderPropagation(e: Event) {
            // Only in knocked-down mode: the standing tower lets swipes through
            // so the slider still works when a phone screen is mostly tower.
            if (!freed) return;
            const onBlock = (e.target as HTMLElement)?.closest?.('.tower-block');
            const draggingBody = mConstraint && mConstraint.body;
            if (!onBlock && !draggingBody) return;
            e.stopPropagation();
        }

        function createWalls(w: number, h: number): Matter.Body[] {
            const floor = { isStatic: true, collisionFilter: { group: 0, category: CAT_FLOOR, mask: 0xFFFFFFFF } };
            const wall = { isStatic: true, collisionFilter: { group: 0, category: CAT_WALL, mask: 0xFFFFFFFF } };
            return [
                Bodies.rectangle(w / 2, h + WALL_THICKNESS / 2, w + WALL_THICKNESS * 2, WALL_THICKNESS, floor),       // floor
                Bodies.rectangle(w / 2, -WALL_THICKNESS / 2, w + WALL_THICKNESS * 2, WALL_THICKNESS, wall),            // ceiling
                Bodies.rectangle(-WALL_THICKNESS / 2, h / 2, WALL_THICKNESS, h + WALL_THICKNESS * 2, wall),            // left
                Bodies.rectangle(w + WALL_THICKNESS / 2, h / 2, WALL_THICKNESS, h + WALL_THICKNESS * 2, wall),         // right
            ];
        }

        function updateWalls() {
            if (!engine) return;
            const stageW = stage.offsetWidth;
            const stageH = stage.offsetHeight;
            Composite.remove(engine.world, walls);
            walls = createWalls(stageW, stageH);
            Composite.add(engine.world, walls);
        }

        function preventDefaultOnDrag(e: TouchEvent) {
            if (mConstraint && mConstraint.body) {
                e.preventDefault();
            }
        }

        /** Sync Matter.js body positions → DOM transforms each frame */
        function startSyncLoop() {
            if (!engine) return;

            function syncDOM() {
                if (!engine) return;
                const blasting = blastStep >= 0;
                if (blasting) blastStepPhysics();
                Engine.update(engine, 1000 / 60);

                let allSleeping = !blasting;
                for (const s of st) {
                    if (s.phase !== 'freed' || !s.body) continue;
                    if (s.body.isSleeping) continue; // skip DOM write for sleeping bodies
                    allSleeping = false;
                    s.x = s.body.position.x - s.w / 2;
                    s.y = s.body.position.y - s.h / 2;
                    s.r = s.body.angle * (180 / Math.PI);
                    if (blasting && fly[s.i]) place(fly[s.i]);
                    else tx(s);
                }
                if (blasting) blastFrame();

                if (allSleeping && !mConstraint?.body) {
                    animId = null;
                    return;
                }
                animId = requestAnimationFrame(syncDOM);
            }
            animId = requestAnimationFrame(syncDOM);
        }

        /** Resume the sync loop if it was paused due to all bodies sleeping */
        function ensureSyncRunning() {
            if (animId !== null || !engine) return;
            startSyncLoop();
        }

        // Prevent mouse/touch events from bubbling to keen-slider while the
        // tower is knocked down — otherwise block drags read as slide swipes.
        stage.addEventListener('mousedown', stopSliderPropagation);
        stage.addEventListener('mousemove', stopSliderPropagation);
        stage.addEventListener('mouseup', stopSliderPropagation);
        stage.addEventListener('touchstart', stopSliderPropagation);
        stage.addEventListener('touchmove', stopSliderPropagation);
        stage.addEventListener('touchend', stopSliderPropagation);

        if (reducedMotion) {
            showFinal(); return;
        }

        const rev = root.querySelector('[data-tl-body]') || stage;
        let resetTimer: ReturnType<typeof setTimeout> | null = null;

        const obs = new MutationObserver(() => {
            if (rev.classList.contains('visible')) {
                if (resetTimer) { clearTimeout(resetTimer); resetTimer = null; }
                if (!running && !st.some((s) => s.phase === 'done' || s.phase === 'freed')) run();
            } else {
                // Delay reset so transient class flickers (e.g. click) don't restart
                resetTimer = setTimeout(() => { reset(); st.length = 0; resetTimer = null; }, 200);
            }
        });
        obs.observe(rev, { attributes: true, attributeFilter: ['class'] });
        if (rev.classList.contains('visible')) run();
    })();
</script>
