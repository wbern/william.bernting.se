---
import { useTranslations } from "../i18n/utils";
import { defaultLang, type Lang } from "../i18n/ui";
import { STAT_LADDER } from "../utils/merge-game";

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);

// One entry per rung of the ladder. The chips below the reveal card are the
// single DOM source of truth for every stat string the script needs, and they
// double as the no-play summary (and the print fallback).
const stats = STAT_LADDER.map(({ tile, key }) => ({
    key,
    tile,
    tier: Math.round(Math.log2(tile / 3)),
    value: t(`stats.${key}.value` as never),
    label: t(`stats.${key}` as never),
    short: t(`stats.${key}.short` as never),
    prefix: t(`stats.${key}.prefix` as never),
    suffix: t(`stats.${key}.suffix` as never),
    kicker: t(`stats.${key}.kicker` as never),
    story: t(`stats.${key}.story` as never),
}));
---

<div class="section-inner numbers-section" data-numbers-section>
    <header class="numbers-head">
        <div class="section-label reveal">{t("stats.label")}</div>
        <h2 class="section-heading numbers-heading reveal reveal-delay-1">
            {t("stats.heading.before")}<span class="highlight numbers-heading-hl">{t("stats.heading.highlight")}</span>{t("stats.heading.after")}
        </h2>
        <p class="numbers-intro" id="numbers-intro">
            {t("stats.intro")} <span class="numbers-intro-skip">{t("stats.intro.skip")}</span>
        </p>
    </header>

    <div class="numbers-game reveal reveal-delay-2" data-numbers-game data-start-hint={t("numbers.hint.start")}>
        <div
            class="numbers-board"
            role="group"
            aria-label={t("numbers.aria.board")}
            data-board
        ></div>

        <div class="numbers-overlay" data-finish hidden>
            <div class="numbers-overlay-card">
                <div class="numbers-overlay-title">{t("numbers.finish.title")}</div>
                <p class="numbers-overlay-body">{t("numbers.finish.body")}</p>
                <div class="numbers-overlay-actions">
                    <button type="button" class="numbers-btn numbers-btn--primary" data-finish-cta>
                        {t("numbers.finish.cta")} <span class="numbers-btn-arrow" aria-hidden="true">↓</span>
                    </button>
                    <button type="button" class="numbers-btn" data-restart>{t("numbers.restart")}</button>
                </div>
            </div>
        </div>

        <div class="numbers-overlay numbers-overlay--soft" data-gameover hidden>
            <div class="numbers-overlay-card">
                <div class="numbers-overlay-title">{t("numbers.gameover")}</div>
                <div class="numbers-overlay-actions">
                    <button type="button" class="numbers-btn numbers-btn--primary" data-restart>{t("numbers.restart")}</button>
                </div>
            </div>
        </div>
    </div>

    <div class="numbers-reveal" data-reveal aria-live="polite">
        <div class="numbers-reveal-kicker">
            <span data-reveal-kicker>{t("numbers.reveal.idle.kicker")}</span>
            <span class="numbers-reveal-locked" data-reveal-locked hidden>{t("numbers.reveal.locked")}</span>
        </div>
        <div class="numbers-reveal-head" data-reveal-head hidden>
            <span class="numbers-reveal-value" data-reveal-value></span>
            <span class="numbers-reveal-label" data-reveal-label></span>
        </div>
        <p class="numbers-reveal-story" data-reveal-story>{t("numbers.reveal.idle.body")}</p>
    </div>

    <div class="numbers-summary">
        <div class="numbers-progress">
            <div class="numbers-progress-track" aria-hidden="true"><span data-progress-bar></span></div>
            <span class="numbers-progress-text">
                <strong data-progress-count>0</strong> {t("numbers.progress.of")} {stats.length} {t("numbers.progress")}
            </span>
        </div>
        <ul class="numbers-chips" data-fallback-stats aria-label={t("numbers.aria.chips")}>
            {stats.map((stat) => (
                <li>
                    <button
                        type="button"
                        class="numbers-chip stat"
                        data-stat-key={stat.key}
                        data-tile={stat.tile}
                        data-tier={stat.tier}
                        data-stat-short={stat.short}
                        data-stat-prefix={stat.prefix}
                        data-stat-suffix={stat.suffix}
                        data-stat-kicker={stat.kicker}
                        data-stat-story={stat.story}
                        data-stat-label={stat.label}
                        aria-pressed="false"
                    >
                        <span class="stat-number">{stat.value}</span>
                        <span class="stat-label">{stat.short}</span>
                    </button>
                </li>
            ))}
        </ul>
    </div>
</div>

<script>
    import {
        mergeTilesAt,
        spawnNext,
        spawnRandomMilestone,
        nextSpawnPlan,
        ensureMergeAvailable,
        isGameOver,
        getStatForTile,
        createEmptyBoard,
        seedBoard,
        findHintPair,
        MAX_STAT_TILE,
    } from "../utils/merge-game";
    import type { Board, Position, StatKey, SpawnMode } from "../utils/merge-game";

    const BOARD_SIZE = 4;
    const DRAG_THRESHOLD = 6;
    const TIMELINE_SLIDE = 3;

    type StatMeta = {
        value: string;
        label: string;
        short: string;
        prefix: string;
        suffix: string;
        kicker: string;
        story: string;
        tier: string;
        chip: HTMLButtonElement;
    };

    const reducedMotion = () => window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    function tierFor(value: number): number {
        return Math.min(12, Math.max(0, Math.round(Math.log2(value / 3))));
    }

    function readStats(section: HTMLElement): Partial<Record<StatKey, StatMeta>> {
        const result: Partial<Record<StatKey, StatMeta>> = {};
        section.querySelectorAll<HTMLButtonElement>("[data-fallback-stats] .stat").forEach((el) => {
            const key = el.dataset.statKey as StatKey | undefined;
            if (!key) return;
            result[key] = {
                value: el.querySelector(".stat-number")?.textContent?.trim() ?? "",
                label: el.dataset.statLabel ?? "",
                short: el.dataset.statShort ?? "",
                prefix: el.dataset.statPrefix ?? "",
                suffix: el.dataset.statSuffix ?? "",
                kicker: el.dataset.statKicker ?? "",
                story: el.dataset.statStory ?? "",
                tier: el.dataset.tier ?? "0",
                chip: el,
            };
        });
        return result;
    }

    function initGame(root: HTMLElement) {
        const section = root.closest<HTMLElement>("[data-numbers-section]");
        const boardEl = root.querySelector<HTMLElement>("[data-board]");
        const finishEl = root.querySelector<HTMLElement>("[data-finish]");
        const gameoverEl = root.querySelector<HTMLElement>("[data-gameover]");
        if (!section || !boardEl || !finishEl || !gameoverEl) return;

        const revealEl = section.querySelector<HTMLElement>("[data-reveal]")!;
        const revealKicker = section.querySelector<HTMLElement>("[data-reveal-kicker]")!;
        const revealLocked = section.querySelector<HTMLElement>("[data-reveal-locked]")!;
        const revealHead = section.querySelector<HTMLElement>("[data-reveal-head]")!;
        const revealValue = section.querySelector<HTMLElement>("[data-reveal-value]")!;
        const revealLabel = section.querySelector<HTMLElement>("[data-reveal-label]")!;
        const revealStory = section.querySelector<HTMLElement>("[data-reveal-story]")!;
        const progressCount = section.querySelector<HTMLElement>("[data-progress-count]")!;
        const progressBar = section.querySelector<HTMLElement>("[data-progress-bar]")!;
        const idle = { kicker: revealKicker.textContent ?? "", story: revealStory.textContent ?? "" };
        const hintText = root.dataset.startHint ?? "";

        const stats = readStats(section);
        const statCount = Object.keys(stats).length;

        let board: Board = createEmptyBoard(BOARD_SIZE);
        let renderedBoard: Board = createEmptyBoard(BOARD_SIZE);
        let spawnMode: SpawnMode = "active";
        let unlocked = new Set<StatKey>();
        let hasMerged = false;
        let finished = false;

        const cellEls: HTMLElement[][] = [];

        function buildGrid() {
            boardEl!.innerHTML = "";
            cellEls.length = 0;
            for (let r = 0; r < BOARD_SIZE; r++) {
                cellEls.push([]);
                for (let c = 0; c < BOARD_SIZE; c++) {
                    const cell = document.createElement("div");
                    cell.className = "numbers-cell";
                    cell.dataset.row = String(r);
                    cell.dataset.col = String(c);
                    boardEl!.appendChild(cell);
                    cellEls[r].push(cell);
                }
            }
        }

        function renderTile(value: number): HTMLElement {
            const tile = document.createElement("div");
            tile.className = "numbers-tile";
            tile.dataset.value = String(value);
            tile.dataset.tier = String(tierFor(value));
            tile.tabIndex = 0;
            tile.setAttribute("role", "button");
            const stat = getStatForTile(value);
            const meta = stat ? stats[stat] : undefined;
            if (stat && meta) {
                tile.dataset.stat = stat;
                tile.dataset.milestone = "true";
                if (value === MAX_STAT_TILE) tile.dataset.top = "true";
                tile.setAttribute("aria-label", [meta.prefix, meta.value, meta.suffix].filter(Boolean).join(" "));

                if (meta.prefix) {
                    const prefixEl = document.createElement("span");
                    prefixEl.className = "numbers-tile-prefix";
                    prefixEl.textContent = meta.prefix;
                    tile.append(prefixEl);
                }

                const valueEl = document.createElement("span");
                valueEl.className = "numbers-tile-value";
                valueEl.textContent = meta.value;
                tile.append(valueEl);

                if (meta.suffix) {
                    const suffixEl = document.createElement("span");
                    suffixEl.className = "numbers-tile-stat";
                    suffixEl.textContent = meta.suffix;
                    tile.append(suffixEl);
                }
            } else {
                tile.textContent = String(value);
                tile.setAttribute("aria-label", String(value));
            }
            return tile;
        }

        // Shrink any line that still overflows its tile (long numbers, long
        // single words) instead of clipping it with an ellipsis.
        function fitTile(tile: HTMLElement) {
            const parts = tile.querySelectorAll<HTMLElement>(
                ".numbers-tile-value, .numbers-tile-prefix, .numbers-tile-stat"
            );
            parts.forEach((el) => {
                el.style.fontSize = "";
                const available = el.clientWidth;
                if (available <= 0 || el.scrollWidth <= available) return;
                const current = parseFloat(getComputedStyle(el).fontSize);
                if (!Number.isFinite(current) || current <= 0) return;
                const ratio = available / el.scrollWidth;
                el.style.fontSize = Math.max(7.5, current * ratio * 0.97) + "px";
            });
        }

        let pendingFit = 0;
        function scheduleFit() {
            if (pendingFit) cancelAnimationFrame(pendingFit);
            pendingFit = requestAnimationFrame(() => {
                pendingFit = 0;
                boardEl!.querySelectorAll<HTMLElement>(".numbers-tile").forEach(fitTile);
                placeHint();
            });
        }

        function render() {
            for (let r = 0; r < BOARD_SIZE; r++) {
                for (let c = 0; c < BOARD_SIZE; c++) {
                    const value = board[r][c];
                    if (renderedBoard[r][c] === value) continue;
                    const cell = cellEls[r][c];
                    const hadFocus = cell.contains(document.activeElement);
                    cell.innerHTML = "";
                    if (value !== 0) {
                        const tile = renderTile(value);
                        cell.appendChild(tile);
                        if (hadFocus) tile.focus({ preventScroll: true });
                    }
                    renderedBoard[r][c] = value;
                }
            }
            scheduleFit();
        }

        // ---- Reveal card, chips, progress -------------------------------

        function setActiveChip(key: StatKey | null) {
            for (const [k, meta] of Object.entries(stats)) {
                meta!.chip.setAttribute("aria-pressed", String(k === key));
            }
        }

        function showStat(key: StatKey, fresh: boolean) {
            const meta = stats[key];
            if (!meta) return;
            revealEl.dataset.tier = meta.tier;
            revealEl.dataset.stat = key;
            revealKicker.textContent = meta.kicker;
            revealLocked.hidden = unlocked.has(key);
            revealHead.hidden = false;
            revealValue.textContent = meta.value;
            revealLabel.textContent = meta.label;
            revealStory.textContent = meta.story;
            setActiveChip(key);
            revealEl.classList.remove("is-fresh");
            if (fresh && !reducedMotion()) {
                void revealEl.offsetWidth;
                revealEl.classList.add("is-fresh");
            }
        }

        function showIdle() {
            delete revealEl.dataset.tier;
            delete revealEl.dataset.stat;
            revealKicker.textContent = idle.kicker;
            revealLocked.hidden = true;
            revealHead.hidden = true;
            revealStory.textContent = idle.story;
            revealEl.classList.remove("is-fresh");
            setActiveChip(null);
        }

        function updateProgress() {
            progressCount.textContent = String(unlocked.size);
            progressBar.style.setProperty("--p", String(statCount ? unlocked.size / statCount : 0));
            for (const [k, meta] of Object.entries(stats)) {
                meta!.chip.dataset.unlocked = String(unlocked.has(k as StatKey));
            }
        }

        function unlock(key: StatKey) {
            if (unlocked.has(key)) return false;
            unlocked.add(key);
            updateProgress();
            const chip = stats[key]?.chip;
            if (chip && !reducedMotion()) {
                chip.classList.remove("just-unlocked");
                void chip.offsetWidth;
                chip.classList.add("just-unlocked");
            }
            return true;
        }

        section.querySelectorAll<HTMLButtonElement>("[data-fallback-stats] .stat").forEach((chip) => {
            chip.addEventListener("click", () => {
                const key = chip.dataset.statKey as StatKey;
                if (chip.getAttribute("aria-pressed") === "true") showIdle();
                else showStat(key, false);
            });
        });

        // ---- Onboarding ghost drag --------------------------------------

        let ghost: HTMLElement | null = null;

        function removeHint() {
            ghost?.remove();
            ghost = null;
        }

        function placeHint() {
            if (hasMerged || finished) {
                removeHint();
                return;
            }
            const pair = findHintPair(board);
            if (!pair) {
                removeHint();
                return;
            }
            const from = cellEls[pair.from.row][pair.from.col];
            const to = cellEls[pair.to.row][pair.to.col];
            // The slide may not be laid out yet (hidden by the slider).
            if (from.offsetWidth === 0) return;
            if (!ghost) {
                ghost = document.createElement("div");
                ghost.className = "numbers-ghost";
                ghost.setAttribute("aria-hidden", "true");
                ghost.innerHTML =
                    '<span class="numbers-ghost-dot"></span><span class="numbers-ghost-label"></span>';
                ghost.querySelector(".numbers-ghost-label")!.textContent = hintText;
                boardEl!.appendChild(ghost);
            }
            const coords = [
                from.offsetLeft + from.offsetWidth / 2,
                from.offsetTop + from.offsetHeight / 2,
                to.offsetLeft + to.offsetWidth / 2,
                to.offsetTop + to.offsetHeight / 2,
            ].map((n) => `${n}px`);
            const key = coords.join(",");
            if (ghost.dataset.coords === key) return;
            ghost.dataset.coords = key;
            ["--x0", "--y0", "--x1", "--y1"].forEach((name, i) => ghost!.style.setProperty(name, coords[i]));
            // Keep the label inside the board: put it left of the finger on the right half.
            const rightHalf = Math.max(from.offsetLeft, to.offsetLeft) > boardEl!.clientWidth / 2;
            ghost.toggleAttribute("data-flip", rightHalf);
            // Keyframes resolve the custom properties when the animation
            // starts, so restart it to pick up the new path.
            ghost.style.animation = "none";
            void ghost.offsetWidth;
            ghost.style.animation = "";
        }

        // ---- Game flow --------------------------------------------------

        function hideOverlays() {
            finishEl!.hidden = true;
            gameoverEl!.hidden = true;
            root.classList.remove("is-finished", "is-over");
        }

        function showGameOver() {
            gameoverEl!.hidden = false;
            root.classList.add("is-over");
        }

        function start() {
            board = ensureMergeAvailable(seedBoard());
            spawnMode = "active";
            unlocked = new Set();
            finished = false;
            hideOverlays();
            updateProgress();
            showIdle();
            render();
        }

        function finish(at: Position) {
            finished = true;
            removeHint();
            celebrate(at);
            const delay = reducedMotion() ? 0 : 900;
            window.setTimeout(() => {
                if (!finished) return;
                finishEl!.hidden = false;
                root.classList.add("is-finished");
                finishEl!.querySelector<HTMLElement>("[data-finish-cta]")?.focus({ preventScroll: true });
            }, delay);
        }

        function attemptMerge(from: Position, to: Position) {
            if (finished) return false;
            const result = mergeTilesAt(board, from, to);
            if (!result.merged) return false;
            hasMerged = true;
            let next = result.board;
            if (!result.won) {
                const plan = nextSpawnPlan(next, spawnMode);
                spawnMode = plan.mode;
                for (let i = 0; i < plan.count; i++) {
                    next = i === 0 ? spawnNext(next) : spawnRandomMilestone(next);
                }
                next = ensureMergeAvailable(next);
            }
            board = next;
            render();

            const stat = getStatForTile(result.value);
            if (stat && unlock(stat)) showStat(stat, true);
            if (result.exploded) playBurst(to, "numbers-explosion");
            if (result.won) {
                finish(to);
            } else if (isGameOver(board)) {
                showGameOver();
            }
            return true;
        }

        function playBurst(at: Position, className: string) {
            const cell = cellEls[at.row]?.[at.col];
            if (!cell || reducedMotion()) return;
            const burst = document.createElement("div");
            burst.className = className;
            cell.appendChild(burst);
            burst.addEventListener("animationend", () => burst.remove(), { once: true });
        }

        function celebrate(at: Position) {
            playBurst(at, "numbers-explosion");
            if (reducedMotion()) return;
            boardEl!.classList.remove("is-celebrating");
            void boardEl!.offsetWidth;
            boardEl!.classList.add("is-celebrating");
            window.setTimeout(() => boardEl!.classList.remove("is-celebrating"), 1400);
        }

        root.querySelectorAll<HTMLButtonElement>("[data-restart]").forEach((btn) =>
            btn.addEventListener("click", () => start()),
        );
        finishEl.querySelector<HTMLButtonElement>("[data-finish-cta]")?.addEventListener("click", () => {
            document.dispatchEvent(new CustomEvent("slider-goto", { detail: { index: TIMELINE_SLIDE } }));
        });

        // ---- Pointer drag -----------------------------------------------

        function positionFromCell(cell: HTMLElement | null): Position | null {
            if (!cell) return null;
            const r = Number(cell.dataset.row);
            const c = Number(cell.dataset.col);
            if (Number.isNaN(r) || Number.isNaN(c)) return null;
            return { row: r, col: c };
        }

        function cellAtPoint(x: number, y: number): HTMLElement | null {
            const el = document.elementFromPoint(x, y) as HTMLElement | null;
            return el?.closest<HTMLElement>(".numbers-cell") ?? null;
        }

        function clearDropHighlights() {
            boardEl!.querySelectorAll<HTMLElement>(".numbers-cell").forEach((c) => {
                c.classList.remove("drop-valid", "drop-hover", "is-selected");
            });
        }

        function markValidDropTargets(from: Position) {
            const value = board[from.row][from.col];
            for (let r = 0; r < BOARD_SIZE; r++) {
                for (let c = 0; c < BOARD_SIZE; c++) {
                    if (r === from.row && c === from.col) continue;
                    if (board[r][c] !== value) continue;
                    cellEls[r][c].classList.add("drop-valid");
                }
            }
        }

        type DragState = {
            pointerId: number;
            origin: Position;
            startX: number;
            startY: number;
            tileEl: HTMLElement;
            activated: boolean;
        };
        let drag: DragState | null = null;

        boardEl.addEventListener("pointerdown", (e) => {
            const tileEl = (e.target as HTMLElement).closest<HTMLElement>(".numbers-tile");
            if (!tileEl || finished) return;
            const cell = tileEl.parentElement as HTMLElement | null;
            const origin = positionFromCell(cell);
            if (!origin) return;
            e.stopPropagation();
            cancelSelection();
            drag = {
                pointerId: e.pointerId,
                origin,
                startX: e.clientX,
                startY: e.clientY,
                tileEl,
                activated: false,
            };
        });

        // Keen-slider listens on `mousedown`/`touchstart` (not pointer events),
        // so pointerdown's stopPropagation doesn't block it. Stop the matching
        // native events on a tile before they bubble to the slider container.
        // touchmove during an active drag also needs preventDefault to keep
        // the browser from scrolling the page.
        boardEl.addEventListener("mousedown", (e) => {
            if ((e.target as HTMLElement).closest(".numbers-tile")) {
                e.stopPropagation();
            }
        });
        boardEl.addEventListener("touchstart", (e) => {
            if ((e.target as HTMLElement).closest(".numbers-tile")) {
                e.stopPropagation();
                if (e.cancelable) e.preventDefault();
            }
        }, { passive: false });
        boardEl.addEventListener("touchmove", (e) => {
            if (drag) {
                e.stopPropagation();
                if (e.cancelable) e.preventDefault();
            }
        }, { passive: false });
        boardEl.addEventListener("touchend", (e) => e.stopPropagation(), { passive: true });

        window.addEventListener("pointermove", (e) => {
            if (!drag || e.pointerId !== drag.pointerId) return;
            const dx = e.clientX - drag.startX;
            const dy = e.clientY - drag.startY;
            if (!drag.activated) {
                if (Math.hypot(dx, dy) < DRAG_THRESHOLD) return;
                drag.activated = true;
                drag.tileEl.classList.add("dragging");
                root.classList.add("is-dragging");
                markValidDropTargets(drag.origin);
                boardEl!.setPointerCapture?.(e.pointerId);
            }
            drag.tileEl.style.transform = `translate(${dx}px, ${dy}px)`;
            const hoverCell = cellAtPoint(e.clientX, e.clientY);
            boardEl!.querySelectorAll<HTMLElement>(".numbers-cell.drop-hover").forEach((c) => {
                c.classList.remove("drop-hover");
            });
            if (hoverCell?.classList.contains("drop-valid")) {
                hoverCell.classList.add("drop-hover");
            }
            e.preventDefault();
        }, { passive: false });

        function endDrag(e: PointerEvent, attempted: boolean) {
            if (!drag || e.pointerId !== drag.pointerId) return;
            const current = drag;
            drag = null;
            let target: Position | null = null;
            if (attempted && current.activated) {
                target = positionFromCell(cellAtPoint(e.clientX, e.clientY));
            }
            current.tileEl.classList.remove("dragging");
            current.tileEl.style.transform = "";
            root.classList.remove("is-dragging");
            clearDropHighlights();
            if (target) attemptMerge(current.origin, target);
        }

        window.addEventListener("pointerup", (e) => endDrag(e, true));
        window.addEventListener("pointercancel", (e) => endDrag(e, false));

        // ---- Keyboard: Enter picks a tile, arrows move, Enter merges ----

        let selected: Position | null = null;

        function cancelSelection() {
            if (!selected) return;
            selected = null;
            clearDropHighlights();
        }

        function focusTileAt(pos: Position) {
            cellEls[pos.row]?.[pos.col]?.querySelector<HTMLElement>(".numbers-tile")?.focus();
        }

        function moveFocus(from: Position, dr: number, dc: number) {
            // Walk in the pressed direction and land on the next tile.
            let r = from.row + dr;
            let c = from.col + dc;
            while (r >= 0 && r < BOARD_SIZE && c >= 0 && c < BOARD_SIZE) {
                if (board[r][c] !== 0) {
                    focusTileAt({ row: r, col: c });
                    return;
                }
                r += dr;
                c += dc;
            }
        }

        boardEl.addEventListener("keydown", (e) => {
            const tileEl = (e.target as HTMLElement).closest<HTMLElement>(".numbers-tile");
            if (!tileEl || finished) return;
            const pos = positionFromCell(tileEl.parentElement as HTMLElement);
            if (!pos) return;
            const dirs: Record<string, [number, number]> = {
                ArrowUp: [-1, 0],
                ArrowDown: [1, 0],
                ArrowLeft: [0, -1],
                ArrowRight: [0, 1],
            };
            if (e.key in dirs) {
                // Keep arrows inside the board instead of changing slide.
                e.preventDefault();
                e.stopPropagation();
                const [dr, dc] = dirs[e.key];
                moveFocus(pos, dr, dc);
            } else if (e.key === "Enter" || e.key === " ") {
                e.preventDefault();
                e.stopPropagation();
                if (!selected) {
                    selected = pos;
                    cellEls[pos.row][pos.col].classList.add("is-selected");
                    markValidDropTargets(pos);
                } else if (selected.row === pos.row && selected.col === pos.col) {
                    cancelSelection();
                } else {
                    const from = selected;
                    cancelSelection();
                    if (attemptMerge(from, pos)) focusTileAt(pos);
                }
            } else if (e.key === "Escape" && selected) {
                e.stopPropagation();
                cancelSelection();
            }
        });

        buildGrid();
        start();

        // The slide is laid out lazily by the slider; re-measure when it shows.
        document.addEventListener("slide-changed", () => scheduleFit());

        if (typeof ResizeObserver !== "undefined") {
            const ro = new ResizeObserver(() => scheduleFit());
            ro.observe(boardEl);
        } else {
            window.addEventListener("resize", scheduleFit);
        }

        (window as unknown as { __numbersGame?: unknown }).__numbersGame = {
            setBoard(next: Board) {
                board = next.map((row) => [...row]);
                finished = false;
                hideOverlays();
                if (isGameOver(board)) showGameOver();
                render();
            },
            getBoard: () => board.map((row) => [...row]),
            getUnlocked: () => [...unlocked],
            attemptMerge,
        };
    }

    function initAll() {
        document.querySelectorAll<HTMLElement>("[data-numbers-game]").forEach(initGame);
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initAll);
    } else {
        initAll();
    }
</script>

