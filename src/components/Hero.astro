---
import { useTranslations } from "../i18n/utils";
import { defaultLang, type Lang } from "../i18n/ui";
import { getTraitRows } from "../i18n/traits";
import { CONTACT, trackEntries, type TrackId } from "../i18n/contact";
import MarqueeField from "./MarqueeField.astro";
import Masks from "./Masks.astro";

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);
const rows = getTraitRows(lang);

const topRows = rows.slice(0, 1);
const bottomRows = rows.slice(1);

const greeting = t("hero.greeting");
const greetingLen = greeting.length;

const trackColor = (id: TrackId) => trackEntries.find((e) => e.id === id)!.color;
const verbs: { id: TrackId; text: string }[] = [
    { id: "teach", text: t("hero.tagline.teach") },
    { id: "legacy", text: t("hero.tagline.legacy") },
    { id: "build", text: t("hero.tagline.build") },
];
const glue = [t("hero.tagline.sep1"), t("hero.tagline.sep2"), t("hero.tagline.end")];
const kendevHost = new URL(CONTACT.kendev).hostname.replace(/^www\./, "");
---

<div class="hero-slide" data-hero>
    <!-- The three masks ride along in the marquee rows (one per row); Masks.astro owns the sprite + interaction -->
    <Masks />
    <div class="hero-marquee-wrap hero-marquee-top" data-marquee-wrap="top">
        <MarqueeField rows={topRows} masks={["past"]} />
    </div>

    <div class="hero-center">
        <!-- Mask drop zone: the greeting is the target; the outline and the worn mask only show up when a mask is in play -->
        <div class="hero-face" data-mask-zone>
            <div
                class="hero-greeting"
                style={`--greeting-width: ${greetingLen}ch; --greeting-steps: ${greetingLen};`}
            >{greeting}</div>
            <svg class="hero-face-outline" viewBox="0 0 80 100" aria-hidden="true">
                <path d="M16 14 Q40 3 64 14 Q75 48 64 82 Q56 97 40 97 Q24 97 16 82 Q5 48 16 14Z" />
                <path d="M22 44 Q30 38 36 44 M44 44 Q50 38 58 44" />
                <path d="M30 70 Q40 76 50 70" />
            </svg>
            <span class="hero-face-hint" aria-hidden="true">{t("mask.dropHint")}</span>
            <button type="button" class="hero-mask-worn" data-mask-worn data-keen-slider-clickable hidden aria-label={t("mask.takeOff")}>
                <svg class="mask-art" aria-hidden="true"><use data-mask-use href="#mask-past" /></svg>
                <span class="hero-mask-off">{t("mask.takeOff")}</span>
            </button>
        </div>
        <h1>William Bernting</h1>

        <p class="hero-tagline">
            {t("hero.tagline.lead")}{verbs.map((verb, i) => (
                <>
                    <a
                        href="#finale"
                        class="hero-verb"
                        data-track={verb.id}
                        style={`--track: ${trackColor(verb.id)};`}
                        aria-describedby="hero-verb-jump"
                    >{verb.text}<span class="hero-verb-arrow" aria-hidden="true">&#8599;</span></a>{glue[i]}
                </>
            ))}
        </p>
        <span id="hero-verb-jump" class="sr-only">{t("hero.tagline.jump")}</span>

        <ul class="hero-proof">
            <li>{t("hero.proof.years")}</li>
            <li>{t("hero.proof.users")}</li>
            <li>{t("hero.proof.agency")}</li>
        </ul>

        <div class="hero-contact">
            <a class="hero-email" href={`mailto:${CONTACT.email}`} aria-label={`${t("hero.email")}: ${CONTACT.email}`}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm1 2.4V17h16V7.4l-8 5.6-8-5.6zM5.6 7l6.4 4.5L18.4 7H5.6z"/></svg>
                <span>{CONTACT.email}</span>
            </a>
            <div class="hero-contact-secondary">
                <a href={CONTACT.phoneHref} aria-label={`${t("hero.phone")}: ${CONTACT.phoneDisplay}`}>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1L6.6 10.8z"/></svg>
                    <span>{CONTACT.phoneDisplay}</span>
                </a>
                <a href={CONTACT.linkedin} target="_blank" rel="noopener noreferrer">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                    <span>LinkedIn</span>
                    <span class="sr-only">{t("contact.newTab")}</span>
                </a>
                <a href={CONTACT.kendev} target="_blank" rel="noopener noreferrer">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm6.9 6h-2.95a15.7 15.7 0 0 0-1.38-3.56A8 8 0 0 1 18.9 8zM12 4.04c.83 1.2 1.48 2.53 1.91 3.96h-3.82c.43-1.43 1.08-2.76 1.91-3.96zM4.26 14a8.2 8.2 0 0 1 0-4h3.38a16.5 16.5 0 0 0 0 4H4.26zm.82 2h2.95c.32 1.25.78 2.45 1.38 3.56A8 8 0 0 1 5.08 16zm2.95-8H5.08a8 8 0 0 1 4.33-3.56A15.7 15.7 0 0 0 8.03 8zM12 19.96c-.83-1.2-1.48-2.53-1.91-3.96h3.82c-.43 1.43-1.08 2.76-1.91 3.96zM14.34 14H9.66a14.7 14.7 0 0 1 0-4h4.68a14.7 14.7 0 0 1 0 4zm.25 5.56c.6-1.11 1.06-2.31 1.38-3.56h2.95a8 8 0 0 1-4.33 3.56zM16.36 14a16.5 16.5 0 0 0 0-4h3.38a8.2 8.2 0 0 1 0 4h-3.38z"/></svg>
                    <span>{kendevHost}</span>
                    <span class="sr-only">{t("contact.newTab")}</span>
                </a>
            </div>
        </div>

        <!-- Keyboard / assistive path to the masks (the marquee copies are decorative and aria-hidden) -->
        <div class="mask-keys" data-mask-keys role="group" aria-label={t("mask.tray")}>
            {(["past", "present", "future"] as const).map((id) => (
                <button type="button" data-mask-key={id} aria-pressed="false" aria-label={t("mask.wear").replace("{name}", t(`mask.${id}`))}>
                    <svg class="mask-art" aria-hidden="true"><use href={`#mask-${id}`} /></svg>
                    <span>{t(`mask.${id}`)}</span>
                </button>
            ))}
        </div>
    </div>

    <div class="hero-marquee-wrap hero-marquee-bottom" data-marquee-wrap="bottom">
        <MarqueeField rows={bottomRows} masks={["present", "future"]} />
    </div>

    <button type="button" class="hero-scroll-hint" data-hero-next>
        <span>{t("hero.scroll")}</span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16.5 5.5 10l1.4-1.4 5.1 5.1 5.1-5.1 1.4 1.4z"/></svg>
    </button>

    <!-- Caption bubble for hovered/tapped marquee words (positioned by script) -->
    <div class="hero-trait-tip" data-trait-tip aria-hidden="true">
        <span class="hero-trait-tip-track">{t("hero.traits.tip")}</span>
        <span class="hero-trait-tip-text" data-tip-text></span>
    </div>

    <div class="hero-contact-print" style="display: none;">
        <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
        <span>{CONTACT.phoneDisplay}</span>
        <a href={CONTACT.linkedin}>LinkedIn</a>
        <a href={CONTACT.kendev}>{kendevHost}</a>
        <span>{t("contact.location")}</span>
    </div>

    <div class="sr-only traits-keywords">
        <span>{t("hero.traits.label")}:</span>
        <ul>
            {rows.flatMap((row) => row.items).map((item) => (
                <li>{item.label}: {item.caption}</li>
            ))}
        </ul>
    </div>
</div>

<script>
    function initHero() {
        const hero = document.querySelector<HTMLElement>("[data-hero]");
        if (!hero) return;

        // --- Tagline verbs: jump to the finale with that track pre-picked ---
        hero.querySelectorAll<HTMLAnchorElement>(".hero-verb").forEach((btn) => {
            btn.addEventListener("click", (e) => {
                e.preventDefault();
                const slides = document.querySelectorAll("#slider > .keen-slider__slide");
                document.dispatchEvent(new CustomEvent("finale-pick-track", { detail: { track: btn.dataset.track } }));
                document.dispatchEvent(new CustomEvent("slider-goto", { detail: { index: slides.length - 1 } }));
            });
        });

        hero.querySelector<HTMLButtonElement>("[data-hero-next]")?.addEventListener("click", () => {
            document.dispatchEvent(new CustomEvent("slider-goto", { detail: { index: 1 } }));
        });

        // --- Marquee: hover (mouse) or tap (touch) a word to freeze its row and read the payoff ---
        const tip = hero.querySelector<HTMLElement>("[data-trait-tip]");
        const tipText = hero.querySelector<HTMLElement>("[data-tip-text]");
        if (!tip || !tipText) return;

        let active: HTMLElement | null = null;
        let pinned = false;
        let hideTimer: ReturnType<typeof setTimeout> | null = null;

        function show(item: HTMLElement) {
            if (hideTimer) { clearTimeout(hideTimer); hideTimer = null; }
            if (active && active !== item) release();
            const row = item.closest<HTMLElement>(".marquee-row");
            const wrap = item.closest<HTMLElement>("[data-marquee-wrap]");
            if (!row || !wrap) return;
            active = item;
            row.classList.add("is-paused");
            item.classList.add("is-active");

            tipText!.textContent = item.dataset.caption ?? "";
            tip!.style.setProperty("--tip-color", row.style.getPropertyValue("--row-color"));
            tip!.classList.add("is-visible");

            // Position relative to the hero; below words in the top field, above words in the bottom field.
            const heroRect = hero!.getBoundingClientRect();
            const r = item.getBoundingClientRect();
            const tipRect = tip!.getBoundingClientRect();
            const margin = 12;
            let left = r.left + r.width / 2 - heroRect.left - tipRect.width / 2;
            left = Math.max(margin, Math.min(left, heroRect.width - tipRect.width - margin));
            const below = wrap.dataset.marqueeWrap === "top";
            const top = below
                ? r.bottom - heroRect.top + 10
                : r.top - heroRect.top - tipRect.height - 10;
            tip!.style.left = `${left}px`;
            tip!.style.top = `${top}px`;
            tip!.dataset.side = below ? "below" : "above";
        }

        function release() {
            if (!active) return;
            active.classList.remove("is-active");
            active.closest(".marquee-row")?.classList.remove("is-paused");
            active = null;
        }

        function hide() {
            release();
            pinned = false;
            tip!.classList.remove("is-visible");
        }

        hero.querySelectorAll<HTMLElement>(".marquee-item").forEach((item) => {
            item.addEventListener("pointerenter", (e) => {
                if (e.pointerType !== "mouse" || pinned) return;
                show(item);
            });
            item.addEventListener("pointerleave", (e) => {
                if (e.pointerType !== "mouse" || pinned) return;
                hideTimer = setTimeout(hide, 120);
            });
            item.addEventListener("click", (e) => {
                e.stopPropagation();
                if (pinned && active === item) { hide(); return; }
                pinned = true;
                show(item);
            });
        });

        document.addEventListener("click", () => { if (pinned) hide(); });
        document.addEventListener("slide-changed", () => hide());
        window.addEventListener("resize", () => hide());
    }

    initHero();
</script>

<style>
    .hero-slide {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        height: 100%;
        width: 100%;
        position: relative;
    }

    .hero-marquee-wrap {
        flex: 1 1 0;
        min-height: 0;
        display: flex;
        align-items: center;
        width: 100vw;
    }

    .hero-center {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 20px 0;
        flex-shrink: 0;
        max-width: 100%;
    }

    /* ---------- greeting: typewriter runs alongside the name, not before it ---------- */
    .hero-greeting {
        font-family: var(--mono);
        font-size: 18px;
        color: var(--text-dim);
        margin-bottom: 16px;
        overflow: hidden;
        white-space: nowrap;
        border-right: 2px solid transparent;
        width: var(--greeting-width);
        animation:
            typewriter 0.5s steps(var(--greeting-steps)) 0.1s backwards,
            blink 0.7s step-end 0.1s 3;
    }

    @keyframes typewriter {
        from { width: 0; color: var(--text); }
        to { width: var(--greeting-width); color: var(--text); }
    }

    @keyframes blink {
        0%, 100% { border-color: var(--text); }
        50% { border-color: transparent; }
    }

    h1 {
        font-size: clamp(44px, 8vw, 96px);
        font-weight: 900;
        letter-spacing: -2px;
        line-height: 1;
        animation: fadeUp 0.6s ease 0.05s both;
    }

    /* ---------- tagline: the thesis the other slides prove ---------- */
    .hero-tagline {
        max-width: 27em;
        margin-top: clamp(14px, 2.4vh, 24px);
        font-size: clamp(19px, 2.1vw, 28px);
        font-weight: 500;
        line-height: 1.4;
        color: var(--text);
        text-wrap: balance;
        animation: fadeUp 0.6s ease 0.15s both;
    }

    .hero-verb {
        --verb-ink: var(--track);
        font-weight: 700;
        color: var(--verb-ink);
        position: relative;
        text-decoration: underline dotted color-mix(in srgb, var(--track) 55%, transparent);
        text-decoration-thickness: 2px;
        text-underline-offset: 0.22em;
        transition: text-decoration-color 0.2s ease, color 0.2s ease;
    }
    /* Brand purple is 4.05:1 on --bg; a lighter tint keeps body-size text above 4.5:1 */
    .hero-verb[data-track="build"] { --verb-ink: #b57edc; }

    /* Inline + zero width, not absolute: an absolutely positioned child of a
       link that wraps onto two lines is placed against the first line, so the
       arrow showed up mid-sentence. Inline keeps it after the last word. */
    .hero-verb-arrow {
        display: inline-block;
        width: 0;
        white-space: nowrap;
        vertical-align: 0.9em;
        font-size: 0.6em;
        opacity: 0;
        transform: translate(-2px, 4px);
        transition: opacity 0.2s ease, transform 0.2s ease;
    }

    .hero-verb:hover,
    .hero-verb:focus-visible {
        text-decoration-style: solid;
        text-decoration-color: var(--track);
    }
    .hero-verb:hover .hero-verb-arrow,
    .hero-verb:focus-visible .hero-verb-arrow {
        opacity: 1;
        transform: translate(2px, 0);
    }
    .hero-verb:focus-visible {
        outline: 2px solid var(--track);
        outline-offset: 3px;
        border-radius: 4px;
    }

    /* ---------- proof strip ---------- */
    .hero-proof {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 4px 0;
        margin-top: clamp(12px, 2vh, 20px);
        font-family: var(--mono);
        font-size: 13px;
        color: var(--text-dim);
        animation: fadeUp 0.6s ease 0.25s both;
    }
    .hero-proof li { white-space: nowrap; }
    .hero-proof li + li::before {
        content: "·";
        margin: 0 12px;
        color: var(--purple);
    }

    /* ---------- contact: one primary action, the rest secondary ---------- */
    .hero-contact {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 10px 22px;
        margin-top: clamp(16px, 3vh, 30px);
        font-family: var(--mono);
        font-size: 14px;
        animation: fadeUp 0.6s ease 0.35s both;
    }

    .hero-contact a {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-height: 44px;
        color: var(--text-dim);
        text-decoration: none;
        transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
    }
    .hero-contact a:hover,
    .hero-contact a:focus-visible { color: var(--text); }

    .hero-contact svg {
        width: 15px;
        height: 15px;
        fill: currentColor;
        flex-shrink: 0;
    }

    .hero-contact .hero-email {
        padding: 0 22px;
        border-radius: 100px;
        border: 1px solid color-mix(in srgb, var(--purple) 55%, var(--border));
        background: color-mix(in srgb, var(--purple) 10%, var(--bg-card));
        color: var(--text);
    }
    .hero-contact .hero-email:hover,
    .hero-contact .hero-email:focus-visible {
        border-color: var(--purple);
        background: color-mix(in srgb, var(--purple) 22%, var(--bg-card));
        transform: translateY(-2px);
    }
    .hero-contact .hero-email svg { color: #b57edc; }

    .hero-contact-secondary {
        display: flex;
        align-items: center;
        gap: 4px 20px;
        flex-wrap: wrap;
        justify-content: center;
    }

    /* ---------- marquees ---------- */
    .hero-marquee-top { animation: fadeDown 0.8s ease 0.45s both; }
    .hero-marquee-bottom { animation: fadeUp 0.8s ease 0.55s both; }

    /* ---------- next-slide nudge: in flow, below the marquee (never on top of it) ---------- */
    .hero-scroll-hint {
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        min-height: 44px;
        margin-top: 4px;
        padding: 0 16px;
        background: none;
        border: none;
        font-family: var(--mono);
        font-size: 13px;
        color: var(--text-dim);
        cursor: pointer;
        transition: color 0.2s ease;
        animation: fadeUp 0.6s ease 0.9s both;
    }
    .hero-scroll-hint svg {
        width: 18px;
        height: 18px;
        fill: currentColor;
        animation: float 2.4s ease-in-out 1.5s infinite;
    }
    .hero-scroll-hint:hover,
    .hero-scroll-hint:focus-visible { color: var(--text); }

    /* ---------- marquee caption bubble ---------- */
    .hero-trait-tip {
        --tip-color: var(--purple);
        position: absolute;
        top: 0;
        left: 0;
        z-index: 5;
        max-width: min(340px, calc(100% - 24px));
        display: flex;
        flex-direction: column;
        gap: 4px;
        padding: 12px 16px;
        text-align: left;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-radius: 10px;
        box-shadow: 0 12px 40px -10px rgba(0, 0, 0, 0.8);
        pointer-events: none;
        opacity: 0;
        visibility: hidden;
        transform: translateY(4px);
        transition: opacity 0.18s ease, transform 0.18s ease, visibility 0s linear 0.18s;
    }
    .hero-trait-tip[data-side="above"] { transform: translateY(-4px); }
    .hero-trait-tip.is-visible {
        opacity: 1;
        visibility: visible;
        transform: none;
        transition: opacity 0.18s ease, transform 0.18s ease;
    }
    .hero-trait-tip-track {
        font-family: var(--mono);
        font-size: 11px;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: var(--tip-color);
    }
    .hero-trait-tip-text {
        font-size: 15px;
        line-height: 1.45;
        color: var(--text);
    }

    @keyframes fadeUp {
        from { opacity: 0; transform: translateY(16px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @keyframes fadeDown {
        from { opacity: 0; transform: translateY(-16px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @keyframes float {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(4px); }
    }

    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    /* ---------- small screens ---------- */
    @media (max-width: 600px) {
        .hero-greeting { font-size: 15px; margin-bottom: 10px; }
        h1 { letter-spacing: -1.5px; }
        .hero-tagline { font-size: 18px; }
        .hero-verb { font-weight: 700; }
        .hero-proof { font-size: 12px; flex-direction: column; gap: 2px; }
        .hero-proof li + li::before { content: none; }
        .hero-contact { gap: 6px; flex-direction: column; font-size: 13px; }
        .hero-contact-secondary { gap: 0 14px; font-size: 12px; }
        .hero-marquee-wrap { width: calc(100% + 32px); }
        /* Size the two marquee bands from their content (the bottom one has two
           rows) so neither overflows when the mask tray takes its slice of height. */
        .hero-marquee-wrap { flex-basis: auto; }
    }

    @media (max-height: 700px) and (min-width: 601px) {
        .hero-greeting { display: none; }
        .hero-proof { margin-top: 8px; }
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-slide *,
        .hero-slide *::before {
            animation: none !important;
        }
        .hero-greeting { border-right-color: transparent; }
    }

    @media print {
        .hero-slide {
            text-align: center;
            padding-bottom: 2px;
        }
        .hero-greeting {
            animation: none !important;
            width: auto !important;
            border: none;
            font-size: 10px;
            margin-bottom: 2px;
        }
        h1 {
            font-size: 24px;
            animation: none;
            opacity: 1;
            margin-bottom: 2px;
        }
        .hero-center { padding: 0; }
        .hero-marquee-wrap,
        .hero-scroll-hint,
        .hero-trait-tip,
        .hero-proof,
        .hero-contact,
        .hero-face-outline,
        .hero-face-hint,
        .hero-mask-worn {
            display: none;
        }
        .hero-tagline {
            animation: none;
            font-size: 11px;
            margin-top: 2px;
        }
        .hero-verb { color: inherit; text-decoration: none; }
        .hero-verb-arrow { display: none; }
        .sr-only.traits-keywords {
            position: static;
            width: auto;
            height: auto;
            clip: unset;
            overflow: visible;
            white-space: normal;
            font-size: 9px;
            color: var(--text-dim);
            margin-top: 4px;
        }
        .traits-keywords ul { list-style: none; display: inline; }
        .traits-keywords li { display: inline; }
