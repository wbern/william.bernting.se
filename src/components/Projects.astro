---
import { useTranslations } from "../i18n/utils";
import { defaultLang, type Lang } from "../i18n/ui";
import { getProjects, PROJECT_TRACKS, TRACK_ORDER, SLUG_ALIASES } from "../i18n/projects";
import { getProjectIllustrations } from "./projectIllustrations";
import { blurPlaceholder } from "../utils/blur-placeholder";

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);
const projects = getProjects(lang);
const illustrations = getProjectIllustrations(lang);

// Legend: only tracks that have at least one project, in a fixed order.
const legend = TRACK_ORDER
    .map((id) => ({ id, color: PROJECT_TRACKS[id].color, label: PROJECT_TRACKS[id][lang].label, cta: PROJECT_TRACKS[id][lang].cta }))
    .filter((tr) => projects.some((p) => p.track === tr.id));
const trackData = Object.fromEntries(legend.map((tr) => [tr.id, { color: tr.color, label: tr.label, cta: tr.cta }]));

// Generate blur placeholders for every photo illustration at build time.
const blurMap: Record<string, { dataUrl: string; width: number; height: number }> = {};
for (const illustration of Object.values(illustrations)) {
    if (illustration?.kind === "photo") {
        const filename = illustration.src.replace(/^\//, "");
        blurMap[illustration.src] = await blurPlaceholder(filename);
    }
}

const labels = {
    problem: t("projects.section.problem"),
    did: t("projects.section.did"),
    outcome: t("projects.section.outcome"),
    underHood: t("projects.under-hood"),
    facts: t("projects.facts.aria"),
    links: t("projects.links"),
    cta: t("projects.cta.button"),
    position: t("projects.position"),
};
---

<div class="section-inner roller-section" data-testid="projects-section">
    <!-- ===== VIEW 1: Roller ===== -->
    <div class="roller-view" data-testid="roller-view">
        <div class="section-label">{t("projects.label")}</div>
        <h2 class="section-heading">
            {t("projects.heading.before")}<span class="highlight">{t("projects.heading.highlight")}</span>{t("projects.heading.after")}
        </h2>

        <div class="roller-legend" data-testid="roller-legend">
            <span class="roller-count">{t("projects.count").replace("{n}", String(projects.length))}</span>
            {legend.map((tr) => (
                <button class="legend-chip" data-track={tr.id} style={`--chip:${tr.color}`} title={t("projects.legend.aria")}>
                    <span class="legend-dot" aria-hidden="true"></span>{tr.label}
                </button>
            ))}
        </div>

        <div class="roller-wrapper">
            <button class="roller-arrow" data-testid="roller-arrow-up" aria-label={t("projects.aria.prev")}>&#x25B2;</button>

            <div class="roller-viewport" data-testid="roller" data-keen-slider-clickable role="listbox" aria-label={t("projects.aria.list")}>
                <div id="roller-track" class="roller-track">
                    <!-- Slides populated by script -->
                </div>
                <!-- Centre-slot highlight overlay -->
                <div class="roller-highlight"></div>
            </div>

            <button class="roller-arrow" data-testid="roller-arrow-down" aria-label={t("projects.aria.next")}>&#x25BC;</button>
        </div>

        <p class="roller-hook" data-testid="roller-hook" aria-live="polite"></p>

        <div class="roller-actions">
            <button class="action-button action-button--spin" data-testid="spin-button" aria-label={t("projects.spin")} title={t("projects.spin")}>
                <svg class="spin-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M 19.5 12 A 7.5 7.5 0 1 0 15 18.9" />
                    <polyline points="19.5,8 19.5,12 15.5,12" />
                </svg>
            </button>
            <button class="action-button action-button--open" data-testid="open-button">
                {t("projects.open")} <span class="open-arrow" aria-hidden="true">&#x2192;</span>
            </button>
        </div>
        <p class="roller-hint" aria-hidden="true">{t("projects.hint")}</p>
    </div>

    <!-- ===== VIEW 2: Detail ===== -->
    <div class="detail-view" data-testid="detail-view">
        <button class="back-button" data-testid="back-button" aria-label={t("projects.aria.back")} data-label={t("projects.back")}>
            <span class="back-arrow">&#x2190;</span> {t("projects.back")}
        </button>
        <article class="detail-card" data-testid="detail-card">
            <!-- Detail content injected by script -->
        </article>
        <div class="detail-footer" data-testid="detail-footer">
            <button class="back-button back-button--bottom" aria-label={t("projects.aria.back")}>
                <span class="back-arrow">&#x2190;</span> {t("projects.back")}
            </button>
            <span class="detail-position" data-testid="detail-position"></span>
            <button class="next-button" data-testid="next-button">
                {t("projects.next")} <span class="next-arrow" aria-hidden="true">&#x2192;</span>
            </button>
        </div>
    </div>
</div>

<!-- Print fallback (server-rendered) -->
<div class="section-inner projects-print-fallback">
    <div class="section-label">{t("projects.label")}</div>
    <h2 class="section-heading">{t("projects.heading.before")}<span class="highlight">{t("projects.heading.highlight")}</span>{t("projects.heading.after")}</h2>
    <div class="projects-grid">
        {projects.map((p) => (
            <div class="project-card">
                <div class="project-tag">{p.tag} · {p.context}</div>
                <h3>{p.title}</h3>
                <p>{p.hook}</p>
                <p set:html={p.outcome} />
            </div>
        ))}
    </div>
</div>

<!-- Inject translated project data for client JS -->
<script type="application/json" id="projects-i18n-data" set:html={JSON.stringify(projects)} />
<script type="application/json" id="projects-aliases-data" set:html={JSON.stringify(SLUG_ALIASES)} />
<script type="application/json" id="projects-blur-data" set:html={JSON.stringify(blurMap)} />
<script type="application/json" id="projects-illustrations-data" set:html={JSON.stringify(illustrations)} />
<script type="application/json" id="projects-tracks-data" set:html={JSON.stringify(trackData)} />
<script type="application/json" id="projects-labels-data" set:html={JSON.stringify(labels)} />

<script>
    import { mod, pickLanding, nextInTrack } from "../utils/roller";

    interface ProjectData {
        slug: string; track: string; flagship: boolean; tag: string;
        title: string; context: string; hook: string;
        problem: string; did: string; outcome: string;
        facts: { value: string; label: string }[];
        nerdy: string[];
        links: { href: string; label: string }[];
        quote: { text: string; name: string; relation: string } | null;
    }
    const json = <T,>(id: string): T => JSON.parse(document.getElementById(id)!.textContent!);

    const PROJECTS = json<ProjectData[]>("projects-i18n-data");
    const ALIASES = json<Record<string, string>>("projects-aliases-data");
    const BLUR_DATA = json<Record<string, { dataUrl: string; width: number; height: number }>>("projects-blur-data");
    type Illustration =
        | { kind: "svg"; markup: string }
        | { kind: "photo"; src: string; alt: string; caption?: string };
    const ILLUSTRATIONS = json<Record<string, Illustration | null>>("projects-illustrations-data");
    const TRACKS = json<Record<string, { color: string; label: string; cta: string }>>("projects-tracks-data");
    const LABELS = json<Record<string, string>>("projects-labels-data");

    /* ── Deep-link slug map (slug → index), with aliases for merged cards ── */
    const PROJECT_SLUGS = PROJECTS.map((p) => p.slug);
    const TRACK_OF = PROJECTS.map((p) => p.track);
    const slugToIndex: Record<string, number> = {};
    PROJECT_SLUGS.forEach((slug, i) => { slugToIndex[slug] = i; });
    function indexForHash(hash: string): number | null {
        const slug = hash in slugToIndex ? hash : ALIASES[hash];
        return slug != null && slug in slugToIndex ? slugToIndex[slug] : null;
    }

    const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");

    /** Build a photo diorama with blur-up placeholder. */
    function photoDiorama(src: string, alt: string, caption?: string): string {
        const blur = BLUR_DATA[src];
        const img = blur
            ? `<div class="diorama-blur" style="background-image:url(${blur.dataUrl})">
                <img src="${src}" alt="${esc(alt)}" width="${blur.width}" height="${blur.height}" loading="lazy" decoding="async" onload="this.classList.add('loaded')" />
              </div>`
            : `<img src="${src}" alt="${esc(alt)}" style="display:block;width:100%;height:auto;" />`;
        const cap = caption ? `<figcaption class="diorama-caption">${esc(caption)}</figcaption>` : "";
        return `<figure class="diorama-figure"><div class="diorama diorama--photo">${img}</div>${cap}</figure>`;
    }

    /** Render the illustration for a given project slug, branching by kind. */
    function renderIllustration(slug: string): string {
        const il = ILLUSTRATIONS[slug];
        if (!il) return "";
        if (il.kind === "svg") return il.markup;
        return photoDiorama(il.src, il.alt, il.caption);
    }

    const N = PROJECTS.length;
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    let scrollPos = 0;       // continuous fractional scroll position
    let currentIdx = 0;      // integer index of selected item (set when settled)
    let targetIdx = 0;       // intended destination for manual nav
    let isSpinning = false;
    let isDetailView = false;
    let spinAnimId: number | null = null;
    let navAnimId: number | null = null;

    const section = document.querySelector("[data-testid='projects-section']") as HTMLElement;
    const detailCard = document.querySelector("[data-testid='detail-card']") as HTMLElement;
    const detailViewEl = section?.querySelector(".detail-view") as HTMLElement | null;
    const spinBtn = document.querySelector("[data-testid='spin-button']") as HTMLElement;
    const openBtn = document.querySelector("[data-testid='open-button']") as HTMLElement;
    // Rotate the icon, not the button: a rotated button's corners overflow the
    // section and the browser scrolled the clipped section to reveal them (jitter).
    const spinIcon = spinBtn?.querySelector(".spin-icon") as SVGElement | null;
    const arrowUp = document.querySelector("[data-testid='roller-arrow-up']") as HTMLElement;
    const arrowDown = document.querySelector("[data-testid='roller-arrow-down']") as HTMLElement;
    const backBtns = Array.from(section.querySelectorAll(".back-button")) as HTMLElement[];
    const nextBtn = document.querySelector("[data-testid='next-button']") as HTMLElement;
    const positionEl = document.querySelector("[data-testid='detail-position']") as HTMLElement;
    const hookEl = document.querySelector("[data-testid='roller-hook']") as HTMLElement;
    const legendChips = Array.from(section.querySelectorAll(".legend-chip")) as HTMLElement[];
    const track = document.getElementById("roller-track") as HTMLElement;
    const viewport = document.querySelector("[data-testid='roller']") as HTMLElement;

    // Match the CSS media query for --slide-h: 76px on desktop, 60px on mobile
    const SLIDE_HEIGHT = window.matchMedia("(min-width: 901px)").matches ? 76 : 60;
    const CENTER_OFFSET = window.matchMedia("(min-height: 600px)").matches ? 1.5 : 1;

    // Build slide elements
    PROJECTS.forEach((p, i) => {
        const slide = document.createElement("div");
        slide.className = "roller-slide";
        slide.setAttribute("role", "option");
        slide.dataset.index = String(i);
        slide.dataset.track = p.track;
        const color = TRACKS[p.track]?.color ?? "#8888a0";
        slide.innerHTML = `<span class="roller-slide__tag" style="--chip:${color}">${esc(p.tag)}</span><span class="roller-slide__title">${esc(p.title)}</span>`;
        track.appendChild(slide);
    });

    const slides = Array.from(track.querySelectorAll(".roller-slide")) as HTMLElement[];

    // ── Hook line under the roller ───────────────────────
    let hookIdx = -1;
    function showHook(idx: number) {
        if (idx === hookIdx) return;
        hookIdx = idx;
        const p = PROJECTS[idx];
        hookEl.textContent = p.hook;
        hookEl.style.setProperty("--chip", TRACKS[p.track]?.color ?? "var(--purple)");
        hookEl.classList.remove("roller-hook--in");
        void hookEl.offsetWidth; // restart the fade-in
        hookEl.classList.add("roller-hook--in");
        legendChips.forEach((c) => c.classList.toggle("is-current", c.dataset.track === p.track));
    }

    // ── Rendering (continuous) ────────────────────────────
    // scrollPos is a fractional number. Each integer = one slide.
    // Slides are positioned via translateY based on their distance from scrollPos.

    function render() {
        const isSettled = Math.abs(scrollPos - Math.round(scrollPos)) < 0.01;
        const centerIdx = mod(Math.round(scrollPos), N);

        slides.forEach((el, i) => {
            // Shortest wrapped distance from this slide to the current scroll position
            let diff = i - scrollPos;
            diff -= N * Math.round(diff / N);

            const absDiff = Math.abs(diff);

            if (absDiff > 2.5) {
                el.style.transform = "";
                el.style.opacity = "0";
                el.style.pointerEvents = "none";
                el.classList.remove("roller-slide--selected", "roller-slide--near", "roller-slide--far");
                el.setAttribute("aria-selected", "false");
                delete el.dataset.testid;
                return;
            }

            // Position: centre slot sits at CENTER_OFFSET × SLIDE_HEIGHT from top of viewport
            const y = (diff + CENTER_OFFSET) * SLIDE_HEIGHT;
            el.style.transform = `translateY(${y}px)`;
            el.style.pointerEvents = "auto";

            // Smooth opacity falloff based on distance from centre
            el.style.opacity = String(Math.max(0, 1 - absDiff * 0.25));

            // State classes (only assign roller-selected when fully settled)
            el.classList.remove("roller-slide--selected", "roller-slide--near", "roller-slide--far");
            delete el.dataset.testid;

            if (isSettled && i === centerIdx) {
                el.classList.add("roller-slide--selected");
                el.dataset.testid = "roller-selected";
                el.setAttribute("aria-selected", "true");
            } else {
                el.setAttribute("aria-selected", "false");
                if (absDiff < 1.5) {
                    el.classList.add("roller-slide--near");
                } else {
                    el.classList.add("roller-slide--far");
                }
            }
        });

        if (isSettled && !isSpinning) showHook(centerIdx);
    }

    // ── Smooth navigation animation ──────────────────────

    function animateTo(dest: number, duration = 300) {
        if (navAnimId) { cancelAnimationFrame(navAnimId); navAnimId = null; }

        const target = mod(dest, N);
        const start = scrollPos;
        const currentNorm = mod(scrollPos, N);

        // Shortest path considering wrapping
        let diff = target - currentNorm;
        if (diff > N / 2) diff -= N;
        if (diff < -N / 2) diff += N;

        if (Math.abs(diff) < 0.01) {
            scrollPos = target;
            currentIdx = target;
            render();
            return;
        }

        const startTime = performance.now();

        function animate(now: number) {
            const t = Math.min((now - startTime) / duration, 1);
            const eased = 1 - Math.pow(1 - t, 2); // quadratic ease-out
            scrollPos = start + eased * diff;
            render();

            if (t < 1) {
                navAnimId = requestAnimationFrame(animate);
            } else {
                scrollPos = target;
                currentIdx = target;
                navAnimId = null;
                render();
            }
        }

        navAnimId = requestAnimationFrame(animate);
    }

    function goTo(idx: number) {
        if (isSpinning || isDetailView) return;
        targetIdx = mod(idx, N);
        animateTo(targetIdx);
    }
    const next = () => goTo(targetIdx + 1);
    const prev = () => goTo(targetIdx - 1);

    // Start somewhere random so the arrival spin doesn't always land on the same case
    scrollPos = currentIdx = targetIdx = Math.floor(Math.random() * N);
    render();

    // ── Touch / pointer drag ─────────────────────────────
    let dragStartY = 0;
    let dragStartPos = 0;
    let isDragging = false;

    function stopSpin() {
        if (spinAnimId) { cancelAnimationFrame(spinAnimId); spinAnimId = null; }
        isSpinning = false;
        isSettling = false;
        spinVelocity = 0;
        section?.classList.remove("is-spinning");
        viewport?.classList.remove("roller-spinning");
        spinBtn?.classList.remove("spinning");
    }

    viewport?.addEventListener("pointerdown", (e: PointerEvent) => {
        if (isDetailView) return;
        e.stopPropagation();
        // Cancel any active spin — user takes over
        if (isSpinning) stopSpin();
        if (navAnimId) { cancelAnimationFrame(navAnimId); navAnimId = null; }
        isDragging = true;
        dragStartY = e.clientY;
        dragStartPos = scrollPos;
        viewport.setPointerCapture(e.pointerId);
    });

    viewport?.addEventListener("pointermove", (e: PointerEvent) => {
        if (!isDragging) return;
        e.stopPropagation();
        const delta = e.clientY - dragStartY;
        scrollPos = dragStartPos - delta / SLIDE_HEIGHT;
        render();
    });

    viewport?.addEventListener("pointerup", (e: PointerEvent) => {
        if (!isDragging) return;
        e.stopPropagation();
        isDragging = false;
        viewport.releasePointerCapture(e.pointerId);

        // Detect tap (no significant drag) and treat as slide click.
        // Pointer capture redirects the click event to the viewport,
        // so the track click handler never fires — handle it here.
        const dragDelta = Math.abs(e.clientY - dragStartY);
        if (dragDelta < 5) {
            // Determine which slot was tapped from the pointer Y position
            const rect = viewport.getBoundingClientRect();
            const relY = e.clientY - rect.top;
            const slotOffset = Math.floor(relY / SLIDE_HEIGHT - CENTER_OFFSET);
            const tappedIdx = mod(currentIdx + slotOffset, N);

            if (tappedIdx === currentIdx) {
                transitionToDetail();
            } else {
                targetIdx = tappedIdx;
                animateTo(tappedIdx);
            }
            return;
        }

        // Snap to nearest slide
        const nearest = mod(Math.round(scrollPos), N);
        targetIdx = nearest;
        currentIdx = nearest;
        animateTo(nearest, 200);
    });

    // ── Momentum-based spin ─────────────────────────────
    // Each click adds velocity. Friction decays it. Button spin speed matches.
    let spinVelocity = 0;      // slides per second
    let btnAngle = 0;          // cumulative button rotation in degrees
    let lastSpinTime = 0;

    const SPIN_KICK_MIN = 14;  // slides/sec added per click (min)
    const SPIN_KICK_MAX = 24;  // slides/sec added per click (max)
    const MAX_VELOCITY = 50;   // cap
    const FRICTION_MIN = 0.965;
    const FRICTION_MAX = 0.975;
    const SETTLE_THRESHOLD = 0.3;
    let currentFriction = 0.97;
    let spinStartIdx = 0;
    let isFirstSpin = true;
    /** The first spin of a visit lands on a flagship case, never a side quest. */
    const FIRST_SPIN_TARGETS = new Set(PROJECTS.map((p, i) => (p.flagship ? i : -1)).filter((i) => i >= 0));

    function startSpinLoop() {
        isSpinning = true;
        spinStartIdx = currentIdx;
        lastSpinTime = performance.now();
        section?.classList.add("is-spinning");
        viewport?.classList.add("roller-spinning");
        spinBtn?.classList.add("spinning");
        spinAnimId = requestAnimationFrame(spinLoop);
    }

    function spin() {
        if (isDetailView) return;
        if (navAnimId) { cancelAnimationFrame(navAnimId); navAnimId = null; }
        isSettling = false;

        const kick = SPIN_KICK_MIN + Math.random() * (SPIN_KICK_MAX - SPIN_KICK_MIN);
        spinVelocity = Math.min(spinVelocity + kick, MAX_VELOCITY);
        // Randomize friction each spin so duration feels different
        currentFriction = FRICTION_MIN + Math.random() * (FRICTION_MAX - FRICTION_MIN);

        if (!isSpinning) startSpinLoop();
    }

    let isSettling = false;
    let settleStart = 0;
    let settleFrom = 0;
    let settleTo = 0;
    const SETTLE_DURATION = 280; // ms

    function spinLoop(now: number) {
        const dt = Math.min((now - lastSpinTime) / 1000, 0.05);
        lastSpinTime = now;

        // Settling phase — elastic ease into the target slot
        if (isSettling) {
            const t = Math.min((now - settleStart) / SETTLE_DURATION, 1);
            const elastic = t === 1 ? 1 : 1 - Math.pow(2, -10 * t) * Math.cos((t * 10 - 0.75) * (2 * Math.PI / 3));
            scrollPos = settleFrom + (settleTo - settleFrom) * elastic;
            btnAngle += (1 - t) * 2; // gentle residual button rotation
            if (spinIcon) spinIcon.style.transform = `rotate(${btnAngle}deg)`;
            render();

            if (t >= 1) {
                scrollPos = mod(settleTo, N);
                currentIdx = mod(settleTo, N);
                targetIdx = currentIdx;
                stopSpin();
                render();
                // No auto-open: the hook line + "Read more" invite the click.
                section?.classList.add("just-landed");
                setTimeout(() => section?.classList.remove("just-landed"), 900);
                return;
            }

            spinAnimId = requestAnimationFrame(spinLoop);
            return;
        }

        // Momentum phase — friction decay
        spinVelocity *= currentFriction;
        scrollPos += spinVelocity * dt;
        btnAngle += spinVelocity * dt * 60;
        if (spinIcon) spinIcon.style.transform = `rotate(${btnAngle}deg)`;
        render();

        if (spinVelocity < SETTLE_THRESHOLD) {
            isSettling = true;
            settleStart = now;
            settleFrom = scrollPos;
            settleTo = pickLanding(
                Math.round(scrollPos),
                spinStartIdx,
                N,
                isFirstSpin ? FIRST_SPIN_TARGETS : new Set(),
            );
            isFirstSpin = false;
            spinVelocity = 0;
        }

        spinAnimId = requestAnimationFrame(spinLoop);
    }

    // ── Detail view ──────────────────────────────────────
    function cardHtml(p: ProjectData): string {
        const color = TRACKS[p.track]?.color ?? "var(--purple)";
        const facts = p.facts.length
            ? `<ul class="detail-facts" aria-label="${esc(LABELS.facts)}">${p.facts
                  .map((f) => `<li class="detail-fact"><span class="detail-fact__value">${esc(f.value)}</span><span class="detail-fact__label">${esc(f.label)}</span></li>`)
                  .join("")}</ul>`
            : "";
        const block = (label: string, html: string, extra = "") =>
            `<section class="detail-section${extra}"><h4>${esc(label)}</h4><p>${html}</p></section>`;
        const quote = p.quote
            ? `<blockquote class="detail-quote"><p>“${esc(p.quote.text)}”</p><footer>${esc(p.quote.name)}, ${esc(p.quote.relation)}</footer></blockquote>`
            : "";
        const links = p.links.length
            ? `<div class="detail-links"><span class="detail-small-label">${esc(LABELS.links)}</span>${p.links
                  .map((l) => `<a class="detail-link" href="${esc(l.href)}" target="_blank" rel="noopener noreferrer">${esc(l.label)} <span aria-hidden="true">↗</span></a>`)
                  .join("")}</div>`
            : "";
        const nerdy = `<div class="detail-nerdy"><span class="detail-small-label">${esc(LABELS.underHood)}</span><ul>${p.nerdy
            .map((n) => `<li>${esc(n)}</li>`)
            .join("")}</ul></div>`;
        const cta = `<div class="detail-cta"><p>${esc(TRACKS[p.track]?.cta ?? "")}</p><button class="detail-cta__button" data-testid="detail-cta">${esc(LABELS.cta)} <span aria-hidden="true">→</span></button></div>`;

        return `
            <div class="detail-card__inner" style="--chip:${color}">
                <div class="detail-meta">
                    <span class="project-tag">${esc(p.tag)}</span>
                    <span class="detail-context">${esc(p.context)}</span>
                </div>
                <h3>${esc(p.title)}</h3>
                <p class="detail-hook">${esc(p.hook)}</p>
                ${facts}
                ${renderIllustration(p.slug)}
                ${block(LABELS.problem, p.problem)}
                ${block(LABELS.did, p.did)}
                ${block(LABELS.outcome, p.outcome, " detail-section--outcome")}
                ${quote}
                ${links}
                ${nerdy}
                ${cta}
            </div>`;
    }

    function fillDetail(idx: number) {
        const p = PROJECTS[idx];
        detailCard.innerHTML = cardHtml(p);
        detailCard.querySelector("[data-testid='detail-cta']")?.addEventListener("click", goToContact);
        if (positionEl) positionEl.textContent = LABELS.position.replace("{i}", String(idx + 1)).replace("{n}", String(N));
        if (detailViewEl) detailViewEl.scrollTop = 0;
        history.replaceState(null, "", "#" + p.slug);
    }

    function transitionToDetail() {
        if (isDetailView || isSpinning) return;
        isDetailView = true;
        fillDetail(currentIdx);
        section?.classList.add("detail-active");
        document.getElementById("slide-dots")?.classList.add("hidden");
        const parentSlide = section?.closest(".keen-slider__slide") as HTMLElement | null;
        if (parentSlide) parentSlide.scrollTop = 0;
        // Tell keen-slider to freeze
        document.dispatchEvent(new CustomEvent("detail-view-toggle", { detail: { active: true } }));
        // Move focus into the card for keyboard and screen-reader users
        (detailCard.querySelector("h3") as HTMLElement | null)?.setAttribute("tabindex", "-1");
        (detailCard.querySelector("h3") as HTMLElement | null)?.focus({ preventScroll: true });
    }

    /** Swap the open card for another project, keeping the roller in sync. */
    function showProject(idx: number) {
        idx = mod(idx, N);
        if (navAnimId) { cancelAnimationFrame(navAnimId); navAnimId = null; }
        scrollPos = idx;
        currentIdx = idx;
        targetIdx = idx;
        render();
        if (!isDetailView) { transitionToDetail(); return; }
        detailCard.classList.remove("card-swap");
        void detailCard.offsetWidth;
        detailCard.classList.add("card-swap");
        fillDetail(idx);
    }

    function transitionToRoller() {
        if (!isDetailView) return;
        isDetailView = false;
        section?.classList.remove("detail-active");
        document.getElementById("slide-dots")?.classList.remove("hidden");
        // Reset scroll positions so swiping works immediately
        const parentSlide = section?.closest(".keen-slider__slide");
        if (parentSlide) parentSlide.scrollTop = 0;
        if (detailViewEl) detailViewEl.scrollTop = 0;
        // Tell keen-slider to unfreeze
        document.dispatchEvent(new CustomEvent("detail-view-toggle", { detail: { active: false } }));
        // Clear URL hash
        history.replaceState(null, "", location.pathname);
        openBtn?.focus({ preventScroll: true });
    }

    /** CTA: close the card and jump to the contact slide (the last one). */
    function goToContact() {
        transitionToRoller();
        const last = document.querySelectorAll("#slider > .keen-slider__slide").length - 1;
        document.dispatchEvent(new CustomEvent("slider-goto", { detail: { index: last } }));
    }

    // ── Event listeners ──────────────────────────────────
    spinBtn?.addEventListener("click", spin);
    openBtn?.addEventListener("click", () => transitionToDetail());
    backBtns.forEach((b) => b.addEventListener("click", () => transitionToRoller()));
    nextBtn?.addEventListener("click", () => showProject(currentIdx + 1));
    arrowUp?.addEventListener("click", () => prev());
    arrowDown?.addEventListener("click", () => next());
    legendChips.forEach((chip) => chip.addEventListener("click", () => {
        if (isSpinning || isDetailView) return;
        const idx = nextInTrack(currentIdx, TRACK_OF, chip.dataset.track ?? "");
        if (idx >= 0) goTo(idx);
    }));

    // Click a slide to open it
    track?.addEventListener("click", (e: MouseEvent) => {
        if (isSpinning) return;
        const slide = (e.target as HTMLElement).closest(".roller-slide") as HTMLElement | null;
        if (!slide) return;
        const idx = Number(slide.dataset.index);
        if (idx === currentIdx) {
            transitionToDetail();
        } else {
            targetIdx = idx;
            animateTo(idx);
        }
    });

    // Keyboard nav — stopPropagation prevents the global keen-slider
    // ArrowUp/Down handler from also firing a slide change.
    viewport?.setAttribute("tabindex", "0");
    viewport?.addEventListener("keydown", (e: KeyboardEvent) => {
        if (isSpinning || isDetailView) return;
        if (e.key === "ArrowUp") { e.preventDefault(); e.stopPropagation(); prev(); }
        if (e.key === "ArrowDown") { e.preventDefault(); e.stopPropagation(); next(); }
        if (e.key === "Enter") { e.preventDefault(); e.stopPropagation(); transitionToDetail(); }
        if (e.key === " ") { e.preventDefault(); e.stopPropagation(); spin(); }
    });

    let wheelAccum = 0;
    section?.addEventListener("wheel", (e: WheelEvent) => {
        if (!viewport?.contains(e.target as Node)) return;
        e.stopPropagation();
        e.preventDefault();
        if (isSpinning || isDetailView) {
            wheelAccum = 0;
            return;
        }

        // Reset accumulator on direction reversal to avoid sluggish response
        if ((wheelAccum > 0 && e.deltaY < 0) || (wheelAccum < 0 && e.deltaY > 0)) {
            wheelAccum = 0;
        }
        // Accumulate small deltas (trackpad) before triggering a step
        wheelAccum += e.deltaY;
        const threshold = 60;
        if (Math.abs(wheelAccum) >= threshold) {
            if (wheelAccum > 0) next(); else prev();
            wheelAccum = 0;
        }
    }, { capture: true, passive: false });

    document.addEventListener("keydown", (e: KeyboardEvent) => {
        if (!isDetailView) return;
        if (e.key === "Escape") { e.preventDefault(); transitionToRoller(); }
        const inField = (e.target as HTMLElement)?.closest?.("input, textarea, [contenteditable]");
        if (inField) return;
        if (e.key === "ArrowRight") { e.preventDefault(); showProject(currentIdx + 1); }
        if (e.key === "ArrowLeft") { e.preventDefault(); showProject(currentIdx - 1); }
    });

    // Prevent touch/mouse events on the detail view from propagating to
    // keen-slider, which would interpret them as slide-change swipes.
    function stopIfDetail(e: Event) {
        if (isDetailView) e.stopPropagation();
    }
    detailViewEl?.addEventListener("mousedown", stopIfDetail);
    detailViewEl?.addEventListener("touchstart", stopIfDetail, { passive: true });

    /** Roll to a project and open it. Snaps to the target before opening so a
     *  slow frame (e.g. while the slider is still moving) can't open the wrong card. */
    function openDetailAt(idx: number) {
        if (isSpinning) stopSpin();
        targetIdx = idx;
        animateTo(idx, 300);
        setTimeout(() => showProject(idx), 350);
    }

    // Browser back/forward and hash edits: follow the hash, also while a card is open
    window.addEventListener("popstate", () => {
        const idx = indexForHash(location.hash.replace(/^#/, ""));
        if (idx == null) {
            if (isDetailView) transitionToRoller();
        } else if (isDetailView) {
            if (idx !== currentIdx) showProject(idx);
        } else if (isOnProjectsSlide) {
            openDetailAt(idx);
        }
    });

    // ── Auto-spin on enter, reset on leave ─────────────
    const PROJECTS_SLIDE_INDEX = 1;
    let hasAutoSpun = false;
    let isOnProjectsSlide = false;

    /** A short, charming spin on arrival that always lands on a flagship case. */
    function autoSpin() {
        if (isSpinning || isDetailView) return;
        if (prefersReducedMotion) {
            const targets = [...FIRST_SPIN_TARGETS];
            if (targets.length) {
                const idx = targets[Math.floor(Math.random() * targets.length)];
                scrollPos = currentIdx = targetIdx = idx;
                isFirstSpin = false;
                render();
            }
            return;
        }
        spinVelocity = 28 + Math.random() * 8;
        currentFriction = FRICTION_MAX;
        startSpinLoop();
    }

    function silentReset() {
        if (spinAnimId) { cancelAnimationFrame(spinAnimId); spinAnimId = null; }
        if (navAnimId) { cancelAnimationFrame(navAnimId); navAnimId = null; }
        stopSpin();
        isDetailView = false;
        section?.classList.remove("detail-active");
        document.getElementById("slide-dots")?.classList.remove("hidden");
        // Clear URL hash so returning to the projects slide doesn't re-open detail
        if (location.hash) history.replaceState(null, "", location.pathname);
        // Reset parent keen-slider slide's scroll position so the roulette
        // isn't offset when returning after viewing a scrolled detail card
        const parentSlide = section?.closest(".keen-slider__slide");
        if (parentSlide) parentSlide.scrollTop = 0;
        // Scramble position so next visit looks different
        const randomStart = Math.floor(Math.random() * N);
        scrollPos = randomStart;
        currentIdx = randomStart;
        targetIdx = randomStart;
        render();
    }

    document.addEventListener("slide-changed", ((e: CustomEvent) => {
        const idx = e.detail.index;
        if (idx === PROJECTS_SLIDE_INDEX) {
            if (!isOnProjectsSlide) {
                isOnProjectsSlide = true;

                // Deep link: if hash matches a project slug, navigate directly
                const hashIdx = indexForHash(location.hash.replace(/^#/, ""));
                if (hashIdx != null) {
                    hasAutoSpun = true; // skip auto-spin
                    isFirstSpin = false;
                    openDetailAt(hashIdx);
                } else if (!hasAutoSpun) {
                    hasAutoSpun = true;
                    autoSpin();
                }
            }
        } else {
            if (isOnProjectsSlide) {
                isOnProjectsSlide = false;
                silentReset();
            }
        }
    }) as EventListener);

</script>

<style is:global>
    /* ===== Section Container ===== */
    /* Grid stacking: both views overlap in the same cell.
