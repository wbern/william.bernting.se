---
import type { TraitRow } from "../i18n/traits";

interface Props {
    rows: TraitRow[];
    class?: string;
    /** Optional mask id per row: the mask rides along in that row like a word (see Masks.astro). */
    masks?: (string | undefined)[];
}

const { rows, class: className, masks = [] } = Astro.props;

/**
 * Each half of the track repeats the row this many times, so a half is
 * always wider than the viewport (no gap when the -50% loop wraps), even
 * on ultra-wide screens with only three short items per row.
 */
const REPEAT = 3;
---

<!--
    Decorative + pointer-interactive. Hidden from assistive tech: the same
    traits and captions are rendered as an sr-only list in Hero.astro.
-->
<div class:list={["marquee-field", className]} aria-hidden="true">
    {rows.map((row, rowIndex) => (
        <div
            class:list={["marquee-row", `marquee-row--${row.speed}`, { "marquee-row--reverse": row.reverse }]}
            data-track={row.track}
            style={`--row-color: ${row.color};`}
        >
            <div class={`marquee-track marquee-track--${row.size}`}>
                {[0, 1].map(() => (
                    <div class="marquee-set">
                        {Array.from({ length: REPEAT }).flatMap(() => [
                            ...row.items.map((item) => (
                                <>
                                    <span class="marquee-item" data-trait={item.id} data-caption={item.caption}>{item.label}</span>
                                    <span class="marquee-sep">◆</span>
                                </>
                            )),
                            // One mask per repetition so it drifts past every ~20s even on narrow screens
                            masks[rowIndex] ? (
                                <>
                                    <span class="marquee-mask" data-mask-slot={masks[rowIndex]} data-keen-slider-clickable>
                                        <svg class="mask-art"><use href={`#mask-${masks[rowIndex]}`} /></svg>
                                    </span>
                                    <span class="marquee-sep">◆</span>
                                </>
                            ) : null,
                        ])}
                    </div>
                ))}
            </div>
        </div>
    ))}
</div>

<style>
    .marquee-field {
        display: flex;
        flex-direction: column;
        gap: clamp(10px, 2.2vh, 22px);
        overflow: hidden;
        -webkit-mask-image: linear-gradient(90deg, transparent, black 7%, black 93%, transparent);
        mask-image: linear-gradient(90deg, transparent, black 7%, black 93%, transparent);
    }

    .marquee-row {
        overflow: hidden;
        white-space: nowrap;
    }

    .marquee-track {
        display: flex;
        width: max-content;
        will-change: transform;
        animation: marquee-drift var(--marquee-duration, 60s) linear infinite;
    }

    .marquee-row--reverse .marquee-track { animation-direction: reverse; }

    /* Hover/tap on a word freezes its row so the caption can be read */
    .marquee-row.is-paused .marquee-track { animation-play-state: paused; }

    .marquee-set {
        display: flex;
        align-items: center;
        flex-shrink: 0;
    }

    /* speeds (durations cover REPEAT copies of the row) */
    .marquee-row--slow .marquee-track { --marquee-duration: 90s; }
    .marquee-row--mid  .marquee-track { --marquee-duration: 75s; }
    .marquee-row--fast .marquee-track { --marquee-duration: 64s; }

    /* sizes */
    .marquee-track--lg .marquee-item {
        font-size: clamp(26px, 3.8vw, 42px);
        font-weight: 800;
        letter-spacing: -0.5px;
        color: color-mix(in srgb, var(--row-color) 78%, var(--bg));
    }
    .marquee-track--md .marquee-item {
        font-size: clamp(18px, 2.5vw, 28px);
        font-weight: 600;
        letter-spacing: 0.5px;
        color: var(--text);
    }
    .marquee-track--sm .marquee-item {
        font-size: clamp(13px, 1.6vw, 16px);
        font-weight: 500;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--text-dim);
    }

    .marquee-item {
        font-family: var(--mono);
        white-space: nowrap;
        flex-shrink: 0;
        padding: 6px 22px;
        border-radius: 999px;
        cursor: help;
        transition: color 0.2s ease, background-color 0.2s ease, opacity 0.2s ease;
    }

    .marquee-sep {
        flex-shrink: 0;
        font-size: 0.55em;
        color: var(--row-color);
        opacity: 0.55;
        padding: 0 6px;
    }
    .marquee-track--lg .marquee-sep { font-size: 14px; }
    .marquee-track--md .marquee-sep { font-size: 11px; }
    .marquee-track--sm .marquee-sep { font-size: 8px; }

    .marquee-row.is-paused .marquee-item { opacity: 0.45; }
    .marquee-row.is-paused .marquee-item.is-active {
        opacity: 1;
        color: var(--row-color);
        background: color-mix(in srgb, var(--row-color) 12%, transparent);
    }

    @media (hover: hover) {
        .marquee-item:hover { color: var(--row-color); }
    }

    @keyframes marquee-drift {
        from { transform: translateX(0); }
        to   { transform: translateX(-50%); }
    }

    @media (prefers-reduced-motion: reduce) {
        .marquee-track { animation: none; }
    }

    @media print {
        .marquee-field { display: none !important; }
    }
</style>
