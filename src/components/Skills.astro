---
import { useTranslations } from "../i18n/utils";
import { defaultLang, type Lang } from "../i18n/ui";
import { getSkillProfiles, getSkillCombos } from "../i18n/skills";
import { projectEntries } from "../i18n/projects";

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);

const projectTitle = (slug: string | null) =>
    slug ? (projectEntries.find((p) => p.slug === slug)?.[lang].title ?? null) : null;

const skills = getSkillProfiles(lang).map((s) => ({ ...s, proofTitle: projectTitle(s.proofSlug) }));
const combos = getSkillCombos(lang).map((c) => ({ ...c, slugTitle: projectTitle(c.slug) }));
const pillars = skills.filter((s) => s.pillar);
const tools = skills.filter((s) => !s.pillar).sort((a, b) => (b.years ?? 0) - (a.years ?? 0));

const numberLocale = lang === "sv" ? "sv-SE" : "en-GB";
const fmtYears = (y: number | null) =>
    y === null ? "" : y.toLocaleString(numberLocale, { minimumFractionDigits: 1, maximumFractionDigits: 1 });

// Fruit colours, shared by the canvas and the pillar cards (tier → colour).
const FRUIT_COLORS = ["#ff3366", "#ff6688", "#aa66dd", "#ffaa22", "#ff4444", "#ffdd44", "#44dd66", "#ff9a76"];

const strings = {
    lang: numberLocale,
    years: t("skills.card.years"),
    yearsShort: t("skills.card.yearsShort"),
    at: t("skills.card.at"),
    pillar: t("skills.card.pillar"),
    combo: t("skills.card.combo"),
    tryIt: t("skills.card.try"),
};
---

<div class="skills-slide">
    <div class="skills-copy">
        <div class="section-label reveal">{t("skills.label")}</div>
        <h2 class="section-heading skills-heading reveal reveal-delay-1">
            {t("skills.heading.before")}<span class="highlight">{t("skills.heading.highlight")}</span>{t("skills.heading.after")}
        </h2>
        <p class="skills-sub">{t("skills.sub")}</p>

        <div class="skills-pillars-label">{t("skills.pillars.label")}</div>
        <ol class="skills-pillars" aria-label={t("skills.pillars.label")}>
            {pillars.map((p) => (
                <li class="skills-pillar" data-skill={p.id} style={`--fruit: ${FRUIT_COLORS[p.tier]}`}>
                    <h3 class="skills-pillar-title"><span class="skills-pillar-dot" aria-hidden="true"></span>{p.label}</h3>
                    <p class="skills-pillar-value">{p.value}</p>
                    <p class="skills-pillar-proof">{p.proof}</p>
                    {p.proofSlug && p.proofTitle && (
                        <a class="skills-pillar-link" href={`#${p.proofSlug}`} data-project={p.proofSlug}>
                            {p.proofTitle}<span aria-hidden="true"> →</span>
                        </a>
                    )}
                </li>
            ))}
        </ol>
    </div>

    <div class="skills-stage">
        <canvas class="skills-canvas" role="img" aria-label={t("skills.aria.canvas")}></canvas>
        <div class="skills-card" hidden>
            <button type="button" class="skills-card-close" aria-label={t("skills.card.close")}>×</button>
            <div class="skills-card-kicker"></div>
            <div class="skills-card-title"></div>
            <p class="skills-card-body"></p>
            <p class="skills-card-proof"></p>
            <p class="skills-card-meta"></p>
            <a class="skills-card-link" href="#"></a>
        </div>
        <div class="skills-caption">
            <p class="skills-caption-text">{t("skills.caption")}</p>
            <p class="skills-caption-hint">
                <span>{t("skills.hint")}</span>
                <span class="skills-combos" aria-live="polite"><span data-combos-found>0</span>/{combos.length} {t("skills.combos.found")}</span>
            </p>
        </div>
    </div>

    {/* Screen readers, crawlers and print get the whole bowl as text. */}
    <ul class="sr-only skills-list" aria-label={t("skills.aria.list")}>
        {pillars.map((p) => (
            <li>{p.label}: {p.value} {p.proof}</li>
        ))}
        {tools.map((s) => (
            <li>{s.label}, {fmtYears(s.years)} {t("skills.card.years")} ({s.employers.join(", ")}): {s.value}</li>
        ))}
    </ul>

    <script
        type="application/json"
        class="skills-data"
        set:html={JSON.stringify({ skills, combos, strings, colors: FRUIT_COLORS })}
    />
</div>

<!-- Print fallback -->
<div class="skills-print-fallback">
    <div class="section-inner" style="text-align: center;">
        <div class="section-label">{t("skills.label")}</div>
        <h2 class="section-heading">{t("skills.heading.before")}<span class="highlight">{t("skills.heading.highlight")}</span>{t("skills.heading.after")}</h2>
        <div class="skills-cloud-print">
            {pillars.map((s) => <span class="skill-pill-print featured">{s.label}</span>)}
            {tools.map((s) => <span class="skill-pill-print">{s.label} · {fmtYears(s.years)} {t("skills.card.yearsShort")}</span>)}
        </div>
    </div>
</div>

<style>
    .skills-slide {
        position: absolute;
        inset: 0;
        display: grid;
        grid-template-columns: minmax(300px, 430px) minmax(0, 1fr);
        column-gap: clamp(28px, 4vw, 64px);
        max-width: 1280px;
        margin: 0 auto;
        padding: 64px clamp(56px, 6vw, 96px) 28px clamp(32px, 5vw, 80px);
    }

    .skills-copy {
        align-self: center;
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .skills-heading {
        font-size: clamp(32px, 4vw, 52px);
        margin-bottom: 12px;
    }

    .skills-sub {
        color: var(--text);
        font-size: 17px;
        line-height: 1.5;
        max-width: 34ch;
        margin-bottom: 22px;
    }

    .skills-pillars-label {
        font-family: var(--mono);
        font-size: 11px;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--text-muted);
        margin-bottom: 10px;
    }

    .skills-pillars {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .skills-pillar {
        position: relative;
        background: var(--bg-card);
        border: 1px solid var(--border);
        border-left: 3px solid var(--fruit);
        border-radius: 12px;
        padding: 12px 16px 12px 16px;
        transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
    }

    .skills-pillar.is-lit,
    .skills-pillar:hover {
        border-color: color-mix(in srgb, var(--fruit) 45%, var(--border));
        border-left-color: var(--fruit);
        box-shadow: 0 0 24px color-mix(in srgb, var(--fruit) 18%, transparent);
    }

    .skills-pillar-title {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 16px;
        font-weight: 700;
        line-height: 1.3;
        margin-bottom: 4px;
    }

    .skills-pillar-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--fruit);
        box-shadow: 0 0 8px var(--fruit);
        flex: none;
    }

    .skills-pillar-value {
        color: var(--text-dim);
        font-size: 14px;
        line-height: 1.45;
    }

    .skills-pillar-proof {
        font-size: 13px;
        line-height: 1.45;
        color: var(--text);
        margin-top: 6px;
    }

    .skills-pillar-link,
    .skills-card-link {
        display: inline-block;
        margin-top: 6px;
        font-family: var(--mono);
        font-size: 12px;
        color: var(--purple);
        text-decoration: none;
    }

    .skills-pillar-link:hover,
    .skills-card-link:hover { text-decoration: underline; }

    .skills-card-link[hidden] { display: none; }

    .skills-pillar-link:focus-visible,
    .skills-card-link:focus-visible,
    .skills-card-close:focus-visible {
        outline: 2px solid var(--purple);
        outline-offset: 2px;
        border-radius: 4px;
    }

    /* ── Stage: canvas + floating card + caption ── */
    .skills-stage {
        position: relative;
        min-width: 0;
        min-height: 0;
    }

    .skills-canvas {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        display: block;
        cursor: default;
        -webkit-touch-callout: none;
        -webkit-user-select: none;
        user-select: none;
        -webkit-tap-highlight-color: transparent;
    }

    .skills-canvas.poke { cursor: pointer; }
    .skills-canvas.grab { cursor: grab; }
    .skills-canvas.grabbing { cursor: grabbing; }

    .skills-card {
        --c: var(--purple);
        position: absolute;
        left: 0;
        top: 0;
        z-index: 2;
        width: min(320px, calc(100% - 16px));
        background: rgba(19, 19, 26, 0.96);
        border: 1px solid var(--border);
        border-left: 3px solid var(--c);
        border-radius: 12px;
        padding: 12px 34px 12px 16px;
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.55), 0 0 24px color-mix(in srgb, var(--c) 14%, transparent);
        backdrop-filter: blur(6px);
        pointer-events: none;
        opacity: 0;
        transform: translateY(6px);
        transition: opacity 0.18s ease, transform 0.18s ease;
    }

    .skills-card.is-open {
        opacity: 1;
        transform: none;
    }

    .skills-card.is-pinned { pointer-events: auto; }

    .skills-card[data-kind="combo"] {
        --c: #ffd166;
        background: linear-gradient(180deg, rgba(255, 209, 102, 0.08), rgba(19, 19, 26, 0.96) 60%);
    }

    .skills-card-close {
        position: absolute;
        top: 6px;
        right: 8px;
        width: 26px;
        height: 26px;
        border: 0;
        background: none;
        color: var(--text-dim);
        font-size: 18px;
        line-height: 1;
        cursor: pointer;
        display: none;
    }

    .skills-card.is-pinned .skills-card-close { display: block; }

    .skills-card-kicker {
        font-family: var(--mono);
        font-size: 11px;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        color: var(--c);
        margin-bottom: 4px;
    }

    .skills-card-title {
        font-size: 17px;
        font-weight: 700;
        line-height: 1.25;
        margin-bottom: 4px;
    }

    .skills-card-body {
        font-size: 14px;
        line-height: 1.45;
        color: var(--text);
    }

    .skills-card-proof {
        font-size: 13px;
        line-height: 1.45;
        color: var(--text-dim);
        margin-top: 6px;
    }

    .skills-card-meta {
        font-family: var(--mono);
        font-size: 11.5px;
        line-height: 1.5;
        color: var(--text-dim);
        margin-top: 8px;
    }

    .skills-card-proof:empty,
    .skills-card-meta:empty { display: none; }

    .skills-caption {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        text-align: center;
        pointer-events: none;
    }

    .skills-caption-text {
        font-size: 14px;
        color: var(--text-dim);
        line-height: 1.4;
    }

    .skills-caption-hint {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 4px 14px;
        margin-top: 4px;
        font-family: var(--mono);
        font-size: 11.5px;
        letter-spacing: 0.5px;
        color: var(--purple);
    }

    .skills-combos { color: var(--text-muted); }
    .skills-combos.has-found { color: #ffd166; }

    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    /* ── Narrow screens: stack copy over the bowl, pillars as a swipeable row ── */
    @media (max-width: 860px) {
        .skills-slide {
            grid-template-columns: minmax(0, 1fr);
            grid-template-rows: auto minmax(0, 1fr);
            padding: 36px 20px 14px;
            row-gap: 6px;
        }

        .skills-copy { align-self: start; }
        .skills-heading { font-size: 30px; margin-bottom: 6px; }
        .skills-sub { font-size: 14px; margin-bottom: 10px; max-width: 40ch; }
        .skills-pillars-label { display: none; }

        .skills-pillars {
            flex-direction: row;
            gap: 10px;
            overflow-x: auto;
            scroll-snap-type: x mandatory;
            scrollbar-width: none;
            margin: 0 -20px;
            padding: 0 20px 2px;
            scroll-padding: 0 20px;
        }

        .skills-pillars::-webkit-scrollbar { display: none; }

        .skills-pillar {
            flex: 0 0 78%;
            scroll-snap-align: start;
            padding: 10px 14px;
        }

        .skills-pillar-title { font-size: 15px; margin-bottom: 2px; }
        .skills-pillar-value { font-size: 13px; line-height: 1.4; }
        /* The proof lives in the fruit's card on phones (tap the big fruit). */
        .skills-pillar-proof { display: none; }
        .skills-pillar-link { margin-top: 4px; }

        .skills-card {
            width: auto;
            right: 0;
        }

        .skills-caption-text { font-size: 12px; }
        .skills-caption-hint { font-size: 10px; gap: 2px 10px; letter-spacing: 0; }
    }

    @media (max-width: 600px) {
        .skills-slide { padding-right: 28px; }
        .skills-pillars { margin-right: -28px; padding-right: 28px; }
    }

    /* Print */
    .skills-print-fallback { display: none; }
    @media print {
        .skills-slide { display: none !important; }
        .skills-print-fallback { display: block !important; }
        .skills-cloud-print {
            display: flex; flex-wrap: wrap; gap: 3px; justify-content: center;
        }
        .skill-pill-print {
            font-family: var(--mono); font-size: 8px; padding: 2px 6px;
            border-radius: 100px; border: 1px solid var(--border);
            color: var(--text-dim);
        }
        .skill-pill-print.featured {
            border-color: var(--purple-dim); color: var(--purple);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .skills-pillar,
        .skills-card { transition: none; }
    }
</style>

<script>
(function () {
    const root = document.querySelector<HTMLElement>('.skills-slide');
    if (!root) return;
    const stage = root.querySelector<HTMLElement>('.skills-stage')!;
    const canvas = root.querySelector<HTMLCanvasElement>('.skills-canvas')!;
    const card = root.querySelector<HTMLElement>('.skills-card')!;
    const ctx = canvas.getContext('2d')!;

    interface SkillData {
        id: string; label: string; pillar: boolean; tier: number;
        years: number | null; employers: string[]; value: string;
        proof: string | null; proofSlug: string | null; proofTitle: string | null;
    }
    interface ComboData {
        pair: [string, string]; title: string; body: string;
        slug: string | null; slugTitle: string | null;
    }
    const data: {
        skills: SkillData[]; combos: ComboData[]; colors: string[];
        strings: Record<'lang' | 'years' | 'yearsShort' | 'at' | 'pillar' | 'combo' | 'tryIt', string>;
    } = JSON.parse(root.querySelector('.skills-data')?.textContent || '{}');
    if (!data.skills?.length) return;
    const S = data.strings;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const fmtYears = (y: number) =>
        y.toLocaleString(S.lang, { minimumFractionDigits: 1, maximumFractionDigits: 1 });
    const skillById = new Map(data.skills.map((s) => [s.id, s]));
    const comboKey = (a: string, b: string) => [a, b].sort().join('+');
    const comboByKey = new Map(data.combos.map((c) => [comboKey(c.pair[0], c.pair[1]), c]));
    const foundCombos = new Set<string>();

    // Drop order: pillars first so they settle at the bottom, then tools by
    // years so the small ones land on top where their labels stay readable.
    const dropOrder = [
        ...data.skills.filter((s) => s.pillar),
        ...data.skills.filter((s) => !s.pillar).sort((a, b) => (b.years ?? 0) - (a.years ?? 0)),
    ];
    const DROP_X = [0.5, 0.2, 0.8, 0.38, 0.62, 0.14, 0.86, 0.5, 0.28, 0.72, 0.42, 0.58, 0.22];

    // ─── Fruit sizes: tools by tier (years), pillars all the same, biggest ───
    const TOOL_RADIUS = [30, 35, 41, 48, 56];
    const PILLAR_RADIUS = 66;
    const baseRadius = (s: SkillData) => (s.pillar ? PILLAR_RADIUS : TOOL_RADIUS[s.tier]);
    const GOLD = '#ffd166';

    // ─── Physics constants ───
    const GRAVITY = 900;
    const BOUNCE = 0.25;
    const AIR_DRAG = 0.998;
    const DT_CAP = 0.033;
    const MAX_SPEED = 1100;
    const FILL_INTERVAL = 230;
    const THROW_WINDOW = 1400;     // ms after release a thrown fruit can still make a combo
    const COMBO_COOLDOWN = 3500;
    const IDLE_BEFORE_DEMO = 2600; // ms after the bowl is full
    const IDLE_HOP_EVERY = 6500;
    const BOWL_STROKE = '#9b4dca';
    const BOWL_GLOW = 'rgba(155, 77, 202, 0.35)';

    interface Fruit {
        skill: SkillData;
        x: number; y: number; vx: number; vy: number;
        r: number; mass: number;
        grabbed: boolean;
        thrownAt: number;
        scaleAnim: number;
        flash: number; // 0..1 highlight pulse
    }
    interface Particle {
        x: number; y: number; vx: number; vy: number;
        life: number; maxLife: number; color: string; size: number;
    }
    interface Bowl {
        x: number; y: number; w: number; h: number;
        taperInset: number; cornerRadius: number;
        leftWall: { x1: number; y1: number; x2: number; y2: number };
        rightWall: { x1: number; y1: number; x2: number; y2: number };
        bottomWall: { x1: number; y1: number; x2: number; y2: number };
        bottom: number;
    }

    const fruits: Fruit[] = [];
    const particles: Particle[] = [];
    let bowl = {} as Bowl;
    let W = 0, H = 0, scale = 1, compact = false;
    let animId: number | null = null;
    let running = false;
    let fillIdx = 0;
    let lastFill = 0;
    let filledAt = 0;
    let userInteracted = false;
    let lastUserAction = 0;
    let lastHop = 0;
    let demoDone = false;
    let settling = false; // reduced motion: simulating off-screen, no combos
    const comboCooldown = new Map<string, number>();

    // Kinematic tween used by the one-time demo throw.
    let tween: { f: Fruit; target: Fruit; fx: number; fy: number; t0: number; dur: number } | null = null;

    // ─── Layout ───
    function resize() {
        const dpr = window.devicePixelRatio || 1;
        W = stage.clientWidth;
        H = stage.clientHeight;
        canvas.width = Math.round(W * dpr);
        canvas.height = Math.round(H * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        compact = W < 520;

        const caption = root.querySelector<HTMLElement>('.skills-caption');
        const captionH = (caption?.offsetHeight ?? 40) + (compact ? 10 : 18);
        const bw = Math.min(W - (compact ? 4 : 24), 640);
        const bh = Math.max(160, Math.min(H * (compact ? 0.8 : 0.7), 500, H - captionH - 40));
        const bx = (W - bw) / 2;
        const by = H - captionH - bh;
        const corner = 20;
        const taper = compact ? 10 : 18;
        bowl = {
            x: bx, y: by, w: bw, h: bh, taperInset: taper, cornerRadius: corner,
            leftWall: { x1: bx + taper, y1: by + bh - corner, x2: bx, y2: by },
            rightWall: { x1: bx + bw - taper, y1: by + bh - corner, x2: bx + bw, y2: by },
            bottomWall: { x1: bx + taper, y1: by + bh - corner, x2: bx + bw - taper, y2: by + bh - corner },
            bottom: by + bh - corner,
        };
        scale = Math.max(0.6, Math.min(1.12, bw / 540, bh / 400));
        for (const f of fruits) setRadius(f);
    }

    function setRadius(f: Fruit) {
        f.r = baseRadius(f.skill) * scale;
        f.mass = f.r * f.r;
    }

    function spawn(skill: SkillData, xFrac: number): Fruit {
        const f: Fruit = {
            skill, x: 0, y: 0, vx: 0, vy: 0, r: 0, mass: 0,
            grabbed: false, thrownAt: -Infinity, scaleAnim: 1, flash: 0,
        };
        setRadius(f);
        const inner = bowl.w - f.r * 2 - 8;
        f.x = bowl.x + f.r + 4 + inner * xFrac;
        f.y = f.r + 4;
        f.vy = 60;
        fruits.push(f);
        return f;
    }

    // ─── Particles ───
    function spawnParticles(x: number, y: number, color: string, count = 8, speed = 160) {
        for (let i = 0; i < count; i++) {
            const angle = (Math.PI * 2 / count) * i + (Math.random() - 0.5) * 0.5;
            const v = speed * (0.5 + Math.random() * 0.8);
            particles.push({
                x, y, vx: Math.cos(angle) * v, vy: Math.sin(angle) * v,
                life: 1, maxLife: 0.5 + Math.random() * 0.4, color, size: 2 + Math.random() * 3,
            });
        }
    }

    // ─── Collision helpers ───
    function circleLineCollision(cx: number, cy: number, r: number,
        x1: number, y1: number, x2: number, y2: number) {
        const dx = x2 - x1, dy = y2 - y1;
        const len2 = dx * dx + dy * dy;
        if (len2 === 0) return null;
        let t = ((cx - x1) * dx + (cy - y1) * dy) / len2;
        t = Math.max(0, Math.min(1, t));
        const distX = cx - (x1 + t * dx);
        const distY = cy - (y1 + t * dy);
        const dist = Math.sqrt(distX * distX + distY * distY);
        if (dist < r) {
            return { nx: dist > 0 ? distX / dist : 0, ny: dist > 0 ? distY / dist : -1, depth: r - dist };
        }
        return null;
    }

    function bounceOff(f: Fruit, hit: { nx: number; ny: number; depth: number } | null) {
        if (!hit) return false;
        f.x += hit.nx * hit.depth;
        f.y += hit.ny * hit.depth;
        const vDotN = f.vx * hit.nx + f.vy * hit.ny;
        if (vDotN < 0) {
            f.vx -= (1 + BOUNCE) * vDotN * hit.nx;
            f.vy -= (1 + BOUNCE) * vDotN * hit.ny;
        }
        return true;
    }

    /** Keep a fruit inside the bowl, or inside the column above it. Nothing escapes. */
    function confine(f: Fruit) {
        bounceOff(f, circleLineCollision(f.x, f.y, f.r, bowl.leftWall.x1, bowl.leftWall.y1, bowl.leftWall.x2, bowl.leftWall.y2));
        bounceOff(f, circleLineCollision(f.x, f.y, f.r, bowl.rightWall.x1, bowl.rightWall.y1, bowl.rightWall.x2, bowl.rightWall.y2));
        if (bounceOff(f, circleLineCollision(f.x, f.y, f.r, bowl.bottomWall.x1, bowl.bottomWall.y1, bowl.bottomWall.x2, bowl.bottomWall.y2))) {
            f.vx *= 0.9;
        }
        if (f.y + f.r > bowl.bottom) {
            f.y = bowl.bottom - f.r;
            if (f.vy > 0) f.vy = -f.vy * BOUNCE;
            f.vx *= 0.9;
        }
        // Side bounds: tapered inside the bowl, straight walls in the column above.
        const t = Math.max(0, Math.min(1, (f.y - bowl.y) / (bowl.bottom - bowl.y)));
        const left = bowl.x + bowl.taperInset * t + f.r;
        const right = bowl.x + bowl.w - bowl.taperInset * t - f.r;
        if (f.x < left) { f.x = left; if (f.vx < 0) f.vx = -f.vx * BOUNCE; }
        if (f.x > right) { f.x = right; if (f.vx > 0) f.vx = -f.vx * BOUNCE; }
        // Ceiling: thrown fruit never leaves the stage (so never covers the heading).
        if (f.y - f.r < 2) { f.y = f.r + 2; if (f.vy < 0) f.vy = -f.vy * BOUNCE; }
    }

    function clampVelocity(f: Fruit) {
        const speed = Math.hypot(f.vx, f.vy);
        if (speed > MAX_SPEED) { f.vx *= MAX_SPEED / speed; f.vy *= MAX_SPEED / speed; }
    }

    const isActive = (f: Fruit, now: number) => f.grabbed || now - f.thrownAt < THROW_WINDOW;

    // ─── Physics step ───
    function step(dt: number, now: number) {
        for (let i = particles.length - 1; i >= 0; i--) {
            const p = particles[i];
            p.x += p.vx * dt; p.y += p.vy * dt; p.vy += 260 * dt;
            p.life -= dt / p.maxLife;
            if (p.life <= 0) particles.splice(i, 1);
        }

        for (const f of fruits) {
            if (f.scaleAnim > 1.005) f.scaleAnim += (1 - f.scaleAnim) * 8 * dt;
            else f.scaleAnim = 1;
            if (f.flash > 0) f.flash = Math.max(0, f.flash - dt * 0.9);
            if (f.grabbed) continue;
            f.vy += GRAVITY * dt;
            f.vx *= AIR_DRAG; f.vy *= AIR_DRAG;
            clampVelocity(f);
            f.x += f.vx * dt; f.y += f.vy * dt;
            confine(f);
        }

        for (let iter = 0; iter < 4; iter++) {
            for (let i = 0; i < fruits.length; i++) {
                const a = fruits[i];
                for (let j = i + 1; j < fruits.length; j++) {
                    const b = fruits[j];
                    const dx = b.x - a.x, dy = b.y - a.y;
                    const dist = Math.sqrt(dx * dx + dy * dy);
                    const minDist = a.r + b.r;
                    if (dist >= minDist) continue;
                    const overlap = minDist - dist;
                    const nx = dist > 0 ? dx / dist : 0;
                    const ny = dist > 0 ? dy / dist : -1;

                    if (iter === 0 && !settling && (isActive(a, now) || isActive(b, now))) {
                        tryCombo(a, b, now);
                    }

                    if (a.grabbed && b.grabbed) continue;
                    if (a.grabbed) { b.x += nx * overlap; b.y += ny * overlap; }
                    else if (b.grabbed) { a.x -= nx * overlap; a.y -= ny * overlap; }
                    else {
                        const total = a.mass + b.mass;
                        a.x -= nx * overlap * (b.mass / total); a.y -= ny * overlap * (b.mass / total);
                        b.x += nx * overlap * (a.mass / total); b.y += ny * overlap * (a.mass / total);
                    }

                    if (iter === 0) {
                        if (a.grabbed || b.grabbed) {
                            const other = a.grabbed ? b : a;
                            const sign = a.grabbed ? 1 : -1;
                            other.vx += nx * sign * 120; other.vy += ny * sign * 120;
                        } else {
                            const dvDotN = (a.vx - b.vx) * nx + (a.vy - b.vy) * ny;
                            if (dvDotN > 0) {
                                const impulse = (1 + BOUNCE) * dvDotN / (a.mass + b.mass);
                                a.vx -= impulse * b.mass * nx; a.vy -= impulse * b.mass * ny;
                                b.vx += impulse * a.mass * nx; b.vy += impulse * a.mass * ny;
                            }
                        }
                    }
                }
            }
            for (const f of fruits) if (!f.grabbed) confine(f);
        }
    }

    // ─── Combos ───
    function tryCombo(a: Fruit, b: Fruit, now: number) {
        const key = comboKey(a.skill.id, b.skill.id);
        const combo = comboByKey.get(key);
        if (!combo) return;
        if (now - (comboCooldown.get(key) ?? -Infinity) < COMBO_COOLDOWN) return;
        comboCooldown.set(key, now);
        const mx = (a.x * b.r + b.x * a.r) / (a.r + b.r);
        const my = (a.y * b.r + b.y * a.r) / (a.r + b.r);
        spawnParticles(mx, my, GOLD, 14, 240);
        spawnParticles(mx, my, data.colors[a.skill.tier], 5, 160);
        spawnParticles(mx, my, data.colors[b.skill.tier], 5, 160);
        a.flash = 1; b.flash = 1;
        a.scaleAnim = 1.12; b.scaleAnim = 1.12;
        foundCombos.add(key);
        updateComboCounter();
        const anchor = a.y < b.y ? a : b;
        showCard({ kind: 'combo', combo, fruit: anchor, pinned: true, autoHide: tween ? 6500 : 0 });
    }

    function updateComboCounter() {
        const el = root.querySelector('[data-combos-found]');
        if (el) el.textContent = String(foundCombos.size);
        root.querySelector('.skills-combos')?.classList.toggle('has-found', foundCombos.size > 0);
    }

    // ─── Floating card ───
    type CardState =
        | { kind: 'skill'; fruit: Fruit; pinned: boolean; autoHide?: number }
        | { kind: 'combo'; combo: ComboData; fruit: Fruit; pinned: boolean; autoHide?: number };
    let cardState: CardState | null = null;
    let cardHideTimer = 0;
    const cardEls = {
        kicker: card.querySelector<HTMLElement>('.skills-card-kicker')!,
        title: card.querySelector<HTMLElement>('.skills-card-title')!,
        body: card.querySelector<HTMLElement>('.skills-card-body')!,
        proof: card.querySelector<HTMLElement>('.skills-card-proof')!,
        meta: card.querySelector<HTMLElement>('.skills-card-meta')!,
        link: card.querySelector<HTMLAnchorElement>('.skills-card-link')!,
    };

    function setLink(slug: string | null, title: string | null) {
        if (slug && title) {
            cardEls.link.hidden = false;
            cardEls.link.href = '#' + slug;
            cardEls.link.dataset.project = slug;
            cardEls.link.textContent = title + ' →';
        } else {
            cardEls.link.hidden = true;
            delete cardEls.link.dataset.project;
        }
    }

    function partnersOf(id: string): string[] {
        return data.combos
            .filter((c) => c.pair.includes(id))
            .map((c) => {
                const other = c.pair[0] === id ? c.pair[1] : c.pair[0];
                const done = foundCombos.has(comboKey(c.pair[0], c.pair[1]));
                return (skillById.get(other)?.label ?? other) + (done ? ' ✓' : '');
            });
    }

    function showCard(state: CardState) {
        clearTimeout(cardHideTimer);
        cardState = state;
        if (state.kind === 'skill') {
            const s = state.fruit.skill;
            card.dataset.kind = s.pillar ? 'pillar' : 'tool';
            card.style.setProperty('--c', data.colors[s.tier]);
            cardEls.kicker.textContent = s.pillar ? S.pillar : `${fmtYears(s.years ?? 0)} ${S.years}`;
            cardEls.title.textContent = s.label;
            cardEls.body.textContent = s.value;
            cardEls.proof.textContent = s.pillar ? (s.proof ?? '') : '';
            const meta: string[] = [];
            if (!s.pillar && s.employers.length) meta.push(`${S.at}: ${s.employers.join(' · ')}`);
            const partners = partnersOf(s.id);
            if (partners.length) meta.push(`${S.tryIt}: ${partners.join(', ')}`);
            cardEls.meta.textContent = meta.join('\n');
            setLink(s.pillar ? s.proofSlug : null, s.pillar ? s.proofTitle : null);
            lightPillar(s.pillar ? s.id : null);
        } else {
            const c = state.combo;
            card.dataset.kind = 'combo';
            card.style.removeProperty('--c');
            const [a, b] = c.pair.map((id) => skillById.get(id)?.label ?? id);
            cardEls.kicker.textContent = `${S.combo}: ${a} + ${b}`;
            cardEls.title.textContent = c.title;
            cardEls.body.textContent = c.body;
            cardEls.proof.textContent = '';
            cardEls.meta.textContent = '';
            setLink(c.slug, c.slugTitle);
            lightPillar(null);
        }
        cardEls.meta.style.whiteSpace = 'pre-line';
        card.hidden = false;
        card.classList.toggle('is-pinned', state.pinned);
        positionCard();
        requestAnimationFrame(() => card.classList.add('is-open'));
        if (state.autoHide) {
            cardHideTimer = window.setTimeout(() => {
                if (!card.matches(':hover')) hideCard();
            }, state.autoHide);
        }
        if (reducedMotion) draw();
    }

    function hideCard() {
        clearTimeout(cardHideTimer);
        cardState = null;
        card.classList.remove('is-open', 'is-pinned');
        lightPillar(null);
        window.setTimeout(() => { if (!cardState) card.hidden = true; }, 200);
        if (reducedMotion) draw();
    }

    function positionCard() {
        if (!cardState || card.hidden) return;
        const f = cardState.fruit;
        if (compact) {
            // Phones: a full-width card at the top of the stage, away from the thumb.
            card.style.left = '0px';
            card.style.top = '0px';
            return;
        }
        const cw = card.offsetWidth, ch = card.offsetHeight;
        let x = f.x - cw / 2;
        let y = f.y - f.r - ch - 14;
        x = Math.max(4, Math.min(W - cw - 4, x));
        if (y < 4) y = Math.min(H - ch - 4, f.y + f.r + 14);
        card.style.left = `${Math.round(x)}px`;
        card.style.top = `${Math.round(Math.max(4, y))}px`;
    }

    function lightPillar(id: string | null) {
        root.querySelectorAll<HTMLElement>('.skills-pillar').forEach((el) => {
            el.classList.toggle('is-lit', el.dataset.skill === id);
        });
    }

    // ─── Drawing ───
    // ─── Draw fruit shapes — Suika-style round circles ───
    function drawCherry(x: number, y: number, r: number) {
        // Cherry: solid round red ball with stem + tiny leaf
        const grad = ctx.createRadialGradient(x - r * 0.3, y - r * 0.3, r * 0.1, x, y, r);
        grad.addColorStop(0, '#ff6666');
        grad.addColorStop(0.5, '#dd1133');
        grad.addColorStop(1, '#880011');
        ctx.beginPath();
        ctx.arc(x, y, r, 0, Math.PI * 2);
        ctx.fillStyle = grad;
        ctx.fill();
        // Stem
        ctx.strokeStyle = '#3a6622';
        ctx.lineWidth = Math.max(1.5, r * 0.07);
        ctx.lineCap = 'round';
        ctx.beginPath();
        ctx.moveTo(x, y - r * 0.85);
        ctx.quadraticCurveTo(x + r * 0.15, y - r * 1.15, x + r * 0.1, y - r * 1.05);
        ctx.stroke();
        // Tiny leaf
        ctx.beginPath();
        ctx.ellipse(x + r * 0.18, y - r * 0.95, r * 0.15, r * 0.06, 0.4, 0, Math.PI * 2);
        ctx.fillStyle = '#44aa44';
        ctx.fill();
        // Highlight
        ctx.beginPath();
        ctx.arc(x - r * 0.25, y - r * 0.3, r * 0.2, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(255,255,255,0.3)';
        ctx.fill();
    }

    function drawStrawberry(x: number, y: number, r: number) {
        // Strawberry: round red/pink ball with yellow seed dots + green cap
        const grad = ctx.createRadialGradient(x - r * 0.2, y - r * 0.2, r * 0.1, x, y, r);
        grad.addColorStop(0, '#ff7788');
        grad.addColorStop(0.5, '#ee2244');
        grad.addColorStop(1, '#aa1133');
        ctx.beginPath();
        ctx.arc(x, y, r, 0, Math.PI * 2);
        ctx.fillStyle = grad;
        ctx.fill();
        // Seeds — tiny yellow dots scattered on surface
        ctx.save();
        ctx.beginPath();
        ctx.arc(x, y, r, 0, Math.PI * 2);
        ctx.clip();
        ctx.fillStyle = '#ffdd66';
        const seedPositions = [
            [-0.35, -0.3], [0.3, -0.35], [-0.5, 0.05], [0.45, 0.1],
            [-0.15, 0.1], [0.15, -0.1], [-0.3, 0.4], [0.35, 0.35],
            [0.0, 0.5], [0.0, -0.5], [-0.5, -0.15], [0.5, -0.1],
        ];
        for (const [sx, sy] of seedPositions) {
            ctx.beginPath();
            ctx.arc(x + r * sx, y + r * sy, r * 0.04, 0, Math.PI * 2);
            ctx.fill();
        }
        ctx.restore();
        // Green cap at top — small spiky leaves
        ctx.fillStyle = '#33aa44';
        for (let i = 0; i < 5; i++) {
            const angle = -Math.PI / 2 + (i - 2) * 0.4;
            ctx.beginPath();
            ctx.ellipse(
                x + Math.cos(angle) * r * 0.1,
                y - r * 0.85 + Math.sin(angle) * r * 0.05,
                r * 0.2, r * 0.07,
                angle + Math.PI / 2, 0, Math.PI * 2
            );
            ctx.fill();
        }
        // Highlight
        ctx.beginPath();
        ctx.arc(x - r * 0.25, y - r * 0.3, r * 0.18, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(255,255,255,0.22)';
        ctx.fill();
    }

    function drawGrape(x: number, y: number, r: number) {
        // Grape: round purple ball with subtle shine + tiny stem
        const grad = ctx.createRadialGradient(x - r * 0.3, y - r * 0.3, r * 0.05, x, y, r);
        grad.addColorStop(0, '#cc88ff');
        grad.addColorStop(0.4, '#8844cc');
        grad.addColorStop(1, '#441166');
        ctx.beginPath();
        ctx.arc(x, y, r, 0, Math.PI * 2);
        ctx.fillStyle = grad;
        ctx.fill();
        // Stem
        ctx.strokeStyle = '#5a3a1a';
        ctx.lineWidth = Math.max(1.5, r * 0.06);
        ctx.lineCap = 'round';
        ctx.beginPath();
        ctx.moveTo(x, y - r * 0.9);
        ctx.lineTo(x + r * 0.05, y - r * 1.1);
        ctx.stroke();
        // Highlight — glossy reflection
        ctx.beginPath();
        ctx.ellipse(x - r * 0.25, y - r * 0.3, r * 0.15, r * 0.25, -0.3, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(255,255,255,0.25)';
        ctx.fill();
        // Secondary small highlight
        ctx.beginPath();
        ctx.arc(x - r * 0.15, y - r * 0.45, r * 0.08, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(255,255,255,0.15)';
        ctx.fill();
    }

    function drawOrange(x: number, y: number, r: number) {
        // Orange: round, textured peel, small navel at bottom, leaf on top
        const grad = ctx.createRadialGradient(x - r * 0.25, y - r * 0.25, r * 0.1, x, y, r);
        grad.addColorStop(0, '#ffcc44');
        grad.addColorStop(0.4, '#ff9900');
        grad.addColorStop(1, '#cc6600');
        ctx.beginPath();
        ctx.arc(x, y, r, 0, Math.PI * 2);
        ctx.fillStyle = grad;
        ctx.fill();
        // Peel texture — subtle bumpy dots
        ctx.save();
        ctx.beginPath();
        ctx.arc(x, y, r, 0, Math.PI * 2);
        ctx.clip();
        ctx.globalAlpha *= 0.12;
        for (let i = 0; i < 30; i++) {
            const angle = (Math.PI * 2 / 30) * i + (i % 2) * 0.1;
            const dist = r * (0.2 + (i % 3) * 0.25);
            ctx.beginPath();
            ctx.arc(x + Math.cos(angle) * dist, y + Math.sin(angle) * dist, r * 0.04, 0, Math.PI * 2);
            ctx.fillStyle = '#ffeecc';
            ctx.fill();
        }
        ctx.restore();
        // Navel at bottom
        ctx.beginPath();
        ctx.arc(x, y + r * 0.7, r * 0.1, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(180,100,0,0.3)';
        ctx.fill();
        // Small leaf + stem at top (kept within circle area)
        ctx.strokeStyle = '#3a6622';
        ctx.lineWidth = Math.max(1.5, r * 0.06);
        ctx.beginPath();
        ctx.moveTo(x, y - r * 0.85);
        ctx.lineTo(x, y - r * 0.95);
        ctx.stroke();
        ctx.beginPath();
        ctx.ellipse(x + r * 0.1, y - r * 0.9, r * 0.12, r * 0.06, 0.4, 0, Math.PI * 2);
        ctx.fillStyle = '#44aa44';
        ctx.fill();
        // Highlight
        ctx.beginPath();
        ctx.arc(x - r * 0.25, y - r * 0.3, r * 0.2, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(255,255,255,0.18)';
        ctx.fill();
    }

    function drawApple(x: number, y: number, r: number) {
        // Apple: round red ball with top indent shadow, small stem + leaf inside circle
        const grad = ctx.createRadialGradient(x - r * 0.3, y - r * 0.2, r * 0.1, x, y + r * 0.1, r);
        grad.addColorStop(0, '#ff6666');
        grad.addColorStop(0.4, '#dd2233');
        grad.addColorStop(0.8, '#aa1122');
        grad.addColorStop(1, '#771111');
        ctx.beginPath();
        ctx.arc(x, y, r, 0, Math.PI * 2);
        ctx.fillStyle = grad;
        ctx.fill();
        // Top indent (darker shadow)
        ctx.save();
        ctx.beginPath();
        ctx.arc(x, y, r, 0, Math.PI * 2);
        ctx.clip();
        ctx.beginPath();
        ctx.ellipse(x, y - r * 0.8, r * 0.35, r * 0.2, 0, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(0,0,0,0.25)';
        ctx.fill();
        // Bottom bump
        ctx.beginPath();
        ctx.ellipse(x, y + r * 0.85, r * 0.2, r * 0.1, 0, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(0,0,0,0.1)';
        ctx.fill();
        ctx.restore();
        // Stem (short, inside circle)
        ctx.strokeStyle = '#5a3a1a';
        ctx.lineWidth = Math.max(2, r * 0.05);
        ctx.lineCap = 'round';
        ctx.beginPath();
        ctx.moveTo(x, y - r * 0.8);
        ctx.lineTo(x + r * 0.03, y - r * 0.92);
        ctx.stroke();
        // Leaf (small, inside circle)
        ctx.beginPath();
        ctx.moveTo(x + r * 0.05, y - r * 0.85);
        ctx.quadraticCurveTo(x + r * 0.3, y - r * 0.98, x + r * 0.25, y - r * 0.78);
        ctx.quadraticCurveTo(x + r * 0.15, y - r * 0.85, x + r * 0.05, y - r * 0.85);
        ctx.fillStyle = '#33aa33';
        ctx.fill();
        // Highlight
        ctx.beginPath();
        ctx.ellipse(x - r * 0.3, y - r * 0.2, r * 0.15, r * 0.25, -0.3, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(255,255,255,0.2)';
        ctx.fill();
    }

    function drawPineapple(x: number, y: number, r: number) {
        // Pineapple: round golden ball with crosshatch pattern, green crown inside circle
        const grad = ctx.createRadialGradient(x - r * 0.15, y - r * 0.1, r * 0.2, x, y, r);
        grad.addColorStop(0, '#ffdd55');
        grad.addColorStop(0.5, '#ddaa22');
        grad.addColorStop(1, '#aa7711');
        ctx.beginPath();
        ctx.arc(x, y, r, 0, Math.PI * 2);
        ctx.fillStyle = grad;
        ctx.fill();
        // Diamond crosshatch pattern
        ctx.save();
        ctx.beginPath();
        ctx.arc(x, y, r, 0, Math.PI * 2);
        ctx.clip();
        ctx.strokeStyle = 'rgba(150,90,10,0.3)';
        ctx.lineWidth = 1;
        for (let i = -6; i <= 6; i++) {
            ctx.beginPath();
            ctx.moveTo(x + i * r * 0.25 - r, y - r);
            ctx.lineTo(x + i * r * 0.25 + r, y + r * 1.2);
            ctx.stroke();
        }
        for (let i = -6; i <= 6; i++) {
            ctx.beginPath();
            ctx.moveTo(x + i * r * 0.25 + r, y - r);
            ctx.lineTo(x + i * r * 0.25 - r, y + r * 1.2);
            ctx.stroke();
        }
        ctx.restore();
        // Crown — small green leaves at top, kept inside circle
        const crownLeaves = 5;
        for (let i = 0; i < crownLeaves; i++) {
            const angle = -Math.PI / 2 + (i - (crownLeaves - 1) / 2) * 0.25;
            const leafLen = r * (0.35 + (i % 2) * 0.1);
            ctx.beginPath();
            ctx.moveTo(x + Math.cos(angle + 0.06) * r * 0.1, y - r * 0.85);
            ctx.quadraticCurveTo(
                x + Math.cos(angle) * leafLen * 0.5,
                y - r * 0.85 + Math.sin(angle) * leafLen * 0.5,
                x + Math.cos(angle) * leafLen,
                y - r * 0.85 + Math.sin(angle) * leafLen
            );
            ctx.quadraticCurveTo(
                x + Math.cos(angle) * leafLen * 0.4,
                y - r * 0.85 + Math.sin(angle) * leafLen * 0.4 + r * 0.04,
                x + Math.cos(angle - 0.06) * r * 0.1,
                y - r * 0.85
            );
            ctx.fillStyle = i % 2 === 0 ? '#33aa33' : '#44bb44';
            ctx.fill();
        }
        // Highlight
        ctx.beginPath();
        ctx.arc(x - r * 0.2, y - r * 0.15, r * 0.15, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(255,255,255,0.15)';
        ctx.fill();
    }

    function drawWatermelon(x: number, y: number, r: number) {
        // Watermelon EXTERIOR: dark green base with lighter green stripes
        // Base — dark green
        const baseGrad = ctx.createRadialGradient(x - r * 0.2, y - r * 0.2, r * 0.1, x, y, r);
        baseGrad.addColorStop(0, '#3a8a4a');
        baseGrad.addColorStop(0.5, '#2a6e35');
        baseGrad.addColorStop(1, '#1a4a22');
        ctx.beginPath();
        ctx.arc(x, y, r, 0, Math.PI * 2);
        ctx.fillStyle = baseGrad;
        ctx.fill();
        // Lighter green stripes curving from top to bottom
        ctx.save();
        ctx.beginPath();
        ctx.arc(x, y, r, 0, Math.PI * 2);
        ctx.clip();
        ctx.strokeStyle = '#4aaa5a';
        ctx.lineWidth = r * 0.12;
        ctx.lineCap = 'round';
        const stripeCount = 8;
        for (let i = 0; i < stripeCount; i++) {
            const baseAngle = (Math.PI * 2 / stripeCount) * i;
            ctx.beginPath();
            ctx.moveTo(x, y - r * 0.15);
            // Curve outward from near-top toward bottom
            const cx1 = x + Math.cos(baseAngle) * r * 0.7;
            const cy1 = y + Math.sin(baseAngle) * r * 0.7;
            const ex = x + Math.cos(baseAngle) * r * 1.15;
            const ey = y + Math.sin(baseAngle) * r * 1.15;
            ctx.quadraticCurveTo(cx1, cy1, ex, ey);
            ctx.stroke();
        }
        ctx.restore();
        // Small stem dimple at top
        ctx.beginPath();
        ctx.arc(x, y - r * 0.85, r * 0.08, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(90,60,20,0.5)';
        ctx.fill();
        // Highlight
        ctx.beginPath();
        ctx.ellipse(x - r * 0.3, y - r * 0.25, r * 0.15, r * 0.22, -0.3, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(255,255,255,0.12)';
        ctx.fill();
    }

    function drawPeach(x: number, y: number, r: number) {
        const grad = ctx.createRadialGradient(x - r * 0.3, y - r * 0.3, r * 0.1, x, y, r);
        grad.addColorStop(0, '#ffd6b0');
        grad.addColorStop(0.45, '#ff9a76');
        grad.addColorStop(1, '#c4504a');
        ctx.beginPath();
        ctx.arc(x, y, r, 0, Math.PI * 2);
        ctx.fillStyle = grad;
        ctx.fill();
        // Crease
        ctx.save();
        ctx.beginPath();
        ctx.arc(x, y, r, 0, Math.PI * 2);
        ctx.clip();
        ctx.strokeStyle = 'rgba(150, 50, 40, 0.28)';
        ctx.lineWidth = Math.max(1.5, r * 0.05);
        ctx.beginPath();
        ctx.moveTo(x + r * 0.05, y - r * 0.9);
        ctx.quadraticCurveTo(x + r * 0.4, y, x + r * 0.05, y + r * 0.95);
        ctx.stroke();
        ctx.restore();
        // Leaf
        ctx.beginPath();
        ctx.ellipse(x + r * 0.2, y - r * 0.88, r * 0.2, r * 0.08, -0.5, 0, Math.PI * 2);
        ctx.fillStyle = '#44aa44';
        ctx.fill();
        // Highlight
        ctx.beginPath();
        ctx.ellipse(x - r * 0.32, y - r * 0.28, r * 0.16, r * 0.24, -0.4, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(255,255,255,0.22)';
        ctx.fill();
    }

    const DRAWERS = [drawCherry, drawStrawberry, drawGrape, drawOrange, drawApple, drawPineapple, drawWatermelon, drawPeach];

    function drawBowl() {
        const { x, y, w, h, cornerRadius: cr, taperInset: ti } = bowl;
        ctx.save();
        ctx.shadowColor = BOWL_GLOW;
        ctx.shadowBlur = 20;
        ctx.strokeStyle = BOWL_STROKE;
        ctx.lineWidth = 3;
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';
        ctx.beginPath();
        ctx.moveTo(x, y);
        ctx.lineTo(x + ti, y + h - cr);
        ctx.quadraticCurveTo(x + ti, y + h, x + ti + cr, y + h);
        ctx.lineTo(x + w - ti - cr, y + h);
        ctx.quadraticCurveTo(x + w - ti, y + h, x + w - ti, y + h - cr);
        ctx.lineTo(x + w, y);
        ctx.stroke();
        ctx.restore();
    }

    function drawFruitBody(f: Fruit, now: number) {
        const r = f.r * f.scaleAnim;
        const color = data.colors[f.skill.tier];
        ctx.save();
        if (f.skill.pillar) {
            // Gold halo: "this is what I sell".
            const pulse = 0.5 + 0.5 * Math.sin(now / 700 + f.skill.tier);
            ctx.beginPath();
            ctx.arc(f.x, f.y, r + 5 * scale, 0, Math.PI * 2);
            ctx.strokeStyle = GOLD;
            ctx.globalAlpha = 0.55 + 0.25 * pulse;
            ctx.lineWidth = 2;
            ctx.shadowColor = GOLD;
            ctx.shadowBlur = 14;
            ctx.stroke();
            ctx.globalAlpha = 1;
        }
        ctx.shadowColor = color;
        ctx.shadowBlur = 12 + f.flash * 30;
        DRAWERS[f.skill.tier](f.x, f.y, r);
        if (f.flash > 0) {
            ctx.beginPath();
            ctx.arc(f.x, f.y, r + 2, 0, Math.PI * 2);
            ctx.strokeStyle = GOLD;
            ctx.globalAlpha = f.flash;
            ctx.lineWidth = 3;
            ctx.stroke();
        }
        ctx.restore();
    }

    function wrapLabel(text: string, maxW: number): string[] {
        if (ctx.measureText(text).width <= maxW) return [text];
        // Prefer breaking after " / " or "-" or a space, whichever balances best.
        const breaks: number[] = [];
        for (let i = 1; i < text.length - 1; i++) {
            if (text[i] === ' ' || text[i - 1] === '-') breaks.push(i);
        }
        let best: string[] = [text];
        let bestW = Infinity;
        for (const i of breaks) {
            const a = text.slice(0, i).trimEnd();
            const b = text.slice(i).trimStart();
            const w = Math.max(ctx.measureText(a).width, ctx.measureText(b).width);
            if (w < bestW) { bestW = w; best = [a, b]; }
        }
        return best;
    }

    function drawLabel(f: Fruit, focused: boolean) {
        const s = f.skill;
        const pill = s.pillar;
        const nameSize = compact ? (pill ? 13 : 11) : Math.round((pill ? 15 : 12.5) * Math.max(0.86, scale));
        const nameFont = `${pill ? 700 : 600} ${nameSize}px Inter, system-ui, sans-serif`;
        const subFont = `500 ${compact ? 9.5 : 10.5}px "JetBrains Mono", monospace`;
        ctx.save();
        ctx.font = nameFont;
        const lines = wrapLabel(s.label, compact ? Math.max(f.r * 1.6, 54) : Math.max(f.r * 1.7, 64));
        const sub = pill ? '' : `${fmtYears(s.years ?? 0)} ${S.yearsShort}`;
        const lineH = nameSize * 1.15;
        const subH = sub ? nameSize * 0.95 : 0;
        let textW = Math.max(...lines.map((l) => ctx.measureText(l).width));
        if (sub) { ctx.font = subFont; textW = Math.max(textW, ctx.measureText(sub).width); }
        const padX = 6, padY = 3;
        const boxW = textW + padX * 2;
        const boxH = lines.length * lineH + subH + padY * 2;
        // Keep the label on the canvas even when the fruit hugs the edge.
        const bx = Math.max(2, Math.min(W - boxW - 2, f.x - boxW / 2));
        const by = f.y - boxH / 2;
        const cx = bx + boxW / 2;
        ctx.globalAlpha = focused ? 0.95 : 0.78;
        ctx.fillStyle = '#0a0a0f';
        ctx.beginPath();
        ctx.roundRect(bx, by, boxW, boxH, Math.min(7, boxH / 2));
        ctx.fill();
        if (focused) {
            ctx.strokeStyle = pill ? GOLD : data.colors[s.tier];
            ctx.lineWidth = 1.5;
            ctx.globalAlpha = 1;
            ctx.stroke();
        }
        ctx.globalAlpha = 1;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.font = nameFont;
        ctx.fillStyle = '#ffffff';
        lines.forEach((l, i) => ctx.fillText(l, cx, by + padY + lineH * (i + 0.5)));
        if (sub) {
            ctx.font = subFont;
            ctx.fillStyle = '#b8b8cc';
            ctx.fillText(sub, cx, by + padY + lines.length * lineH + subH * 0.5);
        }
        ctx.restore();
    }

    function drawParticles() {
        for (const p of particles) {
            ctx.save();
            ctx.globalAlpha = Math.max(0, p.life);
            ctx.shadowColor = p.color;
            ctx.shadowBlur = 8;
            ctx.fillStyle = p.color;
            ctx.beginPath();
            ctx.arc(p.x, p.y, Math.max(0.1, p.size * p.life), 0, Math.PI * 2);
            ctx.fill();
            ctx.restore();
        }
    }

    function draw(now = performance.now()) {
        ctx.clearRect(0, 0, W, H);
        drawBowl();
        for (const f of fruits) drawFruitBody(f, now);
        // Labels in a second pass so no fruit ever covers another fruit's name;
        // the focused one goes last so it's always on top.
        const focus = cardState?.fruit ?? hoverFruit ?? null;
        for (const f of fruits) if (f !== focus) drawLabel(f, false);
        if (focus && fruits.includes(focus)) drawLabel(focus, true);
        drawParticles();
    }

    // ─── Input ───
    let hoverFruit: Fruit | null = null;
    let press: {
        fruit: Fruit | null; x: number; y: number; t: number;
        offX: number; offY: number; dragging: boolean; touch: boolean; decided: boolean;
    } | null = null;
    let lastPX = 0, lastPY = 0, lastPT = 0, velX = 0, velY = 0;
    let longPressTimer = 0;

    function pos(e: MouseEvent | Touch) {
        const rect = canvas.getBoundingClientRect();
        return { x: e.clientX - rect.left, y: e.clientY - rect.top };
    }

    function hitTest(x: number, y: number, slop = 0): Fruit | null {
        // Smallest first wins, so a cherry sitting on a pillar is still grabbable.
        let best: Fruit | null = null;
        for (const f of fruits) {
            const d = Math.hypot(x - f.x, y - f.y);
            if (d <= f.r + slop && (!best || f.r < best.r)) best = f;
        }
        return best;
    }

    const inBowlColumn = (x: number, y: number) =>
        x >= bowl.x - 10 && x <= bowl.x + bowl.w + 10 && y <= bowl.y + bowl.h + 10;

    function markUser() {
        userInteracted = true;
        lastUserAction = performance.now();
        if (tween) { tween.f.grabbed = false; tween = null; }
    }

    function startDrag() {
        if (!press?.fruit || reducedMotion) return;
        press.dragging = true;
        press.fruit.grabbed = true;
        press.fruit.vx = 0; press.fruit.vy = 0;
        press.fruit.scaleAnim = 1.08;
        canvas.classList.add('grabbing');
        markUser();
    }

    function moveDrag(x: number, y: number) {
        if (!press?.dragging || !press.fruit) return;
        const now = performance.now();
        const dt = Math.max(1, now - lastPT) / 1000;
        velX = velX * 0.5 + ((x - lastPX) / dt) * 0.5;
        velY = velY * 0.5 + ((y - lastPY) / dt) * 0.5;
        lastPX = x; lastPY = y; lastPT = now;
        const f = press.fruit;
        f.x = Math.max(bowl.x + f.r, Math.min(bowl.x + bowl.w - f.r, x - press.offX));
        f.y = Math.max(f.r + 2, Math.min(bowl.bottom - f.r, y - press.offY));
        if (cardState && !cardState.pinned) hideCard();
    }

    function endPress(x: number, y: number) {
        clearTimeout(longPressTimer);
        if (!press) return;
        const p = press;
        press = null;
        canvas.classList.remove('grabbing');
        if (p.dragging && p.fruit) {
            const f = p.fruit;
            f.grabbed = false;
            f.vx = Math.max(-MAX_SPEED, Math.min(MAX_SPEED, velX));
            f.vy = Math.max(-MAX_SPEED, Math.min(MAX_SPEED, velY));
            f.thrownAt = performance.now();
            return;
        }
        const moved = Math.hypot(x - p.x, y - p.y);
        if (moved > 10) return;
        markUser();
        if (p.fruit) {
            const same = cardState?.kind === 'skill' && cardState.fruit === p.fruit && cardState.pinned;
            if (same) hideCard();
            else showCard({ kind: 'skill', fruit: p.fruit, pinned: true });
        } else {
            if (cardState) hideCard();
            if (inBowlColumn(x, y)) poke(x, y);
        }
    }

    function poke(x: number, y: number) {
        if (reducedMotion) return;
        const reach = 170 * Math.max(0.8, scale);
        for (const f of fruits) {
            const dx = f.x - x, dy = f.y - y;
            const d = Math.hypot(dx, dy);
            if (d > reach) continue;
            const k = 1 - d / reach;
            f.vx += (d > 0 ? dx / d : 0) * 260 * k;
            f.vy -= 420 * k;
        }
        spawnParticles(x, y, BOWL_STROKE, 6, 120);
    }

    // Mouse
    canvas.addEventListener('mousedown', (e) => {
        if (e.button !== 0) return;
        const p = pos(e);
        const hit = hitTest(p.x, p.y);
        press = {
            fruit: hit, x: p.x, y: p.y, t: performance.now(),
            offX: hit ? p.x - hit.x : 0, offY: hit ? p.y - hit.y : 0,
            dragging: false, touch: false, decided: true,
        };
        lastPX = p.x; lastPY = p.y; lastPT = performance.now(); velX = 0; velY = 0;
        // Fruit presses belong to the bowl, not to the slider's mouse drag.
        if (hit) { e.stopPropagation(); e.preventDefault(); }
    });

    window.addEventListener('mousemove', (e) => {
        if (!running && !reducedMotion) return;
        const p = pos(e);
        if (press && !press.touch) {
            if (!press.dragging && press.fruit && Math.hypot(p.x - press.x, p.y - press.y) > 4) startDrag();
            if (press.dragging) { moveDrag(p.x, p.y); return; }
        }
        if (e.target !== canvas) {
            if (hoverFruit) { hoverFruit = null; if (cardState && !cardState.pinned) hideCard(); }
            return;
        }
        const hit = hitTest(p.x, p.y);
        canvas.classList.toggle('grab', !!hit && !reducedMotion);
        canvas.classList.toggle('poke', !hit && inBowlColumn(p.x, p.y) && !reducedMotion);
        if (hit !== hoverFruit) {
            hoverFruit = hit;
            if (!cardState || !cardState.pinned) {
                if (hit) showCard({ kind: 'skill', fruit: hit, pinned: false });
                else if (cardState) hideCard();
            }
            if (reducedMotion) draw();
        }
    });

    window.addEventListener('mouseup', (e) => {
        if (!press || press.touch) return;
        const p = pos(e);
        endPress(p.x, p.y);
    });

    // Touch: a vertical swipe always belongs to the slider. A fruit is only
    // grabbed on a sideways move or a short press-and-hold, so the bowl can
    // never trap someone trying to scroll past it.
    canvas.addEventListener('touchstart', (e) => {
        if (e.touches.length !== 1) { press = null; return; }
        const p = pos(e.touches[0]);
        const hit = hitTest(p.x, p.y, 8);
        press = {
            fruit: hit, x: p.x, y: p.y, t: performance.now(),
            offX: hit ? p.x - hit.x : 0, offY: hit ? p.y - hit.y : 0,
            dragging: false, touch: true, decided: false,
        };
        lastPX = p.x; lastPY = p.y; lastPT = performance.now(); velX = 0; velY = 0;
        clearTimeout(longPressTimer);
        if (hit && !reducedMotion) {
            longPressTimer = window.setTimeout(() => {
                if (press && !press.decided && press.fruit) { press.decided = true; startDrag(); }
            }, 220);
        }
    }, { passive: true });

    canvas.addEventListener('touchmove', (e) => {
        if (!press) return;
        const p = pos(e.touches[0]);
        if (!press.decided) {
            const dx = p.x - press.x, dy = p.y - press.y;
            if (Math.hypot(dx, dy) < 8) return;
            press.decided = true;
            clearTimeout(longPressTimer);
            if (press.fruit && Math.abs(dx) > Math.abs(dy) * 1.2 && !reducedMotion) startDrag();
            else { press = null; return; } // vertical: hand it to the slider
        }
        if (press.dragging) {
            e.preventDefault();
            e.stopPropagation();
            moveDrag(p.x, p.y);
        }
    }, { passive: false });

    canvas.addEventListener('touchend', (e) => {
        if (!press) return;
        const t = e.changedTouches[0];
        const p = t ? pos(t) : { x: press.x, y: press.y };
        const wasTap = !press.dragging && Math.hypot(p.x - press.x, p.y - press.y) <= 10;
        if (press.dragging) e.stopPropagation();
        endPress(p.x, p.y);
        // Stop the emulated mouse events that would re-toggle the card.
        if (wasTap && e.cancelable) e.preventDefault();
    });

    canvas.addEventListener('touchcancel', () => {
        clearTimeout(longPressTimer);
        if (press?.dragging && press.fruit) press.fruit.grabbed = false;
        press = null;
        canvas.classList.remove('grabbing');
    });

    canvas.addEventListener('contextmenu', (e) => {
        if (hitTest(pos(e).x, pos(e).y)) e.preventDefault();
    });

    card.querySelector('.skills-card-close')?.addEventListener('click', () => hideCard());
    card.addEventListener('mouseleave', () => {
        if (cardState?.autoHide) hideCard();
    });

    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && cardState) hideCard();
    });

    // Close a pinned card when clicking anywhere else on the slide.
    root.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (!cardState?.pinned || target === canvas || card.contains(target)) return;
        hideCard();
    });

    // Project links: same route as the timeline. Set the hash, go to the
    // projects slide, and Projects.astro opens the matching case.
    root.addEventListener('click', (e) => {
        const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('[data-project]');
        if (!link) return;
        e.preventDefault();
        history.replaceState(null, '', `#${link.dataset.project}`);
        document.dispatchEvent(new CustomEvent('slider-goto', { detail: { index: 1 } }));
    });

    // Pillar cards ↔ fruit: hovering a card lights its fruit.
    root.querySelectorAll<HTMLElement>('.skills-pillar').forEach((el) => {
        const fruitFor = () => fruits.find((f) => f.skill.id === el.dataset.skill);
        el.addEventListener('mouseenter', () => {
            const f = fruitFor();
            if (!f) return;
            f.flash = 1;
            if (!reducedMotion && !f.grabbed) f.vy -= 260;
            if (reducedMotion) draw();
        });
    });

    // ─── Demo: once per visit, throw one pillar into another to show a combo ───
    function startDemo(now: number) {
        demoDone = true;
        const f = fruits.find((x) => x.skill.id === 'ai');
        const target = fruits.find((x) => x.skill.id === 'tdd');
        if (!f || !target) return;
        f.grabbed = true;
        tween = { f, target, fx: f.x, fy: f.y, t0: now, dur: 1200 };
    }

    function stepTween(now: number) {
        if (!tween) return;
        const { f, target, fx, fy, t0, dur } = tween;
        const k = Math.min(1, (now - t0) / dur);
        const e = k < 0.5 ? 2 * k * k : 1 - Math.pow(-2 * k + 2, 2) / 2;
        const side = target.x > fx ? -1 : 1;
        const tx = target.x + side * (f.r + target.r) * 0.55;
        const ty = target.y - (f.r + target.r) * 0.8;
        const lift = Math.sin(Math.PI * k) * Math.min(180, bowl.h * 0.55);
        const x = fx + (tx - fx) * e;
        const y = fy + (ty - fy) * e - lift;
        f.x = Math.max(bowl.x + f.r, Math.min(bowl.x + bowl.w - f.r, x));
        f.y = Math.max(f.r + 2, y);
        if (k >= 1) {
            f.grabbed = false;
            f.vy = 120;
            f.thrownAt = now;
            tween = null;
        }
    }

    // ─── Loop ───
    function start() {
        if (running) return;
        running = true;
        fruits.length = 0;
        particles.length = 0;
        fillIdx = 0;
        lastFill = 0;
        filledAt = 0;
        lastHop = 0;
        tween = null;
        resize();

        let prev = performance.now();
        function tick(now: number) {
            const dt = Math.min((now - prev) / 1000, DT_CAP);
            prev = now;

            if (fillIdx < dropOrder.length && now - lastFill > FILL_INTERVAL) {
                spawn(dropOrder[fillIdx], DROP_X[fillIdx % DROP_X.length]);
                fillIdx++;
                lastFill = now;
                if (fillIdx === dropOrder.length) filledAt = now;
            }

            if (filledAt && !demoDone && !userInteracted && now - filledAt > IDLE_BEFORE_DEMO) startDemo(now);
            stepTween(now);

            // A little life when nobody's playing: one fruit hops now and then.
            if (filledAt && !tween && !press && now - lastUserAction > 8000 && now - lastHop > IDLE_HOP_EVERY
                && now - filledAt > IDLE_BEFORE_DEMO + 3000) {
                lastHop = now;
                const tools = fruits.filter((f) => !f.skill.pillar);
                const f = tools[Math.floor(Math.random() * tools.length)];
                if (f) { f.vy -= 300; f.vx += (Math.random() - 0.5) * 120; }
            }

            step(dt, now);
            draw(now);
            positionCard();
            animId = requestAnimationFrame(tick);
        }
        animId = requestAnimationFrame(tick);
    }

    function stop() {
        if (animId !== null) { cancelAnimationFrame(animId); animId = null; }
        running = false;
        fruits.length = 0;
        particles.length = 0;
        press = null;
        tween = null;
        hoverFruit = null;
        if (cardState) hideCard();
        ctx.clearRect(0, 0, W, H);
    }

    /** Reduced motion: settle the bowl off-screen, draw one still frame. */
    function renderStill() {
        fruits.length = 0;
        resize();
        settling = true;
        const now = performance.now();
        dropOrder.forEach((s, i) => {
            spawn(s, DROP_X[i % DROP_X.length]);
            for (let k = 0; k < 45; k++) step(1 / 60, now);
        });
        for (let k = 0; k < 240; k++) step(1 / 60, now);
        for (const f of fruits) { f.vx = 0; f.vy = 0; }
        settling = false;
        draw(now);
    }

    let resizeTimer = 0;
    window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(() => {
            if (reducedMotion) { renderStill(); return; }
            if (running) resize();
        }, 100);
    });

    // Testing hook (same pattern as window.__numbersGame).
    (window as unknown as { __skillsBowl: unknown }).__skillsBowl = {
        fruits: () => fruits.map((f) => ({ id: f.skill.id, x: f.x, y: f.y, r: f.r, tier: f.skill.tier })),
        bowl: () => ({ ...bowl }),
        combos: () => [...foundCombos],
        throwAt: (a: string, b: string) => {
            const fa = fruits.find((f) => f.skill.id === a);
            const fb = fruits.find((f) => f.skill.id === b);
            if (!fa || !fb) return false;
            markUser();
            fa.x = fb.x; fa.y = fb.y - (fa.r + fb.r) * 0.9;
            tryCombo(fa, fb, performance.now());
            return true;
        },
    };

    // Start/stop with the slide's reveal state.
    const reveal = root.querySelector('.reveal');
    if (reducedMotion) {
        const ro = new ResizeObserver(() => renderStill());
        ro.observe(stage);
        return;
    }
    if (reveal) {
        const mo = new MutationObserver(() => {
            if (reveal.classList.contains('visible')) { if (!running) start(); }
            else if (running) stop();
        });
        mo.observe(reveal, { attributes: true, attributeFilter: ['class'] });
        if (reveal.classList.contains('visible')) start();
    }
})();
</script>
