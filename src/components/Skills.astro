---
import { useTranslations } from "../i18n/utils";
import { defaultLang, type Lang } from "../i18n/ui";
import { getSkillLadder, getSkillPillars } from "../i18n/skills";
import { projectEntries } from "../i18n/projects";
import { TIER_COLORS, TIER_COUNT } from "../utils/skill-ladder";

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);

const projectTitle = (slug: string | null) =>
    slug ? (projectEntries.find((p) => p.slug === slug)?.[lang].title ?? null) : null;

const ladder = getSkillLadder(lang).map((r) => ({ ...r, slugTitle: projectTitle(r.slug) }));
const pillars = getSkillPillars(lang).map((p) => ({ ...p, slugTitle: projectTitle(p.slug) }));

const numberLocale = lang === "sv" ? "sv-SE" : "en-GB";
const fmtYears = (y: number) =>
    y.toLocaleString(numberLocale, { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const fill = (s: string, vars: Record<string, string | number>) =>
    s.replace(/\{(\w+)\}/g, (_, k) => String(vars[k] ?? ""));

const FRUIT_NAMES: Record<Lang, string[]> = {
    sv: ["körsbär", "jordgubbe", "vindruva", "citron", "apelsin", "äpple", "päron", "persika", "ananas", "melon", "vattenmelon"],
    en: ["cherry", "strawberry", "grape", "lemon", "orange", "apple", "pear", "peach", "pineapple", "melon", "watermelon"],
};

const strings = {
    lang: numberLocale,
    years: t("skills.card.years"),
    at: t("skills.card.at"),
    level: t("skills.card.level"),
    isNew: t("skills.card.new"),
    top: t("skills.card.top"),
    pillar: t("skills.card.pillar"),
    locked: t("skills.ladder.locked"),
    reached: t("skills.aria.reached"),
    overScore: t("skills.over.score"),
};

const rungAria = (r: (typeof ladder)[number]) =>
    `${fill(t("skills.card.level"), { n: r.tier + 1, total: TIER_COUNT })}: ${r.label} (${FRUIT_NAMES[lang][r.tier]})`;
---

<div class="skills-slide">
    <div class="skills-copy">
        <div class="section-label reveal">{t("skills.label")}</div>
        <h2 class="section-heading skills-heading reveal reveal-delay-1">
            {t("skills.heading.before")}<span class="highlight">{t("skills.heading.highlight")}</span>{t("skills.heading.after")}
        </h2>
        <p class="skills-sub">{t("skills.sub")}</p>

        <ol class="skills-pillars" aria-label={t("skills.pillars.label")}>
            {pillars.map((p) => {
                const rung = ladder.find((r) => r.id === p.rung)!;
                return (
                    <li class="skills-pillar" data-pillar={p.id} data-tier={rung.tier} style={`--fruit: ${TIER_COLORS[rung.tier]}`}>
                        <h3 class="skills-pillar-title">{p.label}</h3>
                        <p class="skills-pillar-value">{p.value}</p>
                        {p.slugTitle && (
                            <a class="skills-pillar-link" href={`#${p.slug}`} data-project={p.slug}>
                                {p.slugTitle}<span aria-hidden="true"> →</span>
                            </a>
                        )}
                    </li>
                );
            })}
        </ol>
    </div>

    <div class="skills-stage">
        <div class="skills-hud">
            <p class="skills-score">{t("skills.score")} <b data-score>0</b></p>
            <p class="skills-next">{t("skills.next")} <canvas class="skills-next-fruit" aria-hidden="true"></canvas></p>
        </div>
        {/* The bowl never moves: its own layer, painted once per resize. */}
        <canvas class="skills-bowl" aria-hidden="true"></canvas>
        <canvas class="skills-canvas" tabindex="0" role="img" aria-label={t("skills.aria.canvas")}></canvas>
        <div class="skills-card" hidden>
            <button type="button" class="skills-card-close" aria-label={t("skills.card.close")}>×</button>
            <div class="skills-card-head">
                <canvas class="skills-card-icon" aria-hidden="true"></canvas>
                <div>
                    <div class="skills-card-kicker"></div>
                    <div class="skills-card-title"></div>
                </div>
            </div>
            <p class="skills-card-body"></p>
            <p class="skills-card-proof"></p>
            <p class="skills-card-meta"></p>
            <a class="skills-card-link" href="#"></a>
        </div>
        <div class="skills-over" hidden>
            <p class="skills-over-title">{t("skills.over.title")}</p>
            <p class="skills-over-score"></p>
            <button type="button" class="skills-over-again">{t("skills.over.again")}</button>
        </div>
        <div class="skills-footer">
            <ol class="skills-ladder" aria-label={t("skills.ladder.label")}>
                {ladder.map((r) => (
                    <li>
                        <button
                            type="button"
                            class="skills-rung"
                            data-tier={r.tier}
                            aria-label={`${rungAria(r)}, ${t("skills.ladder.locked")}`}
                            data-aria={rungAria(r)}
                            aria-disabled="true"
                        >
                            <canvas class="skills-rung-icon" aria-hidden="true"></canvas>
                            <span class="skills-rung-name" aria-hidden="true">{r.short}</span>
                        </button>
                    </li>
                ))}
            </ol>
            <p class="skills-caption">{t("skills.caption")}</p>
            <p class="skills-hint">
                <span class="skills-hint-mouse">{t("skills.hint")}</span>
                <span class="skills-hint-touch">{t("skills.hint.touch")}</span>
            </p>
        </div>
    </div>

    {/* Screen readers, crawlers and print get the whole ladder as text. */}
    <ol class="sr-only skills-list" aria-label={t("skills.aria.list")}>
        {ladder.map((r) => (
            <li>
                {r.label} ({FRUIT_NAMES[lang][r.tier]}){r.years !== null && `, ${fmtYears(r.years)} ${t("skills.card.years")}`}: {r.line}{r.proof && ` ${r.proof}`}
            </li>
        ))}
    </ol>
    <p class="sr-only skills-live" aria-live="polite"></p>

    <script
        type="application/json"
        class="skills-data"
        set:html={JSON.stringify({ ladder, strings, colors: TIER_COLORS })}
    />
</div>

<!-- Print fallback -->
<div class="skills-print-fallback">
    <div class="section-inner" style="text-align: center;">
        <div class="section-label">{t("skills.label")}</div>
        <h2 class="section-heading">{t("skills.heading.before")}<span class="highlight">{t("skills.heading.highlight")}</span>{t("skills.heading.after")}</h2>
        <div class="skills-cloud-print">
            {pillars.map((p) => <span class="skill-pill-print featured">{p.label}</span>)}
            {ladder.filter((r) => r.years !== null).map((r) => <span class="skill-pill-print">{r.label} · {fmtYears(r.years!)} {t("skills.card.years")}</span>)}
        </div>
    </div>
</div>

<style>
    .skills-slide {
        position: absolute;
        inset: 0;
        display: grid;
        grid-template-columns: minmax(300px, 430px) minmax(0, 1fr);
        column-gap: clamp(28px, 4vw, 64px);
        max-width: 1280px;
        margin: 0 auto;
        padding: 64px clamp(56px, 6vw, 96px) 28px clamp(32px, 5vw, 80px);
    }

    .skills-copy {
        align-self: center;
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .skills-heading {
        font-size: clamp(32px, 4vw, 52px);
        margin-bottom: 12px;
    }

    .skills-sub {
        color: var(--text);
        font-size: 17px;
        line-height: 1.5;
        max-width: 34ch;
        margin-bottom: 22px;
    }

    .skills-pillars {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    .skills-pillar {
        padding: 14px 0;
        border-top: 1px solid var(--border);
    }

    .skills-pillar:last-child { border-bottom: 1px solid var(--border); }

    .skills-pillar-title {
        display: block;
        font-size: 17px;
        font-weight: 700;
        line-height: 1.3;
        margin-bottom: 4px;
        text-decoration: underline 2px transparent;
        text-underline-offset: 5px;
        transition: text-decoration-color 0.2s ease;
    }

    .skills-pillar:hover .skills-pillar-title,
    .skills-pillar:focus-within .skills-pillar-title {
        text-decoration-color: var(--fruit);
    }

    .skills-pillar-value {
        color: var(--text-dim);
        font-size: 14px;
        line-height: 1.45;
    }

    .skills-pillar-link {
        display: inline-block;
        margin-top: 6px;
        font-size: 13px;
        color: var(--text-dim);
        text-decoration: none;
    }

    .skills-card-link {
        display: inline-block;
        margin-top: 8px;
        font-size: 13px;
        color: var(--text-dim);
        text-decoration: underline 1px;
        text-underline-offset: 3px;
    }

    .skills-pillar-link:hover { text-decoration: underline; }
    .skills-card-link:hover { color: var(--text); }

    .skills-card-link[hidden] { display: none; }

    .skills-pillar-link:focus-visible,
    .skills-card-link:focus-visible,
    .skills-card-close:focus-visible,
    .skills-rung:focus-visible,
    .skills-over-again:focus-visible {
        outline: 2px solid var(--purple);
        outline-offset: 2px;
        border-radius: 4px;
    }

    /* ── Stage: hud, canvases, card, footer ── */
    .skills-stage {
        position: relative;
        min-width: 0;
        min-height: 0;
    }

    .skills-hud {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        pointer-events: none;
        z-index: 1;
        font-size: 13px;
        color: var(--text-dim);
    }

    .skills-score b {
        color: var(--text);
        font-family: var(--mono);
        font-weight: 600;
        font-size: 15px;
        margin-left: 4px;
        font-variant-numeric: tabular-nums;
    }

    .skills-next {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .skills-next-fruit {
        width: 28px;
        height: 28px;
    }

    .skills-bowl {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        display: block;
        pointer-events: none;
    }

    .skills-canvas {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        display: block;
        cursor: default;
        touch-action: none;
        -webkit-touch-callout: none;
        -webkit-user-select: none;
        user-select: none;
        -webkit-tap-highlight-color: transparent;
    }

    .skills-canvas.aim { cursor: pointer; }
    .skills-canvas:focus { outline: none; }
    .skills-canvas:focus-visible { outline: 1px dashed var(--text-muted); outline-offset: -1px; border-radius: 8px; }

    .skills-card {
        position: absolute;
        left: 0;
        top: 0;
        z-index: 3;
        width: min(330px, calc(100% - 16px));
        background: rgba(19, 19, 26, 0.96);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 12px 34px 12px 14px;
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.55);
        pointer-events: none;
        opacity: 0;
        transform: translateY(calc(var(--shift, 0%) + 6px));
        transition: opacity 0.18s ease, transform 0.18s ease;
    }

    .skills-card.is-open {
        opacity: 1;
        transform: translateY(var(--shift, 0%));
        pointer-events: auto;
    }

    .skills-card-close {
        position: absolute;
        top: 6px;
        right: 8px;
        width: 26px;
        height: 26px;
        border: 0;
        background: none;
        color: var(--text-dim);
        font-size: 18px;
        line-height: 1;
        cursor: pointer;
    }

    .skills-card-head {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 6px;
    }

    .skills-card-icon {
        width: 34px;
        height: 34px;
        flex: none;
    }

    .skills-card-kicker {
        font-family: var(--mono);
        font-size: 11px;
        color: var(--text-dim);
        margin-bottom: 2px;
    }

    .skills-card-title {
        font-size: 17px;
        font-weight: 700;
        line-height: 1.25;
    }

    .skills-card-body {
        font-size: 14px;
        line-height: 1.45;
        color: var(--text);
    }

    .skills-card-proof {
        font-size: 13px;
        line-height: 1.45;
        color: var(--text-dim);
        margin-top: 6px;
    }

    .skills-card-meta {
        font-family: var(--mono);
        font-size: 11.5px;
        line-height: 1.5;
        color: var(--text-dim);
        margin-top: 8px;
    }

    .skills-card-proof:empty,
    .skills-card-meta:empty { display: none; }

    .skills-over {
        position: absolute;
        z-index: 2;
        left: 50%;
        top: 42%;
        transform: translate(-50%, -50%);
        text-align: center;
        background: rgba(19, 19, 26, 0.94);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 18px 26px 20px;
        width: max-content;
        max-width: calc(100% - 24px);
    }

    .skills-over[hidden] { display: none; }

    .skills-over-title {
        font-size: 18px;
        font-weight: 700;
    }

    .skills-over-score {
        font-family: var(--mono);
        font-size: 13px;
        color: var(--text-dim);
        margin: 4px 0 14px;
    }

    .skills-over-again {
        font: inherit;
        font-size: 14px;
        font-weight: 600;
        color: var(--bg, #0a0a0f);
        background: var(--text);
        border: 0;
        border-radius: 8px;
        padding: 8px 18px;
        cursor: pointer;
    }

    .skills-footer {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        text-align: center;
    }

    .skills-ladder {
        list-style: none;
        display: flex;
        justify-content: center;
        align-items: flex-end;
        gap: 2px;
        margin: 0 auto 8px;
        max-width: 640px;
    }

    .skills-ladder li { flex: 1 1 0; min-width: 0; }

    .skills-rung {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 3px;
        width: 100%;
        padding: 4px 0 3px;
        border: 0;
        border-radius: 6px;
        background: none;
        color: var(--text-muted);
        font: inherit;
        cursor: default;
    }

    .skills-rung-icon {
        display: block;
        filter: grayscale(1) brightness(0.32);
        opacity: 0.55;
        transition: filter 0.3s ease, opacity 0.3s ease;
    }

    .skills-rung-name {
        font-size: 11px;
        line-height: 1.1;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: clip;
        max-width: 100%;
    }

    .skills-rung.is-reached { color: var(--text-dim); cursor: pointer; }
    .skills-rung.is-reached .skills-rung-icon { filter: none; opacity: 1; }
    .skills-rung.is-reached:hover,
    .skills-rung.is-current { color: var(--text); }
    .skills-rung.is-lit { background: rgba(255, 255, 255, 0.07); color: var(--text); }
    .skills-rung.is-lit .skills-rung-icon { opacity: 1; }

    .skills-caption {
        font-size: 14px;
        color: var(--text);
        line-height: 1.4;
    }

    .skills-hint {
        margin-top: 2px;
        font-size: 12px;
        color: var(--text-muted);
    }

    .skills-hint-touch { display: none; }
    @media (hover: none) and (pointer: coarse) {
        .skills-hint-mouse { display: none; }
        .skills-hint-touch { display: inline; }
    }

    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }

    /* ── Narrow screens: stack copy over the game ── */
    @media (max-width: 860px) {
        .skills-slide {
            grid-template-columns: minmax(0, 1fr);
            grid-template-rows: auto minmax(0, 1fr);
            padding: 36px 20px 14px;
            row-gap: 6px;
        }

        .skills-copy { align-self: start; }
        .skills-heading { font-size: 30px; margin-bottom: 6px; }
        .skills-sub { font-size: 14px; margin-bottom: 8px; max-width: 40ch; }

        .skills-pillar { padding: 7px 0; }
        .skills-pillar-title { font-size: 15px; margin-bottom: 1px; text-underline-offset: 4px; }
        .skills-pillar-value { font-size: 13px; line-height: 1.35; }
        .skills-pillar-link { margin-top: 2px; font-size: 12px; }

        .skills-card {
            width: auto;
            right: 0;
        }

        .skills-hud { font-size: 12px; }
        .skills-next-fruit { width: 22px; height: 22px; }
        .skills-ladder { margin-bottom: 4px; gap: 0; }
        .skills-rung { padding: 2px 0; gap: 2px; }
        .skills-rung-name { font-size: 8.5px; letter-spacing: -0.2px; }
        .skills-caption { font-size: 12.5px; }
        .skills-hint { font-size: 11px; }
    }

    @media (max-width: 600px) {
        .skills-slide { padding-right: 28px; }
    }

    /* Print */
    .skills-print-fallback { display: none; }
    @media print {
        .skills-slide { display: none !important; }
        .skills-print-fallback { display: block !important; }
        .skills-cloud-print {
            display: flex; flex-wrap: wrap; gap: 3px; justify-content: center;
        }
        .skill-pill-print {
            font-family: var(--mono); font-size: 8px; padding: 2px 6px;
            border-radius: 100px; border: 1px solid var(--border);
            color: var(--text-dim);
        }
        .skill-pill-print.featured {
            border-color: var(--purple-dim); color: var(--purple);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .skills-pillar-title,
        .skills-card,
        .skills-rung-icon { transition: none; }
    }
</style>

<script>
import {
    TIER_COUNT, TOP_TIER, radiusForTier, mergeResult, scoreForMerge,
    createDropSequence, SEED_PILE, dangerStep,
} from "../utils/skill-ladder";

(function () {
    const root = document.querySelector<HTMLElement>('.skills-slide');
    if (!root) return;
    const stage = root.querySelector<HTMLElement>('.skills-stage')!;
    const canvas = root.querySelector<HTMLCanvasElement>('.skills-canvas')!;
    const bowlCanvas = root.querySelector<HTMLCanvasElement>('.skills-bowl')!;
    const card = root.querySelector<HTMLElement>('.skills-card')!;
    const hud = root.querySelector<HTMLElement>('.skills-hud')!;
    const footer = root.querySelector<HTMLElement>('.skills-footer')!;
    const overEl = root.querySelector<HTMLElement>('.skills-over')!;
    const scoreEl = root.querySelector<HTMLElement>('[data-score]')!;
    const nextCanvas = root.querySelector<HTMLCanvasElement>('.skills-next-fruit')!;
    const liveEl = root.querySelector<HTMLElement>('.skills-live')!;
    const rungEls = [...root.querySelectorAll<HTMLButtonElement>('.skills-rung')];
    const mainCtx = canvas.getContext('2d')!;
    // The fruit painters draw on `ctx`; sprite builders point it at an offscreen canvas.
    let ctx = mainCtx;

    interface Rung {
        id: string; tier: number; label: string; short: string;
        years: number | null; employers: string[]; line: string;
        proof: string | null; slug: string | null; slugTitle: string | null;
        pillar: string | null;
    }
    const data: {
        ladder: Rung[]; colors: string[];
        strings: Record<'lang' | 'years' | 'at' | 'level' | 'isNew' | 'top' | 'pillar' | 'locked' | 'reached' | 'overScore', string>;
    } = JSON.parse(root.querySelector('.skills-data')?.textContent || '{}');
    if (!data.ladder?.length) return;
    const S = data.strings;
    const COLORS = data.colors;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const fill = (s: string, vars: Record<string, string | number>) =>
        s.replace(/\{(\w+)\}/g, (_, k) => String(vars[k] ?? ''));
    const fmtYears = (y: number) =>
        y.toLocaleString(S.lang, { minimumFractionDigits: 1, maximumFractionDigits: 1 });

    // ─── Tuning (all speeds scale with the bowl, tuned at 560 px wide) ───
    const REF_W = 560;
    const GRAVITY = 1500;
    const BOUNCE = 0.15;
    const AIR_DRAG = 0.996;
    const DT_CAP = 0.033;
    const MAX_SPEED = 1300;
    const DROP_COOLDOWN = 450;   // ms between drops
    const SLEEP_AFTER = 900;     // ms of stillness before the loop parks itself
    const BOWL_STROKE = '#9b4dca';
    const BOWL_GLOW = 'rgba(155, 77, 202, 0.35)';
    const GOLD = '#ffd166';
    // Phones report DPR 3; at 2 the fruit look the same and the canvas has 44% of the pixels.
    const MAX_DPR = 2;

    interface Fruit {
        tier: number;
        x: number; y: number; vx: number; vy: number;
        r: number; mass: number;
        bornAt: number;
        scaleAnim: number;
        flash: number;
        dead: boolean;
    }
    interface Particle {
        x: number; y: number; vx: number; vy: number;
        life: number; maxLife: number; color: string; size: number;
    }
    interface Bowl {
        x: number; y: number; w: number; h: number;
        taperInset: number; cornerRadius: number;
        leftWall: { x1: number; y1: number; x2: number; y2: number };
        rightWall: { x1: number; y1: number; x2: number; y2: number };
        bottom: number;
        dangerY: number;
        dropY: number;
    }

    const fruits: Fruit[] = [];
    const particles: Particle[] = [];
    let bowl = {} as Bowl;
    let W = 0, H = 0, k = 1, compact = false, dpr = 1;
    let animId: number | null = null;
    let visible = false;
    let started = false;
    let settling = false;     // seeding off-screen: no merges, no story cards
    let lastActive = 0;
    let shake = 0;

    // ─── Game state ───
    let nextDrop = createDropSequence();
    let current = 0, upcoming = 0;
    let dropX = 0.5;           // fraction of the bowl's width
    let readyAt = 0;
    let score = 0;
    let overSince: number | null = null;
    let gameOver = false;
    const reached = new Set<number>();
    let lit: number | null = null;

    const biggest = () => fruits.reduce((m, f) => (f.dead ? m : Math.max(m, f.tier)), 0);

    // ─── Layout ───
    function resize() {
        dpr = Math.min(window.devicePixelRatio || 1, MAX_DPR);
        const oldBowl = bowl;
        W = stage.clientWidth;
        H = stage.clientHeight;
        canvas.width = bowlCanvas.width = Math.round(W * dpr);
        canvas.height = bowlCanvas.height = Math.round(H * dpr);
        mainCtx.setTransform(dpr, 0, 0, dpr, 0, 0);
        compact = W < 520;
        // Strip icons first: their size sets the footer's height.
        paintIcons();

        const hudH = hud.offsetHeight;
        const footH = footer.offsetHeight + (compact ? 8 : 14);
        const bw = Math.min(W - (compact ? 4 : 24), 600);
        // Room above the rim for the dropper holding the biggest droppable fruit.
        // Late in a game bigger fruit are dropped; they may overlap the hud a little.
        const dropRoom = radiusForTier(5, bw) * 2 + 18;
        const bh = Math.max(180, Math.min(H - footH - hudH - dropRoom, 540));
        const bx = (W - bw) / 2;
        const by = H - footH - bh;
        const corner = compact ? 14 : 20;
        const taper = compact ? 8 : 14;
        bowl = {
            x: bx, y: by, w: bw, h: bh, taperInset: taper, cornerRadius: corner,
            leftWall: { x1: bx + taper, y1: by + bh - corner, x2: bx, y2: by },
            rightWall: { x1: bx + bw - taper, y1: by + bh - corner, x2: bx + bw, y2: by },
            bottom: by + bh - corner,
            dangerY: by + 6,
            dropY: by - radiusForTier(5, bw) - 10,
        };
        // The hud sits right above the drop zone, not at the top of a tall stage.
        hud.style.top = `${Math.max(0, Math.round(by - dropRoom - hudH))}px`;
        k = bw / REF_W;
        // Keep the pile where it was, relative to the bowl.
        if (oldBowl.w) {
            const s = bw / oldBowl.w;
            for (const f of fruits) {
                f.x = bowl.x + (f.x - oldBowl.x) * s;
                f.y = bowl.bottom - (oldBowl.bottom - f.y) * s;
            }
        }
        for (const f of fruits) setRadius(f);
        clearSprites();
        const bctx = bowlCanvas.getContext('2d')!;
        bctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx = bctx;
        try { drawBowl(); } finally { ctx = mainCtx; }
        prewarm();
        wake();
    }

    function setRadius(f: Fruit) {
        f.r = radiusForTier(f.tier, bowl.w);
        f.mass = f.r * f.r;
    }

    function addFruit(tier: number, x: number, y: number, now: number): Fruit {
        const f: Fruit = { tier, x, y, vx: 0, vy: 0, r: 0, mass: 0, bornAt: now, scaleAnim: 1, flash: 0, dead: false };
        setRadius(f);
        fruits.push(f);
        return f;
    }

    // ─── Particles ───
    function spawnParticles(x: number, y: number, color: string, count = 8, speed = 160) {
        if (reducedMotion) return;
        for (let i = 0; i < count; i++) {
            const angle = (Math.PI * 2 / count) * i + (Math.random() - 0.5) * 0.5;
            const v = speed * k * (0.5 + Math.random() * 0.8);
            particles.push({
                x, y, vx: Math.cos(angle) * v, vy: Math.sin(angle) * v,
                life: 1, maxLife: 0.5 + Math.random() * 0.4, color, size: 2 + Math.random() * 3,
            });
        }
    }

    // ─── Collision helpers ───
    const hitScratch = { nx: 0, ny: 0, depth: 0 };
    function circleLineCollision(cx: number, cy: number, r: number,
        x1: number, y1: number, x2: number, y2: number) {
        const dx = x2 - x1, dy = y2 - y1;
        const len2 = dx * dx + dy * dy;
        if (len2 === 0) return null;
        let t = ((cx - x1) * dx + (cy - y1) * dy) / len2;
        t = Math.max(0, Math.min(1, t));
        const distX = cx - (x1 + t * dx);
        const distY = cy - (y1 + t * dy);
        const dist = Math.sqrt(distX * distX + distY * distY);
        if (dist < r) {
            hitScratch.nx = dist > 0 ? distX / dist : 0;
            hitScratch.ny = dist > 0 ? distY / dist : -1;
            hitScratch.depth = r - dist;
            return hitScratch;
        }
        return null;
    }

    function bounceOff(f: Fruit, hit: { nx: number; ny: number; depth: number } | null) {
        if (!hit) return;
        f.x += hit.nx * hit.depth;
        f.y += hit.ny * hit.depth;
        const vDotN = f.vx * hit.nx + f.vy * hit.ny;
        if (vDotN < 0) {
            f.vx -= (1 + BOUNCE) * vDotN * hit.nx;
            f.vy -= (1 + BOUNCE) * vDotN * hit.ny;
        }
    }

    /** Keep a fruit inside the bowl, or inside the column above it. */
    function confine(f: Fruit) {
        bounceOff(f, circleLineCollision(f.x, f.y, f.r, bowl.leftWall.x1, bowl.leftWall.y1, bowl.leftWall.x2, bowl.leftWall.y2));
        bounceOff(f, circleLineCollision(f.x, f.y, f.r, bowl.rightWall.x1, bowl.rightWall.y1, bowl.rightWall.x2, bowl.rightWall.y2));
        if (f.y + f.r > bowl.bottom) {
            f.y = bowl.bottom - f.r;
            if (f.vy > 0) f.vy = -f.vy * BOUNCE;
            f.vx *= 0.92;
        }
        const t = Math.max(0, Math.min(1, (f.y - bowl.y) / (bowl.bottom - bowl.y)));
        const left = bowl.x + bowl.taperInset * t + f.r;
        const right = bowl.x + bowl.w - bowl.taperInset * t - f.r;
        if (f.x < left) { f.x = left; if (f.vx < 0) f.vx = -f.vx * BOUNCE; }
        if (f.x > right) { f.x = right; if (f.vx > 0) f.vx = -f.vx * BOUNCE; }
        if (f.y - f.r < 2) { f.y = f.r + 2; if (f.vy < 0) f.vy = 0; }
    }

    // ─── Physics step ───
    const born: Fruit[] = [];
    function step(dt: number, now: number) {
        for (let i = particles.length - 1; i >= 0; i--) {
            const p = particles[i];
            p.x += p.vx * dt; p.y += p.vy * dt; p.vy += 300 * k * dt;
            p.life -= dt / p.maxLife;
            if (p.life <= 0) particles.splice(i, 1);
        }

        const g = GRAVITY * k, vmax = MAX_SPEED * k;
        for (const f of fruits) {
            if (f.scaleAnim > 1.005) f.scaleAnim += (1 - f.scaleAnim) * 9 * dt;
            else f.scaleAnim = 1;
            if (f.flash > 0) f.flash = Math.max(0, f.flash - dt * 1.4);
            f.vy += g * dt;
            f.vx *= AIR_DRAG; f.vy *= AIR_DRAG;
            const sp = Math.hypot(f.vx, f.vy);
            if (sp > vmax) { f.vx *= vmax / sp; f.vy *= vmax / sp; }
            f.x += f.vx * dt; f.y += f.vy * dt;
            confine(f);
        }

        for (let iter = 0; iter < 5; iter++) {
            for (let i = 0; i < fruits.length; i++) {
                const a = fruits[i];
                if (a.dead) continue;
                for (let j = i + 1; j < fruits.length; j++) {
                    const b = fruits[j];
                    if (b.dead) continue;
                    const dx = b.x - a.x, dy = b.y - a.y;
                    const minDist = a.r + b.r;
                    if (dx * dx + dy * dy >= minDist * minDist) continue;
                    const dist = Math.sqrt(dx * dx + dy * dy);

                    if (!settling) {
                        const merged = mergeResult(a.tier, b.tier);
                        if (merged !== null) { merge(a, b, merged, now); break; }
                    }

                    const overlap = minDist - dist;
                    const nx = dist > 0 ? dx / dist : 0;
                    const ny = dist > 0 ? dy / dist : -1;
                    const total = a.mass + b.mass;
                    a.x -= nx * overlap * (b.mass / total); a.y -= ny * overlap * (b.mass / total);
                    b.x += nx * overlap * (a.mass / total); b.y += ny * overlap * (a.mass / total);

                    if (iter === 0) {
                        const dvDotN = (a.vx - b.vx) * nx + (a.vy - b.vy) * ny;
                        if (dvDotN > 0) {
                            const impulse = (1 + BOUNCE) * dvDotN / total;
                            a.vx -= impulse * b.mass * nx; a.vy -= impulse * b.mass * ny;
                            b.vx += impulse * a.mass * nx; b.vy += impulse * a.mass * ny;
                        }
                        // Contact friction: a resting pile settles instead of creeping.
                        a.vx *= 0.985; b.vx *= 0.985;
                    }
                }
            }
            for (const f of fruits) if (!f.dead) confine(f);
        }

        if (born.length) {
            for (let i = fruits.length - 1; i >= 0; i--) if (fruits[i].dead) fruits.splice(i, 1);
            fruits.push(...born);
            born.length = 0;
        }
    }

    // ─── Merging ───
    function merge(a: Fruit, b: Fruit, tier: number, now: number) {
        a.dead = true; b.dead = true;
        // The new fruit appears where the two touched, weighted to the lower one
        // (that's where the pile has room), carrying their momentum.
        const lower = a.y > b.y ? a : b;
        const x = (a.x + b.x) / 2;
        const y = lower.y * 0.65 + (a.y + b.y) / 2 * 0.35;
        const f: Fruit = {
            tier, x, y, vx: (a.vx + b.vx) / 2, vy: Math.min(0, (a.vy + b.vy) / 2),
            r: 0, mass: 0, bornAt: now, scaleAnim: reducedMotion ? 1 : 1.18, flash: 1, dead: false,
        };
        setRadius(f);
        born.push(f);
        score += scoreForMerge(tier);
        scoreEl.textContent = String(score);
        spawnParticles(x, y, COLORS[tier], 8 + tier * 2, 150 + tier * 22);
        spawnParticles(x, y, COLORS[a.tier], 6, 120);
        if (tier >= 6 && !reducedMotion) shake = Math.min(1, 0.35 + (tier - 6) * 0.15);
        if (!reached.has(tier)) {
            reach(tier, true);
            showCard(tier, { anchorX: x, anchorY: y - f.r, isNew: true });
            if (tier === TOP_TIER) celebrate(x, y);
        }
    }

    function celebrate(x: number, y: number) {
        spawnParticles(x, y, GOLD, 30, 420);
        spawnParticles(x, y, COLORS[TOP_TIER], 16, 300);
        if (!reducedMotion) shake = 1;
    }

    // ─── Dropping ───
    function aimX(fr: number) {
        const r = radiusForTier(current, bowl.w);
        const lo = bowl.x + r + 2, hi = bowl.x + bowl.w - r - 2;
        return Math.max(lo, Math.min(hi, bowl.x + fr * bowl.w));
    }

    function setAim(x: number) {
        dropX = Math.max(0, Math.min(1, (x - bowl.x) / bowl.w));
        wake();
    }

    function drop(now = performance.now(), forceTier?: number) {
        if (gameOver || settling || now < readyAt) return false;
        const tier = forceTier ?? current;
        const r = radiusForTier(tier, bowl.w);
        const f = addFruit(tier, aimX(dropX), bowl.dropY, now);
        f.y = Math.max(r + 2, bowl.dropY);
        f.vy = 40 * k;
        current = upcoming;
        upcoming = nextDrop(biggest());
        paintNext();
        readyAt = now + DROP_COOLDOWN;
        wake();
        return true;
    }

    // ─── Progress strip ───
    function reach(tier: number, announce: boolean) {
        if (reached.has(tier)) return;
        reached.add(tier);
        const el = rungEls[tier];
        if (el) {
            el.classList.add('is-reached');
            el.removeAttribute('aria-disabled');
            el.setAttribute('aria-label', el.dataset.aria ?? '');
        }
        const best = Math.max(...reached);
        rungEls.forEach((r, i) => r.classList.toggle('is-current', i === best));
        if (announce) liveEl.textContent = fill(S.reached, { skill: data.ladder[tier].label });
    }

    function lightTier(tier: number | null) {
        lit = tier;
        rungEls.forEach((el, i) => el.classList.toggle('is-lit', i === tier));
        if (tier === null) return;
        for (const f of fruits) if (f.tier === tier) f.flash = 1;
        wake();
    }

    // ─── Story card ───
    let cardTier: number | null = null;
    let cardHideTimer = 0;
    const cardEls = {
        icon: card.querySelector<HTMLCanvasElement>('.skills-card-icon')!,
        kicker: card.querySelector<HTMLElement>('.skills-card-kicker')!,
        title: card.querySelector<HTMLElement>('.skills-card-title')!,
        body: card.querySelector<HTMLElement>('.skills-card-body')!,
        proof: card.querySelector<HTMLElement>('.skills-card-proof')!,
        meta: card.querySelector<HTMLElement>('.skills-card-meta')!,
        link: card.querySelector<HTMLAnchorElement>('.skills-card-link')!,
    };

    function showCard(tier: number, opts: { anchorX?: number; anchorY?: number; anchorEl?: HTMLElement; isNew?: boolean }) {
        clearTimeout(cardHideTimer);
        const rung = data.ladder[tier];
        cardTier = tier;
        const level = fill(S.level, { n: tier + 1, total: TIER_COUNT });
        cardEls.kicker.textContent = opts.isNew ? `${tier === TOP_TIER ? S.top : S.isNew} · ${level}` : level;
        cardEls.title.textContent = rung.label;
        cardEls.body.textContent = rung.line;
        cardEls.proof.textContent = rung.proof ?? '';
        const meta: string[] = [];
        if (rung.years !== null) meta.push(`${fmtYears(rung.years)} ${S.years}`);
        if (rung.employers.length) meta.push(`${S.at}: ${rung.employers.join(', ')}`);
        if (rung.pillar) meta.push(S.pillar);
        cardEls.meta.textContent = meta.join('\n');
        cardEls.meta.style.whiteSpace = 'pre-line';
        if (rung.slug && rung.slugTitle) {
            cardEls.link.hidden = false;
            cardEls.link.href = '#' + rung.slug;
            cardEls.link.dataset.project = rung.slug;
            cardEls.link.textContent = rung.slugTitle + ' →';
        } else {
            cardEls.link.hidden = true;
            delete cardEls.link.dataset.project;
        }
        paintIcon(cardEls.icon, tier, 34);
        card.dataset.tier = String(tier);
        card.hidden = false;
        // Placed once per open, and never measured: the card's width is known
        // from CSS and a transform hangs it above (or below) its anchor, so a
        // merge never forces a layout mid-game.
        if (compact) {
            card.style.left = '0px';
            card.style.top = '0px';
            card.style.removeProperty('--shift');
        } else {
            let ax: number, ay: number;
            if (opts.anchorEl) {
                // A click on the strip: reading layout here is fine, it's not a frame.
                const sr = stage.getBoundingClientRect();
                const er = opts.anchorEl.getBoundingClientRect();
                ax = er.left - sr.left + er.width / 2;
                ay = er.top - sr.top - 8;
            } else {
                ax = opts.anchorX ?? W / 2;
                ay = (opts.anchorY ?? H / 2) - 12;
            }
            const cw = Math.min(330, W - 16);
            const left = Math.max(4, Math.min(W - cw - 4, ax - cw / 2));
            const above = ay > H * 0.42;
            card.style.left = `${Math.round(left)}px`;
            card.style.top = `${Math.round(above ? ay : Math.max(4, ay + 24))}px`;
            card.style.setProperty('--shift', above ? '-100%' : '0%');
        }
        requestAnimationFrame(() => card.classList.add('is-open'));
        lightTier(tier);
        // Cards from a merge get out of the way again; the strip reopens them.
        if (opts.isNew) {
            cardHideTimer = window.setTimeout(function hideUnlessHovered() {
                if (card.matches(':hover') || card.contains(document.activeElement)) {
                    cardHideTimer = window.setTimeout(hideUnlessHovered, 1500);
                } else hideCard();
            }, tier === TOP_TIER ? 9000 : 6000);
        }
    }

    function hideCard() {
        clearTimeout(cardHideTimer);
        if (cardTier === null) return;
        cardTier = null;
        card.classList.remove('is-open');
        lightTier(null);
        window.setTimeout(() => { if (cardTier === null) card.hidden = true; }, 200);
    }

    // ─── Fruit painters ───
    // All of them draw a round fruit of radius r at (x, y); stems and crowns
    // may poke out to about 1.3 r above.
    function ball(x: number, y: number, r: number, stops: [number, string][], hx = -0.3, hy = -0.3) {
        const grad = ctx.createRadialGradient(x + r * hx, y + r * hy, r * 0.08, x, y, r);
        for (const [o, c] of stops) grad.addColorStop(o, c);
        ctx.beginPath();
        ctx.arc(x, y, r, 0, Math.PI * 2);
        ctx.fillStyle = grad;
        ctx.fill();
    }

    function clipBall(x: number, y: number, r: number, paint: () => void) {
        ctx.save();
        ctx.beginPath();
        ctx.arc(x, y, r, 0, Math.PI * 2);
        ctx.clip();
        paint();
        ctx.restore();
    }

    function shine(x: number, y: number, r: number, a = 0.25) {
        ctx.beginPath();
        ctx.ellipse(x - r * 0.32, y - r * 0.34, r * 0.16, r * 0.24, -0.5, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(255,255,255,${a})`;
        ctx.fill();
    }

    function stem(x: number, y: number, r: number, color: string, len: number, bend = 0.12) {
        ctx.strokeStyle = color;
        ctx.lineWidth = Math.max(1.5, r * 0.07);
        ctx.lineCap = 'round';
        ctx.beginPath();
        ctx.moveTo(x, y - r * 0.82);
        ctx.quadraticCurveTo(x + r * bend, y - r * (0.82 + len * 0.6), x + r * bend * 1.6, y - r * (0.82 + len));
        ctx.stroke();
    }

    function leaf(x: number, y: number, len: number, wid: number, angle: number, color = '#3fa64a') {
        ctx.save();
        ctx.translate(x, y);
        ctx.rotate(angle);
        ctx.beginPath();
        ctx.moveTo(0, 0);
        ctx.quadraticCurveTo(len * 0.5, -wid, len, 0);
        ctx.quadraticCurveTo(len * 0.5, wid, 0, 0);
        ctx.fillStyle = color;
        ctx.fill();
        ctx.restore();
    }

    function drawCherry(x: number, y: number, r: number) {
        ball(x, y, r, [[0, '#ff5a6e'], [0.5, '#c0102c'], [1, '#5c0010']]);
        stem(x, y, r, '#4d7a22', 0.55, 0.25);
        leaf(x + r * 0.28, y - r * 1.25, r * 0.5, r * 0.18, -0.4);
        ctx.beginPath();
        ctx.arc(x - r * 0.3, y - r * 0.3, r * 0.17, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(255,255,255,0.4)';
        ctx.fill();
    }

    function drawStrawberry(x: number, y: number, r: number) {
        ball(x, y, r, [[0, '#ff8a96'], [0.5, '#f0233f'], [1, '#a50f2a']], -0.2, -0.1);
        clipBall(x, y, r, () => {
            ctx.fillStyle = '#ffe27a';
            const seeds = [[-0.35, -0.2], [0.3, -0.25], [-0.55, 0.15], [0.5, 0.18], [-0.15, 0.2],
                [0.12, -0.02], [-0.3, 0.5], [0.3, 0.5], [0, 0.7], [-0.05, -0.38], [0.6, -0.15], [-0.6, -0.12]];
            for (const [sx, sy] of seeds) {
                ctx.beginPath();
                ctx.ellipse(x + r * sx, y + r * sy, r * 0.045, r * 0.065, 0, 0, Math.PI * 2);
                ctx.fill();
            }
        });
        for (let i = 0; i < 5; i++) {
            const a = -Math.PI / 2 + (i - 2) * 0.55;
            leaf(x, y - r * 0.78, r * 0.48, r * 0.14, a + Math.PI / 2 - Math.PI / 2, i % 2 ? '#2f9a3c' : '#45b84f');
        }
        shine(x, y, r, 0.2);
    }

    function drawGrape(x: number, y: number, r: number) {
        ball(x, y, r, [[0, '#d7a2ff'], [0.4, '#8a3fd0'], [1, '#3b0f63']]);
        clipBall(x, y, r, () => {
            ctx.fillStyle = 'rgba(220, 200, 255, 0.12)';
            ctx.beginPath();
            ctx.arc(x + r * 0.25, y + r * 0.25, r * 0.7, 0, Math.PI * 2);
            ctx.fill();
        });
        stem(x, y, r, '#6b4a22', 0.3, 0.05);
        shine(x, y, r, 0.3);
        ctx.beginPath();
        ctx.arc(x - r * 0.12, y - r * 0.55, r * 0.07, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(255,255,255,0.25)';
        ctx.fill();
    }

    function drawLemon(x: number, y: number, r: number) {
        ball(x, y, r, [[0, '#fffbb0'], [0.45, '#f6dc2a'], [1, '#b99a05']]);
        clipBall(x, y, r, () => {
            // Pores and a small tip on each side.
            ctx.fillStyle = 'rgba(160, 130, 0, 0.18)';
            for (let i = 0; i < 26; i++) {
                const a = i * 2.39996, d = r * Math.sqrt((i + 0.5) / 26) * 0.9;
                ctx.beginPath();
                ctx.arc(x + Math.cos(a) * d, y + Math.sin(a) * d, r * 0.035, 0, Math.PI * 2);
                ctx.fill();
            }
        });
        ctx.fillStyle = '#e4c514';
        ctx.beginPath();
        ctx.ellipse(x + r * 0.97, y + r * 0.05, r * 0.12, r * 0.1, 0, 0, Math.PI * 2);
        ctx.fill();
        ctx.beginPath();
        ctx.ellipse(x - r * 0.97, y - r * 0.05, r * 0.1, r * 0.09, 0, 0, Math.PI * 2);
        ctx.fill();
        leaf(x + r * 0.05, y - r * 0.9, r * 0.5, r * 0.16, -0.7);
        shine(x, y, r, 0.35);
    }

    function drawOrange(x: number, y: number, r: number) {
        ball(x, y, r, [[0, '#ffcf5a'], [0.4, '#ff9500'], [1, '#c45a00']]);
        clipBall(x, y, r, () => {
            ctx.fillStyle = 'rgba(255, 238, 200, 0.16)';
            for (let i = 0; i < 40; i++) {
                const a = i * 2.39996, d = r * Math.sqrt((i + 0.5) / 40) * 0.95;
                ctx.beginPath();
                ctx.arc(x + Math.cos(a) * d, y + Math.sin(a) * d, r * 0.03, 0, Math.PI * 2);
                ctx.fill();
            }
        });
        ctx.beginPath();
        ctx.arc(x, y - r * 0.82, r * 0.07, 0, Math.PI * 2);
        ctx.fillStyle = '#5a7a1a';
        ctx.fill();
        leaf(x + r * 0.04, y - r * 0.85, r * 0.42, r * 0.15, -0.5);
        shine(x, y, r, 0.22);
    }

    function drawApple(x: number, y: number, r: number) {
        ball(x, y, r, [[0, '#ff8a7a'], [0.35, '#e8262c'], [0.8, '#a3121b'], [1, '#6e0a10']], -0.3, -0.15);
        clipBall(x, y, r, () => {
            // Yellow blush on one cheek, and the dip where the stem sits.
            const g = ctx.createRadialGradient(x + r * 0.55, y + r * 0.35, 0, x + r * 0.55, y + r * 0.35, r * 0.6);
            g.addColorStop(0, 'rgba(255, 210, 80, 0.45)');
            g.addColorStop(1, 'rgba(255, 210, 80, 0)');
            ctx.fillStyle = g;
            ctx.fillRect(x - r, y - r, r * 2, r * 2);
            ctx.beginPath();
            ctx.ellipse(x, y - r * 0.82, r * 0.34, r * 0.18, 0, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(60, 0, 0, 0.3)';
            ctx.fill();
        });
        stem(x, y, r, '#5a3a1a', 0.32, 0.08);
        leaf(x + r * 0.08, y - r * 0.95, r * 0.42, r * 0.15, -0.35, '#3caa3c');
        shine(x, y, r, 0.28);
    }

    function drawPear(x: number, y: number, r: number) {
        // A pear in a round footprint: a body plus a narrower top lobe.
        const body = () => {
            ctx.beginPath();
            ctx.arc(x, y + r * 0.12, r * 0.88, 0, Math.PI * 2);
            ctx.moveTo(x + r * 0.55, y - r * 0.45);
            ctx.arc(x, y - r * 0.45, r * 0.55, 0, Math.PI * 2);
        };
        const g = ctx.createRadialGradient(x - r * 0.3, y - r * 0.2, r * 0.08, x, y + r * 0.1, r);
        g.addColorStop(0, '#f6ff9e');
        g.addColorStop(0.45, '#c4d63a');
        g.addColorStop(1, '#6f8a12');
        body();
        ctx.fillStyle = g;
        ctx.fill();
        ctx.save();
        body();
        ctx.clip();
        ctx.fillStyle = 'rgba(110, 80, 10, 0.25)';
        for (let i = 0; i < 30; i++) {
            const a = i * 2.39996, d = r * Math.sqrt((i + 0.5) / 30) * 0.85;
            ctx.beginPath();
            ctx.arc(x + Math.cos(a) * d, y + r * 0.1 + Math.sin(a) * d, r * 0.022, 0, Math.PI * 2);
            ctx.fill();
        }
        const blush = ctx.createRadialGradient(x + r * 0.5, y + r * 0.3, 0, x + r * 0.5, y + r * 0.3, r * 0.55);
        blush.addColorStop(0, 'rgba(230, 120, 40, 0.35)');
        blush.addColorStop(1, 'rgba(230, 120, 40, 0)');
        ctx.fillStyle = blush;
        ctx.fillRect(x - r, y - r, r * 2, r * 2);
        ctx.restore();
        ctx.strokeStyle = '#5a3a1a';
        ctx.lineWidth = Math.max(1.5, r * 0.06);
        ctx.lineCap = 'round';
        ctx.beginPath();
        ctx.moveTo(x, y - r * 0.98);
        ctx.quadraticCurveTo(x + r * 0.05, y - r * 1.2, x + r * 0.18, y - r * 1.28);
        ctx.stroke();
        leaf(x + r * 0.06, y - r * 1.08, r * 0.4, r * 0.13, -0.25);
        ctx.beginPath();
        ctx.ellipse(x - r * 0.38, y + r * 0.0, r * 0.13, r * 0.26, -0.3, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(255,255,255,0.25)';
        ctx.fill();
    }

    function drawPeach(x: number, y: number, r: number) {
        ball(x, y, r, [[0, '#ffe0c0'], [0.45, '#ff9a76'], [1, '#c4504a']]);
        clipBall(x, y, r, () => {
            const g = ctx.createRadialGradient(x + r * 0.4, y + r * 0.3, 0, x + r * 0.4, y + r * 0.3, r * 0.8);
            g.addColorStop(0, 'rgba(220, 40, 60, 0.35)');
            g.addColorStop(1, 'rgba(220, 40, 60, 0)');
            ctx.fillStyle = g;
            ctx.fillRect(x - r, y - r, r * 2, r * 2);
            ctx.strokeStyle = 'rgba(150, 50, 40, 0.3)';
            ctx.lineWidth = Math.max(1.5, r * 0.05);
            ctx.beginPath();
            ctx.moveTo(x + r * 0.05, y - r * 0.95);
            ctx.quadraticCurveTo(x + r * 0.42, y, x + r * 0.05, y + r * 0.98);
            ctx.stroke();
        });
        leaf(x + r * 0.05, y - r * 0.88, r * 0.5, r * 0.17, -0.45);
        shine(x, y, r, 0.22);
    }

    function drawPineapple(x: number, y: number, r: number) {
        ball(x, y, r, [[0, '#ffe066'], [0.5, '#e0a820'], [1, '#9a6a0c']], -0.15, -0.1);
        clipBall(x, y, r, () => {
            ctx.strokeStyle = 'rgba(130, 75, 5, 0.35)';
            ctx.lineWidth = Math.max(1, r * 0.025);
            for (let i = -6; i <= 6; i++) {
                ctx.beginPath();
                ctx.moveTo(x + i * r * 0.28 - r, y - r);
                ctx.lineTo(x + i * r * 0.28 + r, y + r * 1.2);
                ctx.moveTo(x + i * r * 0.28 + r, y - r);
                ctx.lineTo(x + i * r * 0.28 - r, y + r * 1.2);
                ctx.stroke();
            }
        });
        for (let i = 0; i < 7; i++) {
            const a = -Math.PI / 2 + (i - 3) * 0.28;
            const len = r * (0.42 + (i % 2) * 0.12 - Math.abs(i - 3) * 0.04);
            leaf(x + (i - 3) * r * 0.05, y - r * 0.82, len, r * 0.09, a, i % 2 ? '#2f8f36' : '#44b04c');
        }
        shine(x, y, r, 0.16);
    }

    function drawMelon(x: number, y: number, r: number) {
        // Cantaloupe-style: pale green-gold with a white net.
        ball(x, y, r, [[0, '#f2f7c8'], [0.5, '#b9d47a'], [1, '#6c8a3a']]);
        clipBall(x, y, r, () => {
            ctx.strokeStyle = 'rgba(250, 250, 225, 0.55)';
            ctx.lineWidth = Math.max(1, r * 0.022);
            for (let i = 0; i < 9; i++) {
                const a = (i / 9) * Math.PI;
                ctx.beginPath();
                ctx.ellipse(x, y, r * Math.abs(Math.cos(a)) + 0.5, r, 0, 0, Math.PI * 2);
                ctx.stroke();
            }
            for (let i = 1; i < 6; i++) {
                const yy = y - r + (i / 6) * r * 2;
                ctx.beginPath();
                ctx.moveTo(x - r, yy + Math.sin(i) * r * 0.06);
                ctx.quadraticCurveTo(x, yy - r * 0.12, x + r, yy + Math.cos(i) * r * 0.06);
                ctx.stroke();
            }
        });
        ctx.beginPath();
        ctx.arc(x, y - r * 0.9, r * 0.06, 0, Math.PI * 2);
        ctx.fillStyle = '#6b5a1a';
        ctx.fill();
        stem(x, y, r, '#6b5a1a', 0.18, 0.06);
        shine(x, y, r, 0.22);
    }

    function drawWatermelon(x: number, y: number, r: number) {
        ball(x, y, r, [[0, '#4fae5f'], [0.5, '#2a7a38'], [1, '#164a20']], -0.2, -0.2);
        clipBall(x, y, r, () => {
            ctx.strokeStyle = '#123f1a';
            ctx.lineWidth = r * 0.1;
            for (let i = -3; i <= 3; i++) {
                ctx.beginPath();
                const xx = x + i * r * 0.32;
                ctx.moveTo(xx, y - r);
                for (let s = 0; s <= 8; s++) {
                    const yy = y - r + (s / 8) * r * 2;
                    ctx.lineTo(xx + Math.sin(s * 1.4 + i) * r * 0.05 + i * Math.cos((yy - y) / r) * r * 0.06, yy);
                }
                ctx.stroke();
            }
        });
        ctx.beginPath();
        ctx.arc(x, y - r * 0.9, r * 0.06, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(90,60,20,0.6)';
        ctx.fill();
        shine(x, y, r, 0.16);
    }

    const DRAWERS = [drawCherry, drawStrawberry, drawGrape, drawLemon, drawOrange, drawApple,
        drawPear, drawPeach, drawPineapple, drawMelon, drawWatermelon];

    // ─── Sprite cache ───
    // Every fruit casts a blurred glow, and blur is by far the most expensive
    // thing a 2D canvas does. So each fruit, label, the bowl and the glows are
    // painted once into an offscreen canvas and stamped with drawImage every
    // frame. Only shapes drawn with a varying globalAlpha keep the solid part
    // live and stamp the glow alone (alpha must hit glow and fill separately).
    interface Sprite { c: HTMLCanvasElement; x: number; y: number; w: number; h: number }
    const fruitSprites = new Map<string, Sprite>();
    const glowSprites = new Map<string, Sprite>();
    const labelSprites = new Map<string, Sprite>();
    const SHADOW_SHIFT = 4096;

    function clearSprites() {
        fruitSprites.clear();
        glowSprites.clear();
        labelSprites.clear();
    }
    const fontsChanged = () => { labelSprites.clear(); wake(); };
    document.fonts?.ready.then(fontsChanged);
    document.fonts?.addEventListener?.('loadingdone', fontsChanged);

    function makeSprite(x: number, y: number, w: number, h: number, paint: () => void): Sprite {
        const dx = Math.floor(x * dpr), dy = Math.floor(y * dpr);
        const c = document.createElement('canvas');
        c.width = Math.max(1, Math.ceil((x + w) * dpr) - dx);
        c.height = Math.max(1, Math.ceil((y + h) * dpr) - dy);
        const g = c.getContext('2d')!;
        g.setTransform(dpr, 0, 0, dpr, -dx, -dy);
        const prev = ctx;
        ctx = g;
        try { paint(); } finally { ctx = prev; }
        return { c, x: dx / dpr, y: dy / dpr, w: c.width / dpr, h: c.height / dpr };
    }

    function stamp(s: Sprite, x: number, y: number, sc = 1) {
        mainCtx.drawImage(s.c, x + s.x * sc, y + s.y * sc, s.w * sc, s.h * sc);
    }

    const blurReach = (blur: number) => (blur * 1.5) / dpr + 2;

    function fruitSprite(tier: number, r: number, blur: number): Sprite {
        const key = `${tier}|${r}|${blur}`;
        let s = fruitSprites.get(key);
        if (!s) {
            const m = blurReach(blur);
            const side = r + m, top = r * 1.4 + m;
            s = makeSprite(-side, -top, side * 2, top + side, () => {
                ctx.shadowColor = COLORS[tier];
                ctx.shadowBlur = blur;
                DRAWERS[tier](0, 0, r);
            });
            fruitSprites.set(key, s);
        }
        return s;
    }

    function glowSprite(color: string, blur: number, radius: number, lineWidth: number): Sprite {
        const key = `${color}|${blur}|${radius}|${lineWidth}`;
        let s = glowSprites.get(key);
        if (!s) {
            const e = radius + lineWidth + blurReach(blur);
            s = makeSprite(-e, -e, e * 2, e * 2, () => {
                ctx.shadowColor = color;
                ctx.shadowBlur = blur;
                ctx.shadowOffsetX = SHADOW_SHIFT * dpr;
                ctx.beginPath();
                ctx.arc(-SHADOW_SHIFT, 0, radius, 0, Math.PI * 2);
                if (lineWidth) { ctx.strokeStyle = color; ctx.lineWidth = lineWidth; ctx.stroke(); }
                else { ctx.fillStyle = color; ctx.fill(); }
            });
            glowSprites.set(key, s);
        }
        return s;
    }

    function dotSprite(color: string): Sprite {
        const key = `dot|${color}`;
        let s = glowSprites.get(key);
        if (!s) {
            const e = 4 + blurReach(8);
            s = makeSprite(-e, -e, e * 2, e * 2, () => {
                ctx.shadowColor = color;
                ctx.shadowBlur = 8;
                ctx.fillStyle = color;
                ctx.beginPath();
                ctx.arc(0, 0, 4, 0, Math.PI * 2);
                ctx.fill();
            });
            glowSprites.set(key, s);
        }
        return s;
    }

    function drawBowl() {
        const { x, y, w, h, cornerRadius: cr, taperInset: ti } = bowl;
        ctx.save();
        ctx.shadowColor = BOWL_GLOW;
        ctx.shadowBlur = 20;
        ctx.strokeStyle = BOWL_STROKE;
        ctx.lineWidth = 3;
        ctx.lineCap = 'round';
        ctx.lineJoin = 'round';
        ctx.beginPath();
        ctx.moveTo(x, y);
        ctx.lineTo(x + ti, y + h - cr);
        ctx.quadraticCurveTo(x + ti, y + h, x + ti + cr, y + h);
        ctx.lineTo(x + w - ti - cr, y + h);
        ctx.quadraticCurveTo(x + w - ti, y + h, x + w - ti, y + h - cr);
        ctx.lineTo(x + w, y);
        ctx.stroke();
        ctx.restore();
        // The danger line: fruit resting above it ends the game.
        ctx.save();
        ctx.strokeStyle = 'rgba(255, 255, 255, 0.13)';
        ctx.lineWidth = 1;
        ctx.setLineDash([5, 6]);
        ctx.beginPath();
        ctx.moveTo(x + 6, bowl.dangerY);
        ctx.lineTo(x + w - 6, bowl.dangerY);
        ctx.stroke();
        ctx.restore();
    }

    // A merge or a lit rung flashes the fruit: its sprite plus a fading ring
    // of glow in its colour. Both are cached per tier and size.
    const FLASH_BLUR = 26;

    function drawFruitBody(f: Fruit) {
        const sc = f.scaleAnim;
        stamp(fruitSprite(f.tier, f.r, 12), f.x, f.y, sc);
        if (f.flash <= 0) return;
        mainCtx.globalAlpha = f.flash;
        stamp(glowSprite(COLORS[f.tier], FLASH_BLUR, f.r, 4), f.x, f.y, sc);
        mainCtx.globalAlpha = 1;
    }

    /**
     * Build every tier's sprites while the browser is idle, so the first
     * merge into a big fruit doesn't pay for a large blur mid-game.
     */
    let warmGen = 0;
    function prewarm() {
        const gen = ++warmGen;
        const idle = (cb: () => void) =>
            'requestIdleCallback' in window ? window.requestIdleCallback(cb, { timeout: 1500 }) : window.setTimeout(cb, 60);
        let tier = 0;
        const next = () => {
            if (gen !== warmGen || tier >= TIER_COUNT) return;
            const r = radiusForTier(tier, bowl.w);
            fruitSprite(tier, r, 12);
            glowSprite(COLORS[tier], FLASH_BLUR, r, 4);
            labelSprite(tier, r);
            dotSprite(COLORS[tier]);
            if (tier === TOP_TIER) dotSprite(GOLD);
            tier++;
            idle(next);
        };
        idle(next);
    }

    /** The skill name inside a fruit, painted once per tier and size. Centred on (0, 0). */
    function labelSprite(tier: number, r: number): Sprite {
        const key = `${tier}|${r}|${compact ? 1 : 0}`;
        let s = labelSprites.get(key);
        if (s) return s;
        const rung = data.ladder[tier];
        const text = compact ? rung.short : rung.label;
        const maxW = r * 1.62;
        let size = Math.max(9, Math.min(compact ? 15 : 19, r * 0.4));
        const font = (px: number) => `700 ${px}px Inter, system-ui, sans-serif`;
        let lines = [text];
        mainCtx.save();
        mainCtx.font = font(size);
        if (mainCtx.measureText(text).width > maxW && text.includes(' ')) {
            const i = text.lastIndexOf(' ', Math.ceil(text.length / 2) + 2);
            const cut = i > 0 ? i : text.indexOf(' ');
            lines = [text.slice(0, cut).trim(), text.slice(cut).trim()];
        }
        const widest = () => Math.max(...lines.map((l) => mainCtx.measureText(l).width));
        while (size > 7 && widest() > maxW) { size -= 0.5; mainCtx.font = font(size); }
        mainCtx.restore();
        const lineH = size * 1.12;
        const boxW = r * 2.4, boxH = lines.length * lineH + 8;
        s = makeSprite(-boxW / 2, -boxH / 2, boxW, boxH, () => {
            ctx.font = font(size);
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.lineJoin = 'round';
            ctx.lineWidth = Math.max(2.5, size * 0.28);
            ctx.strokeStyle = 'rgba(10, 8, 16, 0.72)';
            ctx.fillStyle = '#ffffff';
            const y0 = -((lines.length - 1) * lineH) / 2;
            lines.forEach((l, i) => ctx.strokeText(l, 0, y0 + i * lineH));
            lines.forEach((l, i) => ctx.fillText(l, 0, y0 + i * lineH));
        });
        labelSprites.set(key, s);
        return s;
    }

    function drawLabel(f: Fruit) {
        const s = labelSprite(f.tier, f.r);
        stamp(s, Math.round(f.x * dpr) / dpr, Math.round(f.y * dpr) / dpr);
    }

    function drawParticles() {
        for (const p of particles) {
            const alpha = Math.max(0, p.life);
            const radius = Math.max(0.1, p.size * p.life);
            mainCtx.globalAlpha = alpha;
            // One sprite per colour (dot and glow), scaled to the shrinking dot.
            stamp(dotSprite(p.color), p.x, p.y, radius / 4);
        }
        mainCtx.globalAlpha = 1;
    }

    function drawDropper(now: number) {
        if (gameOver) return;
        const r = radiusForTier(current, bowl.w);
        const x = aimX(dropX);
        const ready = now >= readyAt;
        // Aim guide down to the pile.
        mainCtx.strokeStyle = 'rgba(255, 255, 255, 0.12)';
        mainCtx.lineWidth = 1;
        mainCtx.beginPath();
        mainCtx.moveTo(x, bowl.dropY + (ready ? r + 4 : 0));
        mainCtx.lineTo(x, bowl.bottom);
        mainCtx.stroke();
        if (!ready) return;
        const y = Math.max(r + 2, bowl.dropY);
        stamp(fruitSprite(current, r, 12), x, y);
        drawLabel({ tier: current, r, x, y } as Fruit);
    }

    function draw(now = performance.now()) {
        mainCtx.clearRect(0, 0, W, H);
        if (overSince !== null && !gameOver) {
            // The danger line warms up while the bowl is over it.
            const a = 0.35 + 0.35 * Math.sin(now / 90);
            mainCtx.strokeStyle = `rgba(255, 90, 90, ${a})`;
            mainCtx.lineWidth = 2;
            mainCtx.beginPath();
            mainCtx.moveTo(bowl.x + 6, bowl.dangerY);
            mainCtx.lineTo(bowl.x + bowl.w - 6, bowl.dangerY);
            mainCtx.stroke();
        }
        drawDropper(now);
        for (const f of fruits) drawFruitBody(f);
        for (const f of fruits) drawLabel(f);
        drawParticles();
    }

    function paintIcon(c: HTMLCanvasElement, tier: number, cssSize: number) {
        const px = Math.round(cssSize * dpr);
        if (c.width !== px) { c.width = px; c.height = px; }
        c.style.width = c.style.height = `${cssSize}px`;
        const g = c.getContext('2d')!;
        g.setTransform(dpr, 0, 0, dpr, 0, 0);
        g.clearRect(0, 0, cssSize, cssSize);
        const prev = ctx;
        ctx = g;
        try { DRAWERS[tier](cssSize / 2, cssSize * 0.56, cssSize * 0.4); } finally { ctx = prev; }
    }

    function paintNext() {
        paintIcon(nextCanvas, upcoming, compact ? 22 : 28);
    }

    /** Strip icons grow with the tier, like Suika's circle of evolution. */
    function paintIcons() {
        rungEls.forEach((el, i) => {
            const c = el.querySelector<HTMLCanvasElement>('canvas');
            if (c) paintIcon(c, i, compact ? 14 + i * 1.1 : 18 + i * 1.8);
        });
        paintNext();
    }

    // ─── Loop ───
    function wake() {
        lastActive = performance.now();
        if (visible && started && animId === null) {
            prevT = performance.now();
            animId = requestAnimationFrame(tick);
        }
    }

    let prevT = 0;
    function tick(now: number) {
        animId = null;
        let dt = Math.min((now - prevT) / 1000, DT_CAP);
        prevT = now;
        // Two half steps when frames are slow, so fast fruit don't tunnel.
        if (dt > 0.017) { step(dt / 2, now); step(dt / 2, now); } else step(dt, now);

        if (!gameOver) {
            const d = dangerStep(overSince, fruits, bowl.dangerY, now);
            overSince = d.overSince;
            if (d.gameOver) endGame();
        }

        let moving = particles.length > 0 || shake > 0 || overSince !== null || now < readyAt;
        if (!moving) {
            for (const f of fruits) {
                if (Math.abs(f.vx) + Math.abs(f.vy) > 12 * k || f.flash > 0 || f.scaleAnim > 1) { moving = true; break; }
            }
        }
        if (moving) lastActive = now;

        if (shake > 0) {
            shake = Math.max(0, shake - dt * 2.5);
            const m = shake * 6 * k;
            const tf = shake > 0 ? `translate(${((Math.random() - 0.5) * m).toFixed(1)}px, ${((Math.random() - 0.5) * m).toFixed(1)}px)` : '';
            canvas.style.transform = bowlCanvas.style.transform = tf;
        }
        draw(now);
        // Park the loop once everything has come to rest; input wakes it.
        if (visible && now - lastActive < SLEEP_AFTER) animId = requestAnimationFrame(tick);
    }

    function seed(now: number) {
        fruits.length = 0;
        particles.length = 0;
        settling = true;
        for (const s of SEED_PILE) {
            const f = addFruit(s.tier, 0, 0, now - 10_000);
            f.x = bowl.x + f.r + 4 + (bowl.w - f.r * 2 - 8) * s.x;
            f.y = bowl.y + f.r;
            for (let i = 0; i < 60; i++) step(1 / 60, now);
            reach(s.tier, false);
        }
        for (let i = 0; i < 240; i++) step(1 / 60, now);
        // A twin that still landed touching its pair would merge on the first
        // frame; take it out so the opening bowl is exactly what was planned.
        for (let i = fruits.length - 1; i >= 0; i--) {
            const a = fruits[i];
            const touching = fruits.some((b, j) => j < i && b.tier === a.tier && Math.hypot(a.x - b.x, a.y - b.y) < a.r + b.r + 2);
            if (touching) fruits.splice(i, 1);
        }
        for (const f of fruits) { f.vx = 0; f.vy = 0; f.flash = 0; f.scaleAnim = 1; }
        settling = false;
    }

    function newGame() {
        nextDrop = createDropSequence();
        current = nextDrop(5);
        upcoming = nextDrop(5);
        score = 0;
        scoreEl.textContent = '0';
        overSince = null;
        gameOver = false;
        readyAt = 0;
        overEl.hidden = true;
        seed(performance.now());
        paintNext();
        wake();
    }

    function endGame() {
        gameOver = true;
        overSince = null;
        hideCard();
        overEl.querySelector('.skills-over-score')!.textContent = fill(S.overScore, { n: score });
        overEl.hidden = false;
        liveEl.textContent = `${overEl.querySelector('.skills-over-title')!.textContent} ${fill(S.overScore, { n: score })}`;
        if (document.activeElement === canvas) overEl.querySelector<HTMLButtonElement>('button')?.focus();
    }

    // ─── Input ───
    // The canvas rect is read when a gesture starts, never per frame.
    let rect = canvas.getBoundingClientRect();
    const refreshRect = () => { rect = canvas.getBoundingClientRect(); };
    const local = (e: { clientX: number; clientY: number }) => ({ x: e.clientX - rect.left, y: e.clientY - rect.top });
    const inColumn = (x: number, y: number) =>
        x >= bowl.x - 12 && x <= bowl.x + bowl.w + 12 && y <= bowl.y + bowl.h + 6;
    let lastTouch = 0;

    canvas.addEventListener('mouseenter', refreshRect);
    canvas.addEventListener('mousemove', (e) => {
        if (performance.now() - lastTouch < 800) return;
        const p = local(e);
        const on = inColumn(p.x, p.y);
        canvas.classList.toggle('aim', on && !gameOver);
        if (on) setAim(p.x);
    });
    canvas.addEventListener('mousedown', (e) => {
        if (e.button !== 0) return;
        refreshRect();
        const p = local(e);
        // Presses in the bowl belong to the game, not to the slider's mouse drag.
        if (inColumn(p.x, p.y)) { e.stopPropagation(); e.preventDefault(); canvas.focus({ preventScroll: true }); }
    });
    canvas.addEventListener('click', (e) => {
        if (performance.now() - lastTouch < 800) return;
        const p = local(e);
        if (!inColumn(p.x, p.y)) return;
        setAim(p.x);
        drop();
    });

    // Touch: anything that starts in the bowl is aiming, so a vertical swipe
    // there never changes slide by accident. Swipes on the copy, the ladder
    // or the page margins still do.
    let touching = false;
    canvas.addEventListener('touchstart', (e) => {
        if (e.touches.length !== 1) { touching = false; return; }
        refreshRect();
        const p = local(e.touches[0]);
        if (!inColumn(p.x, p.y) || gameOver) { touching = false; return; }
        touching = true;
        lastTouch = performance.now();
        e.stopPropagation();
        setAim(p.x);
    }, { passive: true });
    canvas.addEventListener('touchmove', (e) => {
        if (!touching) return;
        e.preventDefault();
        e.stopPropagation();
        setAim(local(e.touches[0]).x);
    }, { passive: false });
    canvas.addEventListener('touchend', (e) => {
        if (!touching) return;
        touching = false;
        lastTouch = performance.now();
        e.stopPropagation();
        if (e.cancelable) e.preventDefault();
        drop();
    });
    canvas.addEventListener('touchcancel', () => { touching = false; });

    canvas.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') {
            e.preventDefault();
            const stepFr = e.shiftKey ? 0.12 : 0.04;
            dropX = Math.max(0, Math.min(1, dropX + (e.key === 'ArrowLeft' ? -stepFr : stepFr)));
            // Snap to the reachable range so the next press moves at once.
            dropX = (aimX(dropX) - bowl.x) / bowl.w;
            wake();
        } else if (e.key === ' ' || e.key === 'Enter') {
            e.preventDefault();
            drop();
        }
    });

    card.querySelector('.skills-card-close')?.addEventListener('click', () => hideCard());
    overEl.querySelector('.skills-over-again')?.addEventListener('click', () => {
        newGame();
        canvas.focus({ preventScroll: true });
    });

    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && cardTier !== null) hideCard();
    });

    // Clicking elsewhere on the slide closes the card (dropping fruit doesn't).
    root.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (cardTier === null || target === canvas || card.contains(target) || target.closest('.skills-rung')) return;
        hideCard();
    });

    rungEls.forEach((el, i) => {
        el.addEventListener('click', () => {
            if (!reached.has(i)) return;
            if (cardTier === i) hideCard();
            else showCard(i, { anchorEl: el });
        });
    });

    // Project links: same route as the timeline. Set the hash, go to the
    // projects slide, and Projects.astro opens the matching case.
    root.addEventListener('click', (e) => {
        const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('[data-project]');
        if (!link) return;
        e.preventDefault();
        history.replaceState(null, '', `#${link.dataset.project}`);
        document.dispatchEvent(new CustomEvent('slider-goto', { detail: { index: 1 } }));
    });

    // Left column ↔ ladder: hovering a pillar lights its rung (and its fruit, if in the bowl).
    root.querySelectorAll<HTMLElement>('.skills-pillar').forEach((el) => {
        const tier = Number(el.dataset.tier);
        const on = () => { if (cardTier === null) lightTier(tier); };
        const off = () => { if (cardTier === null && lit === tier) lightTier(null); };
        el.addEventListener('mouseenter', on);
        el.addEventListener('mouseleave', off);
        el.addEventListener('focusin', on);
        el.addEventListener('focusout', off);
    });

    let resizeTimer = 0;
    window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(() => { if (started) { resize(); draw(); } }, 100);
    });

    // Testing hook (same pattern as window.__numbersGame).
    (window as unknown as { __skillsBowl: unknown }).__skillsBowl = {
        fruits: () => fruits.map((f) => ({ tier: f.tier, x: f.x, y: f.y, r: f.r })),
        bowl: () => ({ ...bowl }),
        state: () => ({ score, current, upcoming, gameOver, overSince, reached: [...reached].sort((a, b) => a - b), running: animId !== null }),
        /** Drop at a fraction of the bowl's width, optionally forcing the tier. Ignores the cooldown. */
        drop: (xFrac: number, tier?: number) => { dropX = xFrac; readyAt = 0; return drop(performance.now(), tier); },
        /** Put a fruit straight into the bowl (for scripted merge chains). */
        place: (tier: number, xFrac: number, yFrac = 0.5) => {
            const f = addFruit(tier, bowl.x + bowl.w * xFrac, bowl.y + bowl.h * yFrac, performance.now());
            wake();
            return f.r;
        },
        newGame,
    };

    // Run while the slide is shown, pause (keeping the game) while it isn't.
    function show() {
        visible = true;
        if (!started) {
            started = true;
            resize();
            newGame();
        }
        draw();
        wake();
    }
    function hide() {
        visible = false;
        if (animId !== null) { cancelAnimationFrame(animId); animId = null; }
        hideCard();
    }
    const reveal = root.querySelector('.reveal');
    if (reveal) {
        const mo = new MutationObserver(() => {
            if (reveal.classList.contains('visible')) { if (!visible) show(); }
            else if (visible) hide();
        });
        mo.observe(reveal, { attributes: true, attributeFilter: ['class'] });
        if (reveal.classList.contains('visible')) show();
    }
})();
</script>
